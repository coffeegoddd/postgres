{
  "version": 1,
  "id": "dolt-cherry-pick-rename-column",
  "description": "Reviewed Dolt port: schema change: ALTER TABLE RENAME COLUMN",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_cherry_pick.go",
    "case": "DoltCherryPickTests: schema change: ALTER TABLE RENAME COLUMN"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.cherrypick"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (pk int PRIMARY KEY, v1 varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit-create",
      "session": "a",
      "op": "commit",
      "args": [
        "create table test on main"
      ],
      "save": "created"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "checkout-branch1",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "change",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE test RENAME COLUMN v1 TO v2",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit-change",
      "session": "a",
      "op": "commit",
      "args": [
        "rename column v1 to v2 in test on branch1"
      ],
      "save": "commit1"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.cherrypick"
      ],
      "sql": "SELECT length(r[1]) = 40, r[2], r[3], r[4] FROM dolt_cherry_pick($1) r",
      "params": [
        {
          "ref": "commit1"
        }
      ],
      "expect": {
        "rows": [
          [
            "t",
            "0",
            "0",
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT column_name, data_type, character_maximum_length FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'test' ORDER BY ordinal_position",
      "expect": {
        "rows": [
          [
            "pk",
            "integer",
            null
          ],
          [
            "v2",
            "character varying",
            "100"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
