{
  "version": 1,
  "id": "dolt-stash-deleted-on-head",
  "description": "Reviewed Dolt port: popping stash with deleted table that is deleted already on current head",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_stash.go",
    "case": "DoltStashTests: popping stash with deleted table that is deleted already on current head"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.stash"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test(pk BIGINT PRIMARY KEY, v varchar(10))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "created",
      "session": "a",
      "op": "commit",
      "args": [
        "Created table",
        "-A"
      ],
      "save": "created"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-3-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE test",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "dropped",
      "session": "a",
      "op": "commit",
      "args": [
        "Dropped test",
        "-A"
      ],
      "save": "dropped"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT tablename::text FROM pg_tables WHERE schemaname = 'public' ORDER BY 1",
      "expect": {
        "rows": [
          [
            "test"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE test",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('pop', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT * FROM dolt_status",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    }
  ]
}
