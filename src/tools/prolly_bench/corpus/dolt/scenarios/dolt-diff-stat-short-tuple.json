{
  "version": 1,
  "id": "dolt-diff-stat-short-tuple",
  "description": "Reviewed Dolt port: add multiple columns, then set and unset a value. Should not show a diff",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffStatTableFunctionScriptTests: add multiple columns, then set and unset a value. Should not show a diff"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup",
      "session": "a",
      "op": "commit",
      "args": [
        "setup"
      ],
      "save": "setup"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col1 int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col2 int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "addcolumns",
      "session": "a",
      "op": "commit",
      "args": [
        "add columns"
      ],
      "save": "addcolumns"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col1 = 1 WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col1 = NULL WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "fix",
      "session": "a",
      "op": "commit",
      "args": [
        "fix short tuple",
        "--allow-empty"
      ],
      "save": "fix"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat('HEAD~2', 'HEAD')",
      "expect": {
        "rows": [
          [
            "public.t",
            "1",
            "0",
            "0",
            "0",
            "2",
            "0",
            "0",
            "1",
            "1",
            "1",
            "3"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat('HEAD~', 'HEAD')",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    }
  ]
}
