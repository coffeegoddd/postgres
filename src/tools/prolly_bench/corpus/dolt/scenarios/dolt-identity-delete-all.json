{
  "version": 1,
  "id": "dolt-identity-delete-all",
  "description": "Reviewed Dolt port: delete all rows in table",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltAutoIncrementTests: delete all rows in table"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (a int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, b int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "empty-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "empty table"
      ],
      "save": "empty-commit"
    },
    {
      "id": "insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (1), (2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "insert-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "two values on main"
      ],
      "save": "insert-commit"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t",
      "expect": {
        "tag": "DELETE 2"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN a RESTART WITH 1",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (7), (8) RETURNING a",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "7"
          ],
          [
            "2",
            "8"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
