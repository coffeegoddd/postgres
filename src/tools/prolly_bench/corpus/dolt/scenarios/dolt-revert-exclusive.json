{
  "version": 1,
  "id": "dolt-revert-exclusive",
  "description": "Reviewed Dolt port: dolt_revert() --continue and --abort are mutually exclusive",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_revert.go",
    "case": "RevertScripts: dolt_revert() --continue and --abort are mutually exclusive"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.conflicts",
    "vc.revert"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (pk int PRIMARY KEY, c0 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (1,1),(2,2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "seed-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "seed table"
      ],
      "save": "seed"
    },
    {
      "id": "first",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE test SET c0 = 42 WHERE pk = 2",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "first-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "first change"
      ],
      "save": "first"
    },
    {
      "id": "second",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE test SET c0 = 23 WHERE pk = 2",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "second-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "second change"
      ],
      "save": "second"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.revert"
      ],
      "sql": "SELECT r[1], r[2], r[3], r[4] FROM dolt_revert('HEAD~1') r",
      "expect": {
        "rows": [
          [
            "",
            "1",
            "0",
            "0"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.revert"
      ],
      "sql": "SELECT dolt_revert('--continue', '--abort')",
      "expect": {
        "sqlstate": "22023"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.revert"
      ],
      "sql": "SELECT dolt_revert('--abort', '--continue')",
      "expect": {
        "sqlstate": "22023"
      }
    }
  ]
}
