{
  "version": 1,
  "id": "dolt-schema-unique-violation",
  "description": "Reviewed Dolt port: unique constraint violation",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: unique constraint violation"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk varchar(100) PRIMARY KEY, col1 int, col2 varchar(100), CONSTRAINT unique1 UNIQUE (col2))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES ('0', 0, '')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (pk, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "ancestor commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_branch('right')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "right_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN col1",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (pk, col2) VALUES ('10', 'same')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "right commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "left_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES ('1', 10, 'same')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "left commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "main"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SELECT * FROM dolt_conflicts",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    },
    {
      "id": "assert-2-forward",
      "session": "a",
      "variants": [
        "forward"
      ],
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT * FROM dolt_constraint_violations()",
      "expect": {
        "rows": [
          [
            "public.t",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT * FROM dolt_constraint_violations()",
      "expect": {
        "rows": [
          [
            "public.t",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-3-forward",
      "session": "a",
      "variants": [
        "forward"
      ],
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violation_type, violating_row->>'pk', violating_row->>'col2', violation_info::text FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "unique index",
            "10",
            "same",
            "{\"Name\": \"unique1\", \"Columns\": [\"col2\"]}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-3-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violation_type, violating_row->>'pk', violating_row->>'col2', violation_info::text FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "unique index",
            "1",
            "same",
            "{\"Name\": \"unique1\", \"Columns\": [\"col2\"]}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-4-forward",
      "session": "a",
      "variants": [
        "forward"
      ],
      "op": "query",
      "sql": "SELECT pk, col2 FROM t",
      "expect": {
        "rows": [
          [
            "0",
            ""
          ],
          [
            "1",
            "same"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-4-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "sql": "SELECT pk, col2 FROM t",
      "expect": {
        "rows": [
          [
            "0",
            ""
          ],
          [
            "10",
            "same"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
