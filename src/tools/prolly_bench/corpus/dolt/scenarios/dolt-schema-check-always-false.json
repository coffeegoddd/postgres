    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: check constraint violation - check is always false"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 varchar(100) DEFAULT 'hello')",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD CHECK (1 = 2)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, DEFAULT)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    }
  ]
