{
  "version": 1,
  "id": "dolt-diff-table-recreated",
  "description": "Reviewed Dolt port: table drop and recreate with overlapping schema",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSystemTableScriptTests: table drop and recreate with overlapping schema"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 2), (3, 4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE t",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping table t"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100, 200), (300, 400)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "recreating table t"
      ],
      "save": "commit3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_diff_table(NULL::t)",
      "expect": {
        "rows": [
          [
            "6"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff_table(NULL::t) WHERE to_commit = $1 ORDER BY (to_row).pk",
      "expect": {
        "rows": [
          [
            "100",
            "200",
            null,
            null,
            "added"
          ],
          [
            "300",
            "400",
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        }
      ]
    }
  ]
}
