{
  "version": 1,
  "id": "dolt-schema-fk-added-violated",
  "description": "Reviewed Dolt port: adding a foreign key to one side, with fk constraint violation",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: adding a foreign key to one side, with fk constraint violation"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE parent (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE child (pk int PRIMARY KEY, p_fk int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO parent VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO child VALUES (1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-4",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "anc-5",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON child (p_fk, pk)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE child ADD CONSTRAINT fk_parent FOREIGN KEY (p_fk) REFERENCES parent (pk)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE child ADD COLUMN col1 int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO child VALUES (2, 2)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "left-1",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE child SET p_fk = 3 WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "left-2",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE child ADD COLUMN col2 varchar(100)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "left-3",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE child SET col2 = '1col2' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "left-4",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE child SET col2 = '2col2' WHERE pk = 2",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, p_fk, col1, col2 FROM child ORDER BY pk",
      "expect": {
        "rows": [
          [
            "1",
            "3",
            null,
            "1col2"
          ],
          [
            "2",
            "2",
            null,
            "2col2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'pk', violating_row->>'p_fk', violating_row->>'col1', violating_row->>'col2' FROM dolt_constraint_violations('child') ORDER BY 1",
      "expect": {
        "rows": [
          [
            "1",
            "3",
            null,
            "1col2"
          ],
          [
            "2",
            "2",
            null,
            "2col2"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
