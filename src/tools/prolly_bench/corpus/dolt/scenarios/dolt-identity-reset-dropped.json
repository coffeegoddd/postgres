{
  "version": 1,
  "id": "dolt-identity-reset-dropped",
  "description": "Reviewed Dolt port: hard reset dropped table restores auto increment",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltAutoIncrementTests: hard reset dropped table restores auto increment"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (a int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, b int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (1), (2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "init-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "initialize table"
      ],
      "save": "init-commit"
    },
    {
      "id": "drop",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE t",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "reset",
      "session": "a",
      "op": "reset",
      "args": [
        "HEAD"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (3) RETURNING a",
      "expect": {
        "rows": [
          [
            "3"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "2",
            "2"
          ],
          [
            "3",
            "3"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
