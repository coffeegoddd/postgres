{
  "version": 1,
  "id": "dolt-revert-dirty-target",
  "description": "Reviewed Dolt port: dolt_revert() refuses when revert target table is dirty",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_revert.go",
    "case": "RevertScripts: dolt_revert() refuses when revert target table is dirty"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.revert"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create-t",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c0 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "seed schema"
      ],
      "save": "seeded"
    },
    {
      "id": "row",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "row-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "add row to t"
      ],
      "save": "row"
    },
    {
      "id": "dirty",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (99, 99)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.revert"
      ],
      "sql": "SELECT dolt_revert('HEAD')",
      "expect": {
        "sqlstate": "55000"
      }
    }
  ]
}
