{
  "version": 1,
  "id": "dolt-temp-table-collisions",
  "description": "Reviewed Dolt port: temporary and non-temporary table name collisions",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltTempTableScripts: temporary and non-temporary table name collisions"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "on-branch",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "main"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "t1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t1 (id varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "t1-row",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES ('this is a non-temporary table')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "tmp-t1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TEMPORARY TABLE t1 (id varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "tmp-t1-row",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES ('this is a temporary table')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "tmp-t2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TEMPORARY TABLE t2 (id int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "t2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE public.t2 (id int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "tmp-t3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TEMPORARY TABLE t3 (id int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t1",
      "expect": {
        "rows": [
          [
            "this is a temporary table"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TEMPORARY TABLE t3 (id int)",
      "expect": {
        "sqlstate": "42P07"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT c.relpersistence FROM pg_class c WHERE c.oid = $1::regclass",
      "params": [
        "t1"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE t1",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "sql": "SELECT c.relpersistence FROM pg_class c WHERE c.oid = $1::regclass",
      "params": [
        "t1"
      ],
      "expect": {
        "rows": [
          [
            "p"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
