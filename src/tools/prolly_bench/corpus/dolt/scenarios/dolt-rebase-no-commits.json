{
  "version": 1,
  "id": "dolt-rebase-no-commits",
  "description": "Reviewed Dolt port: dolt_rebase: no commits to rebase",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_rebase.go",
    "case": "DoltRebaseScriptTests: dolt_rebase: no commits to rebase"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.rebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t",
        "-A"
      ],
      "save": "c1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (0)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 0",
        "-a"
      ],
      "save": "m0"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1",
        "-a"
      ],
      "save": "r1"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (10)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 10",
        "-a"
      ],
      "save": "r10"
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 100",
        "-a"
      ],
      "save": "r100"
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1000",
        "-a"
      ],
      "save": "r1000"
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (10000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-15",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 10000",
        "-a"
      ],
      "save": "r10000"
    },
    {
      "id": "setup-16",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-17",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 100000",
        "-a"
      ],
      "save": "r100000"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "branch1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('-i', 'HEAD')",
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "branch1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT * FROM dolt_branches WHERE name = 'dolt_rebase_branch1'",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    }
  ]
}
