{
  "version": 1,
  "id": "dolt-schema-modify-drop-column",
  "description": "Reviewed Dolt port: modifying a column on one side of a merge, and deleting it on the other",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsSchemaConflicts: modifying a column on one side of a merge, and deleting it on the other"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (i int PRIMARY KEY, j int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "ancestor commit"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "query",
      "sql": "SELECT dolt_branch('right')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      },
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "var": "right_side"
        }
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN j",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "right commit"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "var": "left_side"
        }
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN j TYPE varchar(24)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "left commit"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "main"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM (SELECT dolt_merge('right')) AS r(m)",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SELECT table_name FROM dolt_schema_conflicts",
      "expect": {
        "rows": [
          [
            "public.t"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
