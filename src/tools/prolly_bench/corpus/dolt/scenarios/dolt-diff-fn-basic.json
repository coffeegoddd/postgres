  "steps": [
    {
      "id": "initial",
      "session": "a",
      "op": "commit",
      "args": [
        "initial",
        "--allow-empty"
      ],
      "save": "initial"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t2 (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t2 VALUES (100, 'hundred', 'hundert')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t2"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 'two', 'three'), (3, 'three', 'four')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c1 = 'uno', c2 = 'dos' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t"
      ],
      "save": "commit4"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (to_row).c2, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff($1, $2, NULL::t)",
      "expect": {
        "rows": [
          [
            "1",
            "one",
            "two",
            null,
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_diff($1, $2, NULL::t)",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        },
        {
          "ref": "commit3"
        }
