{
  "version": 1,
  "id": "dolt-diff-summary-rename-column",
  "description": "Reviewed Dolt port: schema modification: rename columns",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSummaryTableFunctionScriptTests: schema modification: rename columns"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', -1), (2, 'two', -2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into t"
      ],
      "save": "commit2"
    },
    {
      "id": "rename-c3",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t RENAME COLUMN c2 TO c3",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "renaming column c2 to c3"
      ],
      "save": "commit3"
    },
    {
      "id": "insert-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'three', -3)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "update",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c3 = 1 WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting and updating data"
      ],
      "save": "commit4"
    },
    {
      "id": "rename-c2",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t RENAME COLUMN c3 TO c2",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "insert-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (4, 'four', -4)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit5",
      "session": "a",
      "op": "commit",
      "args": [
        "renaming column c3 to c2, and inserting data"
      ],
      "save": "commit5"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "f"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "f",
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        },
        {
          "ref": "commit3"
        }
      ]
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "f"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        },
        {
          "ref": "commit4"
        }
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit4"
        },
        {
          "ref": "commit5"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "f"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit5"
        }
      ]
    }
  ]
}
