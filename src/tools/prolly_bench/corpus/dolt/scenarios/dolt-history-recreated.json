{
  "version": 1,
  "id": "dolt-history-recreated",
  "description": "Reviewed Dolt port: primary key table: delete and recreate table",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "HistorySystemTableScriptTests: primary key table: delete and recreate table"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 int, c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 2, '3'), (4, 5, '6')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE t",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping table t"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "recreating table t"
      ],
      "save": "commit3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_history_table(NULL::t)",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
