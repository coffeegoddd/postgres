{
  "version": 1,
  "id": "dolt-stash-deleted-table",
  "description": "Reviewed Dolt port: stashing working set with deleted table and popping it",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_stash.go",
    "case": "DoltStashTests: stashing working set with deleted table and popping it"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.stash"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE new_tab(id INT PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "created",
      "session": "a",
      "op": "commit",
      "args": [
        "Created table",
        "-A"
      ],
      "save": "created"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "DROP TABLE new_tab",
      "expect": {
        "tag": "DROP TABLE"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT * FROM dolt_status",
      "expect": {
        "rows": [
          [
            "public.new_tab",
            "t",
            "deleted"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT tablename::text FROM pg_tables WHERE schemaname = 'public' ORDER BY 1",
      "expect": {
        "rows": [
          [
            "new_tab"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('pop', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "sql": "SELECT tablename::text FROM pg_tables WHERE schemaname = 'public' ORDER BY 1",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    }
  ]
}
