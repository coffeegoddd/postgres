{
  "version": 1,
  "id": "dolt-rebase-non-interactive",
  "description": "Reviewed Dolt port: dolt_rebase: non-interactive rebase successful",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_rebase.go",
    "case": "DoltRebaseScriptTests: dolt_rebase: non-interactive rebase successful"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.rebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t on main",
        "-A"
      ],
      "save": "c1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (42)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit with pk = 42",
        "-a"
      ],
      "save": "c2"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "branch",
      "args": [
        "feature",
        "HEAD~1"
      ]
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "checkout",
      "args": [
        "feature"
      ]
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "commit",
      "args": [
        "feature commit 1",
        "-a"
      ],
      "save": "f1"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "commit",
      "args": [
        "feature commit 2",
        "-a"
      ],
      "save": "f2"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('main')",
      "expect": {
        "rows": [
          [
            "{0,\"Successfully rebased and updated refs/heads/feature\"}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk FROM t WHERE pk = 42",
      "expect": {
        "rows": [
          [
            "42"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
