{
  "version": 1,
  "id": "dolt-cherry-pick-uncommitted",
  "description": "Reviewed Dolt port: error cases: error with staged or unstaged changes ",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_cherry_pick.go",
    "case": "DoltCherryPickTests: error cases: error with staged or unstaged changes "
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.cherrypick"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, v varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit-create",
      "session": "a",
      "op": "commit",
      "args": [
        "create table t"
      ],
      "save": "created"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "checkout-branch1",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "change",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit-change",
      "session": "a",
      "op": "commit",
      "args": [
        "adding row 1"
      ],
      "save": "commit1"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "dirty",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100, 'onehundy')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.cherrypick"
      ],
      "sql": "SELECT dolt_cherry_pick($1)",
      "params": [
        {
          "ref": "commit1"
        }
      ],
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('t')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.cherrypick"
      ],
      "sql": "SELECT dolt_cherry_pick($1)",
      "params": [
        {
          "ref": "commit1"
        }
      ],
      "expect": {
        "sqlstate": "55000"
      }
    }
  ]
}
