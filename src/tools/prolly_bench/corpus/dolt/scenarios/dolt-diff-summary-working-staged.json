{
  "version": 1,
  "id": "dolt-diff-summary-working-staged",
  "description": "Reviewed Dolt port: WORKING and STAGED",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSummaryTableFunctionScriptTests: WORKING and STAGED"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "initial",
      "session": "a",
      "op": "commit",
      "args": [
        "initial",
        "--allow-empty"
      ],
      "save": "commit0"
    },
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 text, c2 text)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two'), (2, 'three', 'four')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting two rows into table t"
      ],
      "save": "commit1"
    },
    {
      "id": "insert-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'five', 'six')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "delete",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t WHERE pk = 2",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "update",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c2 = '100' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary($1, 'WORKING', 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "f"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary('WORKING', 'WORKING', 't')",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary('STAGED', 'STAGED', 't')",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary('WORKING', 'STAGED', 't')",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_summary('HEAD', 'STAGED', 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "public.t",
            "modified",
            "t",
            "f"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
