{
  "version": 1,
  "id": "dolt-diff-fn-working-staged",
  "description": "Reviewed Dolt port: WORKING and STAGED",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffTableFunctionScriptTests: WORKING and STAGED"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "initial",
      "session": "a",
      "op": "commit",
      "args": [
        "initial",
        "--allow-empty"
      ],
      "save": "initial"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 text, c2 text)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two'), (2, 'three', 'four')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting two rows into table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'five', 'six')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t WHERE pk = 2",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c2 = '100' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff($1, 'WORKING', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [
          [
            "1",
            "one",
            "two",
            "1",
            "one",
            "100",
            "modified"
          ],
          [
            "2",
            "three",
            "four",
            null,
            null,
            null,
            "removed"
          ],
          [
            null,
            null,
            null,
            "3",
            "five",
            "six",
            "added"
          ]
        ],
        "order": "ordered"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff('WORKING', 'WORKING', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff('WORKING', 'WORKING', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff('STAGED', 'STAGED', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff('WORKING', 'STAGED', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (from_row).pk, (from_row).c1, (from_row).c2, (to_row).pk, (to_row).c1, (to_row).c2, diff_type FROM dolt_diff('HEAD', 'STAGED', NULL::t) ORDER BY coalesce((from_row).pk, (to_row).pk)",
      "expect": {
        "rows": [
          [
            "1",
            "one",
            "two",
            "1",
            "one",
            "100",
            "modified"
          ],
          [
            "2",
            "three",
            "four",
            null,
            null,
            null,
            "removed"
          ],
          [
            null,
            null,
            null,
            "3",
            "five",
            "six",
            "added"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
