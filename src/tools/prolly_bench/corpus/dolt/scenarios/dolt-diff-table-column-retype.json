{
  "version": 1,
  "id": "dolt-diff-table-column-retype",
  "description": "Reviewed Dolt port: column drop and recreate with different type that can be coerced (int -> string)",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSystemTableScriptTests: column drop and recreate with different type that can be coerced (int -> string)"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 2), (3, 4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN c",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping column c"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN c varchar(20)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100, '101')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "re-adding column c"
      ],
      "save": "commit3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_diff_table(NULL::t)",
      "expect": {
        "rows": [
          [
            "5"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff_table(NULL::t) WHERE to_commit = $1 ORDER BY (to_row).pk",
      "expect": {
        "rows": [
          [
            "1",
            "2",
            null,
            null,
            "added"
          ],
          [
            "3",
            "4",
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff_table(NULL::t) WHERE to_commit = $1 ORDER BY (to_row).pk",
      "expect": {
        "rows": [
          [
            "1",
            null,
            "1",
            "2",
            "modified"
          ],
          [
            "3",
            null,
            "3",
            "4",
            "modified"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff_table(NULL::t) WHERE to_commit = $1 ORDER BY (to_row).pk",
      "expect": {
        "rows": [
          [
            "100",
            "101",
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        }
      ]
    }
  ]
}
