{
  "version": 1,
  "id": "dolt-merge-ff-only-refused",
  "description": "Reviewed Dolt port: --ff-only flag failure when fast-forward is not possible",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeScripts: --ff-only flag failure when fast-forward is not possible"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'main1'), (2, 'main2')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit"
      ],
      "save": "main"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "feature"
      ]
    },
    {
      "id": "checkout-feature",
      "session": "a",
      "op": "checkout",
      "args": [
        "feature"
      ]
    },
    {
      "id": "feature-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'feature1')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "feature-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "feature commit"
      ],
      "save": "feature"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "main-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (4, 'main3')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "main-commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit 2"
      ],
      "save": "main2"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "merge",
      "args": [
        "--ff-only",
        "feature"
      ],
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY pk",
      "expect": {
        "rows": [
          [
            "1",
            "main1"
          ],
          [
            "2",
            "main2"
          ],
          [
            "4",
            "main3"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
