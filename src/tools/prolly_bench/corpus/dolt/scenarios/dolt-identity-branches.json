{
  "version": 1,
  "id": "dolt-identity-branches",
  "description": "Reviewed Dolt port: insert on different branches",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltAutoIncrementTests: insert on different branches"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (a int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, b int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "empty-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "empty table"
      ],
      "save": "empty-commit"
    },
    {
      "id": "branch1",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "branch2",
      "session": "a",
      "op": "branch",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (1), (2) RETURNING a",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "commit",
      "args": [
        "two values on main"
      ],
      "save": "assert-1"
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (3), (4) RETURNING a",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "3"
          ],
          [
            "2",
            "4"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "commit",
      "args": [
        "two values on branch1"
      ],
      "save": "assert-5"
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (5), (6) RETURNING a",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "5"
          ],
          [
            "2",
            "6"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
