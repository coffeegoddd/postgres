{
  "version": 1,
  "id": "dolt-status-sequence",
  "description": "Reviewed Dolt port: dolt_status reports AUTO_INCREMENT value changes",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltScripts: dolt_status reports AUTO_INCREMENT value changes"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE ainc (id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO ainc DEFAULT VALUES",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "created",
      "session": "a",
      "op": "commit",
      "args": [
        "create ainc",
        "-A"
      ],
      "save": "created"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE ainc ALTER COLUMN id RESTART WITH 100",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT table_name, staged, status FROM dolt_status",
      "expect": {
        "rows": [
          [
            "public.ainc_id_seq",
            "t",
            "modified"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('ainc')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT table_name, staged, status FROM dolt_status",
      "expect": {
        "rows": [
          [
            "public.ainc_id_seq",
            "t",
            "modified"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "commit",
      "args": [
        "bump auto_increment"
      ],
      "save": "assert-4"
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT count(*) FROM dolt_status",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE ainc ALTER COLUMN id RESTART WITH 100",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT count(*) FROM dolt_status",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
