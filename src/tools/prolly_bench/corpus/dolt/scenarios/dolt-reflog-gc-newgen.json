{
  "version": 1,
  "id": "dolt-reflog-gc-newgen",
  "description": "Reviewed Dolt port: dolt_reflog: garbage collection with newgen data",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltReflogTestScripts: dolt_reflog: garbage collection with newgen data"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.gc",
    "vc.reflog"
  ],
  "sessions": [
    "a",
    "b"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t1 (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t1"
      ],
      "save": "c1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1"
      ],
      "save": "c2"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (2)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 2"
      ],
      "save": "c3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.reflog"
      ],
      "sql": "SELECT ref, commit_hash, commit_message FROM dolt_reflog('main')",
      "expect": {
        "rows": [
          [
            "refs/heads/main",
            {
              "ref": "c3"
            },
            "inserting row 2"
          ],
          [
            "refs/heads/main",
            {
              "ref": "c2"
            },
            "inserting row 1"
          ],
          [
            "refs/heads/main",
            {
              "ref": "c1"
            },
            "creating table t1"
          ],
          [
            "refs/heads/main",
            {
              "ref": "init"
            },
            "Initialize data repository"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.gc"
      ],
      "sql": "SELECT dolt_gc()",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "b",
      "op": "query",
      "requires": [
        "vc.reflog"
      ],
      "sql": "SELECT ref, commit_hash, commit_message FROM dolt_reflog('main')",
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    }
  ]
}
