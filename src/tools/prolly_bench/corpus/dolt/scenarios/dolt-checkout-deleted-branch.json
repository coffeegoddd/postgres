{
  "version": 1,
  "id": "dolt-checkout-deleted-branch",
  "description": "Reviewed Dolt port: branch last checked out is deleted",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltCheckoutScripts: branch last checked out is deleted"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a",
    "ref"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "create table t (a int primary key, b int);"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit-1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "branch",
      "args": [
        "b2"
      ]
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "branch",
      "args": [
        "b3"
      ]
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (1, 1);"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "commit",
      "args": [
        "added values on main"
      ],
      "save": "commit-5"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "checkout",
      "args": [
        "b2"
      ]
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (2, 2);"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "commit",
      "args": [
        "added values on b2"
      ],
      "save": "commit-8"
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "checkout",
      "args": [
        "b3"
      ]
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (3, 3);"
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "commit",
      "args": [
        "added values on b3"
      ],
      "save": "commit-11"
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "checkout",
      "args": [
        "b2"
      ]
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "connect",
      "args": [
        "main"
      ]
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_branch('-df', 'b2');",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch();",
      "expect": {
        "rows": [
          [
            "main"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (4, 4);",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "select * from t order by 1;",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "4",
            "4"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3-connect",
      "session": "ref",
      "op": "connect",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-3",
      "session": "ref",
      "op": "query",
      "sql": "select * from t order by 1;",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "4",
            "4"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "ref",
      "op": "connect",
      "args": [
        "b2"
      ],
      "expect": {
        "sqlstate": "42704"
      }
    }
  ]
}
