{
  "version": 1,
  "id": "dolt-schema-fk-index-ancestor",
  "description": "Reviewed Dolt port: updating fk index when ancestor schema has changed",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: updating fk index when ancestor schema has changed"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE parent (pk int PRIMARY KEY, c1 varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1a",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE child (pk int PRIMARY KEY, remove_me int, parent_id int, CONSTRAINT fk1 FOREIGN KEY (parent_id) REFERENCES parent (pk))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1b",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX fk_idx1 ON child (parent_id)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO parent VALUES (100, 'one hundred'), (200, 'two hundred')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO child VALUES (1, -1, 100), (2, -1, 200)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM child",
      "expect": {
        "tag": "DELETE 2"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM parent",
      "expect": {
        "tag": "DELETE 2"
      }
    },
    {
      "id": "right-2",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE child DROP COLUMN remove_me",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE child DROP COLUMN remove_me",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "merge",
      "args": [
        "right"
      ],
      "save": "merged"
    }
  ]
}
