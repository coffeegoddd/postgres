{
  "version": 1,
  "id": "dolt-temp-table-identity",
  "description": "Reviewed Dolt port: temporary table supports auto increment",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltTempTableScripts: temporary table supports auto increment"
  },
  "requires": [
    "sql"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TEMPORARY TABLE t (i int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT c.relpersistence FROM pg_class c WHERE c.oid = $1::regclass",
      "params": [
        "t"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (DEFAULT), (DEFAULT), (DEFAULT)",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ],
          [
            "3"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100), (1000)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    }
  ]
}
