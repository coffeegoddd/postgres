        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "changes to main"
      ],
      "save": "mainc"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "merge",
      "args": [
        "other"
      ],
      "save": "merged"
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1"
          ]
        ],
        "order": "bag"
      }
    }
