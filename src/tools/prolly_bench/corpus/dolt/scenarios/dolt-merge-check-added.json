        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "initial",
      "session": "a",
      "op": "commit",
      "args": [
        "initial commit"
      ],
      "save": "initial"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "other"
      ]
    },
    {
      "id": "checkout-other",
      "session": "a",
      "op": "checkout",
      "args": [
        "other"
      ]
    },
    {
      "id": "other-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1)",
      "expect": {
