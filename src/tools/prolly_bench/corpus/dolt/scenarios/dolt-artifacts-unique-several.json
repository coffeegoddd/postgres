{
  "version": 1,
  "id": "dolt-artifacts-unique-several",
  "description": "Reviewed Dolt port: Multiple unique key violations for a given row reported",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeArtifactsScripts: Multiple unique key violations for a given row reported"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "force",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int UNIQUE, col2 int UNIQUE)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "base",
      "session": "a",
      "op": "commit",
      "args": [
        "setup"
      ],
      "save": "base"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "checkout-right",
      "session": "a",
      "op": "checkout",
      "args": [
        "right"
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right insert"
      ],
      "save": "rightc"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left insert"
      ],
      "save": "leftc"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT * FROM dolt_constraint_violations()",
      "expect": {
        "rows": [
          [
            "public.t",
            "4"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "1",
            "1"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
