{
  "version": 1,
  "id": "dolt-index-nulls",
  "description": "Reviewed Dolt port: test null filtering in secondary indexes (https://github.com/dolthub/dolt/issues/4199)",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltScripts: test null filtering in secondary indexes (https://github.com/dolthub/dolt/issues/4199)"
  },
  "requires": [
    "sql"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, d timestamp)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-0-index",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX index1 ON t (d)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (d) VALUES (now()), (now())",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (d) VALUES (NULL), (NULL)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "setup-2-plan",
      "session": "a",
      "op": "exec",
      "sql": "SET enable_seqscan = off",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(*) FROM t WHERE d IS NOT NULL",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(*) FROM t WHERE d IS NULL",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(*) FROM t WHERE d IS NOT DISTINCT FROM NULL",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(*) FROM t WHERE NOT (d IS NOT DISTINCT FROM NULL)",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(coalesce(t.d, now())) FROM t, t AS t2 WHERE t.d IS NOT NULL AND t.pk = t2.pk AND t2.d IS NOT NULL",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(coalesce(t.d, now())) FROM t, t AS t2 WHERE t.d IS NULL AND t.pk = t2.pk AND t2.d IS NULL",
      "expect": {
        "rows": [
          [
            "2"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "sql": "SELECT count(coalesce(t.d, now())) FROM t, t AS t2 WHERE t.d IS NULL AND t.pk = t2.pk AND t2.d IS NOT NULL",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
