{
  "version": 1,
  "id": "dolt-diff-fn-virtual-generated",
  "description": "Reviewed Dolt port: diff table function works with virtual generated columns",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffTableFunctionScriptTests: diff table function works with virtual generated columns"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (i int PRIMARY KEY, j int, k int, jk int GENERATED ALWAYS AS (10 * j + k), l int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "created table"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (i, j, k, l) VALUES (1, 2, 3, 4)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "2",
            "3",
            "23",
            "4"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).i, (to_row).jk, (from_row).i, (from_row).jk FROM dolt_diff_table(NULL::t)",
      "expect": {
        "rows": [
          [
            "1",
            null,
            null,
            null
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).i, (to_row).jk, (from_row).i, (from_row).jk FROM dolt_diff('HEAD', 'WORKING', NULL::t)",
      "expect": {
        "rows": [
          [
            "1",
            null,
            null,
            null
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
