{
  "version": 1,
  "id": "dolt-diff-fn-branch-refs",
  "description": "Reviewed Dolt port: diff with branch refs",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffTableFunctionScriptTests: diff with branch refs"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff",
    "vc.mergebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1 into t in main"
      ],
      "save": "commit2"
    },
    {
      "id": "branch1",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "checkout-branch1",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN c2",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping column c2 in branch1"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t WHERE pk = 1",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "deleting row 1 in branch1"
      ],
      "save": "commit4"
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 'two')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit5",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 2 in branch1"
      ],
      "save": "commit5"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "setup-18",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 'two', 'three')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit6",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 2 in main"
      ],
      "save": "commit6"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff('main', 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            "2",
            "two",
            "three",
            "modified"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff('main', 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            "2",
            "two",
            "three",
            "modified"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (to_row).c2, (from_row).pk, (from_row).c1, diff_type FROM dolt_diff('branch1', 'main', NULL::t)",
      "expect": {
        "rows": [
          [
            "1",
            "one",
            "two",
            null,
            null,
            "added"
          ],
          [
            "2",
            "two",
            "three",
            "2",
            "two",
            "modified"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (to_row).c2, (from_row).pk, (from_row).c1, diff_type FROM dolt_diff('branch1', 'main', NULL::t)",
      "expect": {
        "rows": [
          [
            "1",
            "one",
            "two",
            null,
            null,
            "added"
          ],
          [
            "2",
            "two",
            "three",
            "2",
            "two",
            "modified"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff('main~', 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            null,
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff('main~', 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            null,
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff(dolt_merge_base('main', 'branch1'), 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            null,
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (to_row).c2, (from_row).pk, (from_row).c1, diff_type FROM dolt_diff(dolt_merge_base('branch1', 'main'), 'main', NULL::t)",
      "expect": {
        "rows": [
          [
            "2",
            "two",
            "three",
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff(dolt_merge_base('main~', 'branch1'), 'branch1', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ],
          [
            "2",
            "two",
            null,
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, (from_row).c2, diff_type FROM dolt_diff(dolt_merge_base('main', 'branch1~'), 'branch1~', NULL::t)",
      "expect": {
        "rows": [
          [
            null,
            null,
            "1",
            "one",
            "two",
            "removed"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
