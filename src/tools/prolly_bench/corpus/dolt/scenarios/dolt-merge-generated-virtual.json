{
  "version": 1,
  "id": "dolt-merge-generated-virtual",
  "description": "Reviewed Dolt port: merge a virtual column created on another branch",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "GeneratedColumnMergeTestScripts: merge a virtual column created on another branch"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "create table t1 (id bigint primary key, v1 bigint, v2 bigint)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "insert into t1 (id, v1, v2) values (1, 2, 3), (4, 5, 6)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "first",
      "session": "a",
      "op": "commit",
      "args": [
        "first commit",
        "-A"
      ],
      "save": "first"
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "insert into t1 (id, v1, v2) values (7, 8, 9)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit",
        "-A"
      ],
      "save": "main-commit"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t1 ADD COLUMN v3 bigint GENERATED ALWAYS AS (v1 + v2) VIRTUAL",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "exec",
      "sql": "insert into t1 (id, v1, v2) values (10, 11, 12)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "branch1-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "branch1 commit",
        "-A"
      ],
      "save": "branch1-commit"
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "merge",
      "args": [
        "branch1"
      ],
      "save": "merged"
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "select * from t1 order by id",
      "expect": {
        "rows": [
          [
            "1",
            "2",
            "3",
            "5"
          ],
          [
            "4",
            "5",
            "6",
            "11"
          ],
          [
            "7",
            "8",
            "9",
            "17"
          ],
          [
            "10",
            "11",
            "12",
            "23"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "select id from t1 where v3 = 17",
      "expect": {
        "rows": [
          [
            "7"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "select id from t1 where v3 = 23",
      "expect": {
        "rows": [
          [
            "10"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
