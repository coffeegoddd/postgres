{
  "version": 1,
  "id": "dolt-merge-ff-only",
  "description": "Reviewed Dolt port: --ff-only flag success when fast-forward is possible",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeScripts: --ff-only flag success when fast-forward is possible"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'main1'), (2, 'main2')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit"
      ],
      "save": "main"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "feature"
      ]
    },
    {
      "id": "checkout-feature",
      "session": "a",
      "op": "checkout",
      "args": [
        "feature"
      ]
    },
    {
      "id": "feature-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'feature1')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "feature-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "feature commit"
      ],
      "save": "feature"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1] = $1, m[2], m[3], m[4] FROM dolt_merge('--ff-only', 'feature') m",
      "params": [
        {
          "ref": "feature"
        }
      ],
      "expect": {
        "rows": [
          [
            "t",
            "1",
            "0",
            "merge successful"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY pk",
      "expect": {
        "rows": [
          [
            "1",
            "main1"
          ],
          [
            "2",
            "main2"
          ],
          [
            "3",
            "feature1"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
