{
  "version": 1,
  "id": "dolt-diff-fn-arguments",
  "description": "Reviewed Dolt port: invalid arguments",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffTableFunctionScriptTests: invalid arguments"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff",
    "vc.mergebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two'), (2, 'two', 'three')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into t"
      ],
      "save": "commit2"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_diff()",
      "expect": {
        "rows": [
          [
            "3"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('t')",
      "expect": {
        "sqlstate": "42883"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, 't')",
      "expect": {
        "sqlstate": "42883"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, $2, 'extra', NULL::t)",
      "expect": {
        "sqlstate": "42883"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff(NULL, NULL, NULL)",
      "expect": {
        "sqlstate": "22004"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, $2, 123)",
      "expect": {
        "sqlstate": "42809"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff(123, $1, NULL::t)",
      "expect": {
        "sqlstate": "42883"
      },
      "params": [
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, 123, NULL::t)",
      "expect": {
        "sqlstate": "42883"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, $2, NULL::doesnotexist)",
      "expect": {
        "sqlstate": "42704"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('fakefakefakefakefakefakefakefake', $1, NULL::t)",
      "expect": {
        "sqlstate": "42704"
      },
      "params": [
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-10",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, 'fake-branch', NULL::t)",
      "expect": {
        "sqlstate": "42704"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-11",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff($1, concat('fake', '-', 'branch'), NULL::t)",
      "expect": {
        "sqlstate": "42704"
      },
      "params": [
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-12",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core",
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff(dolt_hashof('main'), $1, NULL::t)",
      "expect": {
        "rows": [],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-14",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('main', 'main~')",
      "expect": {
        "sqlstate": "42883"
      }
    },
    {
      "id": "assert-15",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('main', 'main~', 'extra', NULL::t)",
      "expect": {
        "sqlstate": "42883"
      }
    },
    {
      "id": "assert-16",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('main', 'main^', 123)",
      "expect": {
        "sqlstate": "42809"
      }
    },
    {
      "id": "assert-17",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('main', 'main~', NULL::doesnotexist)",
      "expect": {
        "sqlstate": "42704"
      }
    },
    {
      "id": "assert-18",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('fakefakefakefakefakefakefakefake', 'main', NULL::t)",
      "expect": {
        "sqlstate": "42704"
      }
    },
    {
      "id": "assert-19",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff('main', 'fakefakefakefakefakefakefakefake', NULL::t)",
      "expect": {
        "sqlstate": "42704"
      }
    },
    {
      "id": "assert-20",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT * FROM dolt_diff(dolt_merge_base('fakefakefakefakefakefakefakefake', 'main'), 'main', NULL::t)",
      "expect": {
        "sqlstate": "42704"
      }
    },
    {
      "id": "assert-21",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff",
        "vc.mergebase"
      ],
      "sql": "SELECT * FROM dolt_diff(dolt_merge_base('main', 'fakefakefakefakefakefakefakefake'), 'fakefakefakefakefakefakefakefake', NULL::t)",
      "expect": {
        "sqlstate": "42704"
      }
    }
  ]
}
