{
  "version": 1,
  "id": "dolt-rebase-edit-workflow",
  "description": "Reviewed Dolt port: dolt_rebase: comprehensive edit and conflict workflow",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_rebase.go",
    "case": "DoltRebaseScriptTests: dolt_rebase: comprehensive edit and conflict workflow"
  },
  "requires": [
    "sql",
    "vc.conflicts",
    "vc.core",
    "vc.rebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t1 (pk int PRIMARY KEY, val int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (1, 1), (5, 5)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "commit",
      "args": [
        "main commit 1",
        "-A"
      ],
      "save": "c1"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "branch",
      "args": [
        "b1"
      ]
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "checkout",
      "args": [
        "b1"
      ]
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t1 SET val = 11 WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "commit",
      "args": [
        "b1 commit 1 - to edit",
        "-a"
      ],
      "save": "b1"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (10, 100)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "commit",
      "args": [
        "b1 commit 2 - will conflict",
        "-a"
      ],
      "save": "b2"
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (20, 200)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "commit",
      "args": [
        "b1 commit 3 - clean apply",
        "-a"
      ],
      "save": "b3"
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (30, 300)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "commit",
      "args": [
        "b1 commit 4 - edit at end",
        "-a"
      ],
      "save": "b4"
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "setup-15",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (10, 999)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-16",
      "session": "a",
      "op": "commit",
      "args": [
        "main conflicting data",
        "-a"
      ],
      "save": "m1"
    },
    {
      "id": "setup-17",
      "session": "a",
      "op": "checkout",
      "args": [
        "b1"
      ]
    },
    {
      "id": "setup-18",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('-i', 'main')",
      "expect": {
        "rows": [
          [
            "{0,\"interactive rebase started on branch dolt_rebase_b1; adjust the rebase plan in the dolt_rebase table, then continue rebasing by calling dolt_rebase('--continue')\"}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "setup-19",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'edit' WHERE rebase_order = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "setup-20",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'edit' WHERE rebase_order = 4",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT rebase_order, action, commit_message FROM dolt_rebase ORDER BY rebase_order",
      "expect": {
        "rows": [
          [
            "1.00",
            "edit",
            "b1 commit 1 - to edit"
          ],
          [
            "2.00",
            "pick",
            "b1 commit 2 - will conflict"
          ],
          [
            "3.00",
            "pick",
            "b1 commit 3 - clean apply"
          ],
          [
            "4.00",
            "edit",
            "b1 commit 4 - edit at end"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT r[1], r[2] ~ '^edit action paused at commit [0-9a-f]+ \\(.+\\)\\.\\s+You can now modify the working directory and stage changes\\. When ready, continue the rebase by calling dolt_rebase\\(''--continue''\\)$' FROM dolt_rebase('--continue') r",
      "expect": {
        "rows": [
          [
            "0",
            "t"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "dolt_rebase_b1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, val FROM t1 ORDER BY pk",
      "expect": {
        "rows": [
          [
            "1",
            "11"
          ],
          [
            "5",
            "5"
          ],
          [
            "10",
            "999"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t1 SET val = 55 WHERE pk = 5",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('t1')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length(dolt_commit('--amend', '-m', 'b1 commit 1 - to edit (modified)')::text) > 0",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT r[1], r[2] LIKE 'data conflict detected while rebasing commit % (b1 commit 2 - will conflict). %' FROM dolt_rebase('--continue') r",
      "expect": {
        "rows": [
          [
            "1",
            "t"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SELECT count(*) FROM dolt_conflicts",
      "expect": {
        "rows": [
          [
            "1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SELECT (our_row).pk, (our_row).val, (their_row).pk, (their_row).val FROM dolt_conflicts(NULL::t1)",
      "expect": {
        "rows": [
          [
            "10",
            "999",
            "10",
            "100"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-10",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SELECT dolt_conflicts_resolve('--ours', 't1')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-11",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t1 SET val = 200 WHERE pk = 10",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-12",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('t1')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-13",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT r[1], r[2] ~ '^edit action paused at commit [0-9a-f]+ \\(.+\\)\\.\\s+You can now modify the working directory and stage changes\\. When ready, continue the rebase by calling dolt_rebase\\(''--continue''\\)$' FROM dolt_rebase('--continue') r",
      "expect": {
        "rows": [
          [
            "0",
            "t"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-14",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "dolt_rebase_b1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-15",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, val FROM t1 ORDER BY pk",
      "expect": {
        "rows": [
          [
            "1",
            "11"
          ],
          [
            "5",
            "55"
          ],
          [
            "10",
            "200"
          ],
          [
            "20",
            "200"
          ],
          [
            "30",
            "300"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-16",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t1 VALUES (42, 24)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-17",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('t1')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-18",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length(dolt_commit('-am', 'b1 commit 5 - additional commit during edit')::text) > 0",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-19",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('--continue')",
      "expect": {
        "rows": [
          [
            "{0,\"Successfully rebased and updated refs/heads/b1\"}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-20",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT active_branch()",
      "expect": {
        "rows": [
          [
            "b1"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-21",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT message FROM dolt_log",
      "expect": {
        "rows": [
          [
            "b1 commit 5 - additional commit during edit"
          ],
          [
            "b1 commit 4 - edit at end"
          ],
          [
            "b1 commit 3 - clean apply"
          ],
          [
            "b1 commit 2 - will conflict"
          ],
          [
            "b1 commit 1 - to edit (modified)"
          ],
          [
            "main conflicting data"
          ],
          [
            "main commit 1"
          ],
          [
            "Initialize data repository"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
