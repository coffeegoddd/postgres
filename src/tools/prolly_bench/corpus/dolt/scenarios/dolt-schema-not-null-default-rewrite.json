{
  "version": 1,
  "id": "dolt-schema-not-null-default-rewrite",
  "description": "Reviewed Dolt port: adding a not-null constraint and default value to a column, alongside table rewrite",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsSchemaConflicts: adding a not-null constraint and default value to a column, alongside table rewrite"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, NULL), (2, NULL)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col1 = 9999 WHERE col1 IS NULL",
      "expect": {
        "tag": "UPDATE 2"
      }
    },
    {
      "id": "right-1a",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 SET NOT NULL",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1b",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 SET DEFAULT 9999",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-2",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col2 int DEFAULT 100",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 30, 200), (4, 40, 300)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (5, NULL), (6, NULL)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "9999",
            "100"
          ],
          [
            "2",
            "9999",
            "100"
          ],
          [
            "3",
            "30",
            "200"
          ],
          [
            "4",
            "40",
            "300"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'pk', violation_type FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "5",
            "not null"
          ],
          [
            "6",
            "not null"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
