{
  "version": 1,
  "id": "dolt-schema-generated-reorder",
  "description": "Reviewed Dolt port: reordering a column",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsGeneratedColumns: reordering a column"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int, col2 varchar(100) GENERATED ALWAYS AS (col1::text || 'hello') STORED)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (pk, col1) VALUES (1, 10), (2, 20)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (pk, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx2 ON t (col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-4",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx3 ON t (pk, col1, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-5",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx4 ON t (col1, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-6",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx5 ON t (col2, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-7",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx6 ON t (col2, pk, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (pk, col1) VALUES (3, 30), (4, 40)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (pk, col1) VALUES (5, 50), (6, 60)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "merge",
      "args": [
        "right"
      ],
      "save": "merged"
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, col1, col2 FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "10",
            "10hello"
          ],
          [
            "2",
            "20",
            "20hello"
          ],
          [
            "3",
            "30",
            "30hello"
          ],
          [
            "4",
            "40",
            "40hello"
          ],
          [
            "5",
            "50",
            "50hello"
          ],
          [
            "6",
            "60",
            "60hello"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
