{
  "version": 1,
  "id": "dolt-schema-check-altered",
  "description": "Reviewed Dolt port: altering a check constraint on one side",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: altering a check constraint on one side"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(100))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD CONSTRAINT check1 CHECK (c1 IN ('one', 'two'))",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP CONSTRAINT check1",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD CONSTRAINT check1 CHECK (c1 IN ('one', 'two', 'three'))",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'three')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 'two')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "sql": "SELECT m[1] <> '', m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "t",
            "0",
            "0",
            "merge successful"
          ]
        ],
        "order": "bag"
      },
      "requires": [
        "vc.merge"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "one"
          ],
          [
            "2",
            "two"
          ],
          [
            "3",
            "three"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
