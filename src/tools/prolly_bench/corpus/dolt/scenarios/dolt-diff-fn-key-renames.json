      "sql": "SELECT (to_row).pk2a, (to_row).pk2b, (to_row).col1, (from_row).pk2a, (from_row).pk2b, (from_row).col1, diff_type FROM dolt_diff('HEAD~', 'HEAD', NULL::t2)",
      "expect": {
