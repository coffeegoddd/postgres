{
  "version": 1,
  "id": "dolt-tag-merge",
  "description": "Reviewed Dolt port: dolt-tag: SQL use a tag as a ref for merge",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltTagTestScripts: dolt-tag: SQL use a tag as a ref for merge"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.tags"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (0), (1), (2)",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "commit",
      "args": [
        "created table test",
        "-a"
      ],
      "save": "created"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM test WHERE pk = 0",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (3)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "commit",
      "args": [
        "made changes",
        "-a"
      ],
      "save": "changed"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.tags"
      ],
      "sql": "SELECT dolt_tag('v1', 'HEAD')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "other",
        "HEAD^"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "checkout",
      "args": [
        "other"
      ]
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (8), (9)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "commit",
      "args": [
        "made changes in other",
        "-a"
      ],
      "save": "other"
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT length(m[1]) = 40, m[2], m[3], m[4] FROM dolt_merge('v1') m",
      "expect": {
        "rows": [
          [
            "t",
            "0",
            "0",
            "merge successful"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM test",
      "expect": {
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ],
          [
            "3"
          ],
          [
            "8"
          ],
          [
            "9"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
