{
  "version": 1,
  "id": "dolt-merge-local-changes",
  "description": "Reviewed Dolt port: CALL DOLT_MERGE complains when a merge overrides local changes",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeScripts: CALL DOLT_MERGE complains when a merge overrides local changes"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (pk int PRIMARY KEY, val int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (0, 0)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "autocommit",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "step1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-am', 'Step 1'))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "checkout-feature",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_checkout('-b', 'feature-branch')",
      "expect": {
        "rows": [
          [
            "{0,\"Switched to branch 'feature-branch'\"}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "insert1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "update-feature",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE test SET val=1000 WHERE pk=0",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "feature-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-am', 'this is a normal commit'))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_checkout('main')",
      "expect": {
        "rows": [
          [
            "{0,\"Switched to branch 'main'\"}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "update-main",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE test SET val=1001 WHERE pk=0",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT dolt_merge('feature-branch', '-m', 'this is a merge')",
      "expect": {
        "sqlstate": "55000"
      }
    }
  ]
}
