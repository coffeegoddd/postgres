{
  "version": 1,
  "id": "dolt-schema-drop-column",
  "description": "Reviewed Dolt port: dropping columns",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsBasicCases: dropping columns"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int, col2 varchar(100), CONSTRAINT unique1 UNIQUE (col2, pk))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 10, '100'), (2, 20, '200')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (pk, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx2 ON t (pk, col1, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-4",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx3 ON t (col1, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-5",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx4 ON t (pk, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "anc-6",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx5 ON t (col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN col1",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, '300'), (4, '400')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (5, 50, '500'), (6, 60, '600')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "merge",
      "args": [
        "right"
      ],
      "save": "merged"
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, col2 FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "100"
          ],
          [
            "2",
            "200"
          ],
          [
            "3",
            "300"
          ],
          [
            "4",
            "400"
          ],
          [
            "5",
            "500"
          ],
          [
            "6",
            "600"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
