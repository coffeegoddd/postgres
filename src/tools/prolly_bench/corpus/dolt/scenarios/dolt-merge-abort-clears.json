      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "merge",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT (dolt_merge('feature-branch'))[2:4]",
      "expect": {
        "rows": [
          [
            "{0,1,\"conflicts found\"}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "abort",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT (dolt_merge('--abort'))[4]",
      "expect": {
        "rows": [
