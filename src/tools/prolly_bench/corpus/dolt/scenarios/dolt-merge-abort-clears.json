  "steps": [
    {
      "id": "create-test",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (0),(1),(2)",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "autocommit",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "create-one",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE one_pk (pk1 bigint NOT NULL, c1 bigint, c2 bigint, PRIMARY KEY (pk1))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "tables-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "add tables"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "branch",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_branch($1)",
      "params": [
        "feature-branch"
      ],
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "checkout-feature",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "feature-branch"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "main"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "main-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO one_pk (pk1,c1,c2) VALUES (0,0,0)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "changed main"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "checkout-feature2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "feature-branch"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "feature-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO one_pk (pk1,c1,c2) VALUES (0,1,1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "feature-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "changed feature branch"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
