{
  "version": 1,
  "id": "dolt-artifacts-unique-multi-3",
  "description": "Reviewed Dolt port: Multiple unique key violations part 3 (repro issue #5719)",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeArtifactsScripts: Multiple unique key violations part 3 (repro issue #5719)"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "force",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (id int NOT NULL, col1 varchar(255), col2 varchar(255), col3 varchar(255), PRIMARY KEY (id), CONSTRAINT uniq_idx UNIQUE (col1, col2, col3))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (id, col1, col2, col3) VALUES (1, 'val1', 'val1', 'val1'), (4, 'val1', 'val2', 'val1')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "add",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('.')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "base",
      "session": "a",
      "op": "commit",
      "args": [
        "new table"
      ],
      "save": "base"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "checkout-right",
      "session": "a",
      "op": "checkout",
      "args": [
        "right"
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col3 = 'val2'",
      "expect": {
        "tag": "UPDATE 2"
      }
    },
    {
      "id": "right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right update"
      ],
      "save": "rightc"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (id, col1, col2, col3) VALUES (3, 'val1', 'val1', 'val2')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "main insert"
      ],
      "save": "leftc"
    },
    {
      "id": "checkout-right2",
      "session": "a",
      "op": "checkout",
      "args": [
        "right"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('main') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT * FROM dolt_constraint_violations()",
      "expect": {
        "rows": [
          [
            "public.t",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'id', violating_row->>'col1', violating_row->>'col2', violating_row->>'col3' FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "3",
            "val1",
            "val1",
            "val2"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
