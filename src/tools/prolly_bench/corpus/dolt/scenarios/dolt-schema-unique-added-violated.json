{
  "version": 1,
  "id": "dolt-schema-unique-added-violated",
  "description": "Reviewed Dolt port: adding a unique key, with unique key violation",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: adding a unique key, with unique key violation"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int, col1 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD UNIQUE (col1)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "left-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0-forward",
      "session": "a",
      "variants": [
        "forward"
      ],
      "op": "exec",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT dolt_merge('right')",
      "expect": {
        "sqlstate": "23505"
      }
    },
    {
      "id": "assert-0-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "sql": "SELECT pk, col1 FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2-flipped",
      "session": "a",
      "variants": [
        "flipped"
      ],
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'pk', violating_row->>'col1' FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "2",
            "1"
          ],
          [
            "3",
            "1"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
