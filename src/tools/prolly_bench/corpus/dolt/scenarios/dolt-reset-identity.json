{
  "version": 1,
  "id": "dolt-reset-identity",
  "description": "Reviewed Dolt port: hard reset inserted rows continues auto increment",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltAutoIncrementTests: hard reset inserted rows continues auto increment"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (a int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, b int)"
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (1), (2)"
    },
    {
      "id": "commit",
      "session": "a",
      "op": "commit",
      "args": [
        "initialize table"
      ],
      "save": "base"
    },
    {
      "id": "dirty",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (3), (4)"
    },
    {
      "id": "reset",
      "session": "a",
      "op": "reset",
      "args": [
        "HEAD"
      ]
    },
    {
      "id": "insert-after-reset",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (5) RETURNING a",
      "expect": {
        "rows": [
          [
            "5"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "rows-after-reset",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "2",
            "2"
          ],
          [
            "5",
            "5"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
