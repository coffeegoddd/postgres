{
  "version": 1,
  "id": "dolt-merge-delete-keeps-violations",
  "description": "Reviewed Dolt port: `Delete from table` should keep artifacts - violations",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeScripts: `Delete from table` should keep artifacts - violations"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int UNIQUE)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "create-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "create table"
      ],
      "save": "create-commit"
    },
    {
      "id": "branch-other",
      "session": "a",
      "op": "branch",
      "args": [
        "other"
      ]
    },
    {
      "id": "checkout-other",
      "session": "a",
      "op": "checkout",
      "args": [
        "other"
      ]
    },
    {
      "id": "other-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 1), (3, 3)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "other-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "other insert"
      ],
      "save": "other-commit"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "main-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 1), (4, 4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "main insert"
      ],
      "save": "main-commit"
    },
    {
      "id": "allow",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "merge",
      "session": "a",
      "op": "merge",
      "args": [
        "other"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'pk', violating_row->>'col1' FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "2",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t",
      "expect": {
        "tag": "DELETE 3"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'pk', violating_row->>'col1' FROM dolt_constraint_violations('t')",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "2",
            "1"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
