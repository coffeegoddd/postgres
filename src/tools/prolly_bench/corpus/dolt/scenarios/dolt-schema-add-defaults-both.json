{
  "version": 1,
  "id": "dolt-schema-add-defaults-both",
  "description": "Reviewed Dolt port: adding columns with default values to both sides",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsBasicCases: adding columns with default values to both sides"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1), (2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (pk)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "commit",
      "args": [
        "ancestor commit"
      ],
      "save": "ancestor"
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "right_side"
        }
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col2 varchar(100) DEFAULT 'abc'",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, '300'), (4, '400')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right commit"
      ],
      "save": "rightc"
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "checkout",
      "args": [
        {
          "var": "left_side"
        }
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col1 int DEFAULT 101",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "left-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (5, 50), (6, 60)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left commit"
      ],
      "save": "leftc"
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "merge",
      "args": [
        "right"
      ],
      "save": "merged"
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT pk, col1, col2 FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "101",
            "abc"
          ],
          [
            "2",
            "101",
            "abc"
          ],
          [
            "3",
            "101",
            "300"
          ],
          [
            "4",
            "101",
            "400"
          ],
          [
            "5",
            "50",
            "abc"
          ],
          [
            "6",
            "60",
            "abc"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
