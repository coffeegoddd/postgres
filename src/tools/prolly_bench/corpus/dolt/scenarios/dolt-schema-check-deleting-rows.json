{
  "version": 1,
  "id": "dolt-schema-check-deleting-rows",
  "description": "Reviewed Dolt port: check constraint violation - deleting rows",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsConstraints: check constraint violation - deleting rows"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int, col2 int, col3 int, CHECK (col2 != col3))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 2, 3, -3)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (pk, col2)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "ancestor commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_branch('right')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "right_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t WHERE pk = 1",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "right commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "left_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (4, 3, 2, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 64",
      "params": [
        "left commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "main"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1] <> '', m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "t",
            "0",
            "0",
            "merge successful"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
