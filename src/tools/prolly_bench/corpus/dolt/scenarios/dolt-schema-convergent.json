{
  "version": 1,
  "id": "dolt-schema-convergent",
  "description": "Reviewed Dolt port: convergent schema changes",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsBasicCases: convergent schema changes"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE parent (id int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO parent VALUES (1), (2), (3)",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 10)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "ancestor commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_branch('right')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "right_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 SET NOT NULL",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col3 int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (col3, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "right-3",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD CONSTRAINT fk1 FOREIGN KEY (col3) REFERENCES parent (id)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "right commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        {
          "var": "left_side"
        }
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 SET NOT NULL",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "left-1",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN col3 int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "left-2",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (col3, col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "left-3",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col1 = -1000 WHERE t.pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "left-4",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD CONSTRAINT fk1 FOREIGN KEY (col3) REFERENCES parent (id)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "left commit"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "h-main",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT (dolt_checkout($1))[1]",
      "params": [
        "main"
      ],
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1] <> '', m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "t",
            "0",
            "0",
            "merge successful"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "1",
            "-1000",
            null
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
