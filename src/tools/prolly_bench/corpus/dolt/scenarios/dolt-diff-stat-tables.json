{
  "version": 1,
  "id": "dolt-diff-stat-tables",
  "description": "Reviewed Dolt port: basic case with multiple tables",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffStatTableFunctionScriptTests: basic case with multiple tables"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "initial",
      "session": "a",
      "op": "commit",
      "args": [
        "initial",
        "--allow-empty"
      ],
      "save": "commit0"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t2 (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t2 VALUES (100, 'hundred', 'hundert')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t2"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, 'two', 'three'), (3, 'three', 'four'), (4, 'four', 'five')",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c1 = 'uno', c2 = 'dos' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t2 VALUES (101, 'hundred one', 'one')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-16",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM t WHERE c2 = 'four'",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "setup-17",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t2 SET c2 = 'zero' WHERE pk = 100",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into table t"
      ],
      "save": "commit4"
    },
    {
      "id": "setup-20",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE keyless (id int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2)",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "1",
            "0",
            "0",
            "3",
            "0",
            "0",
            "0",
            "1",
            "0",
            "3"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit0"
        },
        {
          "ref": "commit1"
        }
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2)",
      "expect": {
        "rows": [
          [
            "public.t2",
            "0",
            "1",
            "0",
            "0",
            "3",
            "0",
            "0",
            "0",
            "1",
            "0",
            "3"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2)",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "3",
            "0",
            "1",
            "9",
            "0",
            "2",
            "1",
            "4",
            "3",
            "12"
          ],
          [
            "public.t2",
            "1",
            "1",
            "0",
            "0",
            "3",
            "0",
            "0",
            "1",
            "2",
            "3",
            "6"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        },
        {
          "ref": "commit3"
        }
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2)",
      "expect": {
        "rows": [
          [
            "public.t",
            "3",
            "0",
            "1",
            "0",
            "0",
            "3",
            "0",
            "4",
            "3",
            "12",
            "9"
          ],
          [
            "public.t2",
            "1",
            "0",
            "0",
            "1",
            "0",
            "0",
            "1",
            "2",
            "2",
            "6",
            "6"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        },
        {
          "ref": "commit4"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2)",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "0",
            "2",
            "1",
            "0",
            "6",
            "2",
            "3",
            "1",
            "9",
            "3"
          ],
          [
            "public.t2",
            "0",
            "0",
            "1",
            "1",
            "0",
            "3",
            "1",
            "2",
            "1",
            "6",
            "3"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit4"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, 'WORKING')",
      "expect": {
        "rows": [
          [
            "public.t",
            "3",
            "0",
            "1",
            "0",
            "0",
            "3",
            "0",
            "4",
            "3",
            "12",
            "9"
          ],
          [
            "public.t2",
            "1",
            "0",
            "0",
            "1",
            "0",
            "0",
            "1",
            "2",
            "2",
            "6",
            "6"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        }
      ]
    }
  ]
}
