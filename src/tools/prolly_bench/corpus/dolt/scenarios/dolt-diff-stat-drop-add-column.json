{
  "version": 1,
  "id": "dolt-diff-stat-drop-add-column",
  "description": "Reviewed Dolt port: schema modification: drop and add column",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffStatTableFunctionScriptTests: schema modification: drop and add column"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 varchar(20), c2 varchar(20))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 'one', 'two'), (2, 'two', 'three')",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1, 2 into t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP COLUMN c2",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping column c2"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, 'three')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 3"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD COLUMN c2 varchar(20)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (4, 'four', 'five')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET c2 = 'foo' WHERE pk = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "adding column c2, inserting, and updating data"
      ],
      "save": "commit4"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "0",
            "0",
            "2",
            "0",
            "2",
            "2",
            "2",
            "2",
            "6",
            "4"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "2",
            "1",
            "0",
            "0",
            "2",
            "0",
            "0",
            "2",
            "3",
            "4",
            "6"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit2"
        },
        {
          "ref": "commit3"
        }
      ]
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "1",
            "0",
            "2",
            "2",
            "2",
            "2",
            "2",
            "3",
            "6",
            "6"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit3"
        }
      ]
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "2",
            "1",
            "0",
            "1",
            "6",
            "0",
            "1",
            "3",
            "4",
            "6",
            "12"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit3"
        },
        {
          "ref": "commit4"
        }
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT * FROM dolt_diff_stat($1, $2, 't')",
      "expect": {
        "rows": [
          [
            "public.t",
            "0",
            "2",
            "0",
            "2",
            "6",
            "0",
            "2",
            "2",
            "4",
            "6",
            "12"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit4"
        }
      ]
    }
  ]
}
