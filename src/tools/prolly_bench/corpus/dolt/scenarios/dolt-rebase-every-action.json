{
  "version": 1,
  "id": "dolt-rebase-every-action",
  "description": "Reviewed Dolt port: dolt_rebase: rebase plan using every action",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_rebase.go",
    "case": "DoltRebaseScriptTests: dolt_rebase: rebase plan using every action"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.rebase"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t",
        "-A"
      ],
      "save": "c1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (0)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 0",
        "-a"
      ],
      "save": "m0"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1",
        "-a"
      ],
      "save": "r1"
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (10)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 10",
        "-a"
      ],
      "save": "r10"
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-11",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 100",
        "-a"
      ],
      "save": "r100"
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-13",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 1000",
        "-a"
      ],
      "save": "r1000"
    },
    {
      "id": "setup-14",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (10000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-15",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 10000",
        "-a"
      ],
      "save": "r10000"
    },
    {
      "id": "setup-16",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (100000)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-17",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting row 100000",
        "-a"
      ],
      "save": "r100000"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('-i', 'main')",
      "expect": {
        "rows": [
          [
            "{0,\"interactive rebase started on branch dolt_rebase_branch1; adjust the rebase plan in the dolt_rebase table, then continue rebasing by calling dolt_rebase('--continue')\"}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT * FROM dolt_rebase ORDER BY rebase_order ASC",
      "expect": {
        "rows": [
          [
            "1.00",
            "pick",
            {
              "ref": "r1"
            },
            "inserting row 1"
          ],
          [
            "2.00",
            "pick",
            {
              "ref": "r10"
            },
            "inserting row 10"
          ],
          [
            "3.00",
            "pick",
            {
              "ref": "r100"
            },
            "inserting row 100"
          ],
          [
            "4.00",
            "pick",
            {
              "ref": "r1000"
            },
            "inserting row 1000"
          ],
          [
            "5.00",
            "pick",
            {
              "ref": "r10000"
            },
            "inserting row 10000"
          ],
          [
            "6.00",
            "pick",
            {
              "ref": "r100000"
            },
            "inserting row 100000"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET rebase_order = 6.1 WHERE rebase_order = 6",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'squash' WHERE rebase_order IN (2, 3)",
      "expect": {
        "tag": "UPDATE 2"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'drop' WHERE rebase_order = 4",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'reword', commit_message = 'reworded!' WHERE rebase_order = 5",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "UPDATE dolt_rebase SET action = 'fixup' WHERE rebase_order = 6.10",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT * FROM dolt_rebase ORDER BY rebase_order ASC",
      "expect": {
        "rows": [
          [
            "1.00",
            "pick",
            {
              "ref": "r1"
            },
            "inserting row 1"
          ],
          [
            "2.00",
            "squash",
            {
              "ref": "r10"
            },
            "inserting row 10"
          ],
          [
            "3.00",
            "squash",
            {
              "ref": "r100"
            },
            "inserting row 100"
          ],
          [
            "4.00",
            "drop",
            {
              "ref": "r1000"
            },
            "inserting row 1000"
          ],
          [
            "5.00",
            "reword",
            {
              "ref": "r10000"
            },
            "reworded!"
          ],
          [
            "6.10",
            "fixup",
            {
              "ref": "r100000"
            },
            "inserting row 100000"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('--continue')",
      "expect": {
        "rows": [
          [
            "{0,\"Successfully rebased and updated refs/heads/branch1\"}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-9",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT dolt_rebase('--continue')",
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-10",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.rebase"
      ],
      "sql": "SELECT * FROM dolt_rebase",
      "expect": {
        "sqlstate": "42P01"
      }
    },
    {
      "id": "assert-11",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT name FROM dolt_branches",
      "expect": {
        "rows": [
          [
            "main"
          ],
          [
            "branch1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-12",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT message FROM dolt_log",
      "expect": {
        "rows": [
          [
            "reworded!"
          ],
          [
            "inserting row 1\n\ninserting row 10\n\ninserting row 100"
          ],
          [
            "inserting row 0"
          ],
          [
            "creating table t"
          ],
          [
            "Initialize data repository"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-13",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t",
      "expect": {
        "rows": [
          [
            "0"
          ],
          [
            "1"
          ],
          [
            "10"
          ],
          [
            "100"
          ],
          [
            "10000"
          ],
          [
            "100000"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
