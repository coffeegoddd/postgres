{
  "version": 1,
  "id": "dolt-history-index-lookup",
  "description": "Reviewed Dolt port: dolt_history table index lookup",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "HistorySystemTableScriptTests: dolt_history table index lookup"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "create table yx (y int, x int primary key)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "insert into yx values (0, 1)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "add data",
        "-a"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "insert into yx values (2, 3)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "add data",
        "-a"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "exec",
      "sql": "insert into yx values (4, 5)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "add data",
        "-a"
      ],
      "save": "commit4"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "select count((row).x) from dolt_history_table(NULL::yx) where (row).x = 1",
      "expect": {
        "rows": [
          [
            "3"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
