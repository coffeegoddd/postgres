{
  "version": 1,
  "id": "dolt-revert-violations",
  "description": "Reviewed Dolt port: dolt_revert() detects constraint violations and returns violation counts",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_revert.go",
    "case": "RevertScripts: dolt_revert() detects constraint violations and returns violation counts"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.violations",
    "vc.revert"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "autocommit",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test2 (pk int PRIMARY KEY, c0 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test2 VALUES (1,1),(2,NULL),(3,3)",
      "expect": {
        "tag": "INSERT 0 3"
      }
    },
    {
      "id": "seed-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "new table with NULL value"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "delete",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM test2 WHERE pk = 2",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "delete-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "deleted row with NULL value"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "not-null",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE test2 ALTER COLUMN c0 SET NOT NULL",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "not-null-commit",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "params": [
        "modified column c0 to not null"
      ],
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.revert"
      ],
      "sql": "SELECT r[1], r[2], r[3], r[4] FROM dolt_revert('head~1') r",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "0",
            "1"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT table_name FROM dolt_constraint_violations()",
      "expect": {
        "rows": [
          [
            "public.test2"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violation_type, violating_row->>'pk', violating_row->>'c0' FROM dolt_constraint_violations('test2')",
      "expect": {
        "rows": [
          [
            "not null",
            "2",
            null
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
