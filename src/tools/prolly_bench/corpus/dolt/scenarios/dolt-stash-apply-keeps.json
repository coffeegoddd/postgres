{
  "version": 1,
  "id": "dolt-stash-apply-keeps",
  "description": "Reviewed Dolt port: stash apply maintains stash entry",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_stash.go",
    "case": "DoltStashTests: stash apply maintains stash entry"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.stash"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "first",
      "session": "a",
      "op": "commit",
      "args": [
        "First commit",
        "--allow-empty"
      ],
      "save": "first"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test(id INT)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash', '-a')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT * FROM dolt_stashes",
      "expect": {
        "rows": [
          [
            "myStash",
            "stash@{0}",
            "main",
            {
              "ref": "first"
            },
            "First commit"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('apply', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT * FROM dolt_stashes",
      "expect": {
        "rows": [
          [
            "myStash",
            "stash@{0}",
            "main",
            {
              "ref": "first"
            },
            "First commit"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
