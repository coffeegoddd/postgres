{
  "version": 1,
  "id": "dolt-fk-binary-fk-column",
  "description": "Reviewed Dolt port: UPDATE on table where the FK column is BINARY",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_foreign_keys.go",
    "case": "DoltForeignKeyTests: UPDATE on table where the FK column is BINARY"
  },
  "requires": [
    "sql"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "parent",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE parent (id bytea NOT NULL PRIMARY KEY)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "child",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE child (id int NOT NULL PRIMARY KEY, parent_id bytea, val int, CONSTRAINT fk_parent FOREIGN KEY (parent_id) REFERENCES parent (id))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "parent-row",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO parent VALUES ('\\x00000000000000000000000000000001')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "child-row",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO child VALUES (1, '\\x00000000000000000000000000000001', 10)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE child SET val = 20 WHERE id = 1",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT val FROM child WHERE id = 1",
      "expect": {
        "rows": [
          [
            "20"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
