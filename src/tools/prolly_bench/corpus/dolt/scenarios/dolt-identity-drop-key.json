{
  "version": 1,
  "id": "dolt-identity-drop-key",
  "description": "Reviewed Dolt port: drop auto_increment primary key",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries.go",
    "case": "DoltAutoIncrementTests: drop auto_increment primary key"
  },
  "requires": [
    "sql",
    "vc.core"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (a int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, b int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "create-index",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX ON t (a)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "empty-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "empty table"
      ],
      "save": "empty-commit"
    },
    {
      "id": "branch1",
      "session": "a",
      "op": "branch",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "branch2",
      "session": "a",
      "op": "branch",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "main-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (1), (2)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "two values on main"
      ],
      "save": "main-commit"
    },
    {
      "id": "checkout-branch1",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch1"
      ]
    },
    {
      "id": "branch1-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (3), (4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "branch1-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "two values on branch1"
      ],
      "save": "branch1-commit"
    },
    {
      "id": "checkout-branch2",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "branch2-insert",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t (b) VALUES (5), (6)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "checkout-main-again",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP CONSTRAINT t_pkey",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (7), (8) RETURNING a",
      "expect": {
        "rows": [
          [
            "3"
          ],
          [
            "4"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "1"
          ],
          [
            "2",
            "2"
          ],
          [
            "3",
            "7"
          ],
          [
            "4",
            "8"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "checkout",
      "args": [
        "branch2"
      ]
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (9), (10) RETURNING a",
      "expect": {
        "rows": [
          [
            "3"
          ],
          [
            "4"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "5"
          ],
          [
            "2",
            "6"
          ],
          [
            "3",
            "9"
          ],
          [
            "4",
            "10"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-6",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP CONSTRAINT t_pkey",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "assert-7",
      "session": "a",
      "op": "query",
      "sql": "INSERT INTO t (b) VALUES (11), (12) RETURNING a",
      "expect": {
        "rows": [
          [
            "5"
          ],
          [
            "6"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-8",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM t ORDER BY a",
      "expect": {
        "rows": [
          [
            "1",
            "5"
          ],
          [
            "2",
            "6"
          ],
          [
            "3",
            "9"
          ],
          [
            "4",
            "10"
          ],
          [
            "5",
            "11"
          ],
          [
            "6",
            "12"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
