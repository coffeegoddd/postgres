{
  "version": 1,
  "id": "dolt-diff-table-key-change",
  "description": "Reviewed Dolt port: primary key change",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSystemTableScriptTests: primary key change"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, c1 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, 2), (3, 4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t DROP CONSTRAINT t_pkey",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (5, 6)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping primary key"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ADD PRIMARY KEY (c1)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "adding primary key"
      ],
      "save": "commit3"
    },
    {
      "id": "setup-12",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (7, 8)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit4",
      "session": "a",
      "op": "commit",
      "args": [
        "adding more data"
      ],
      "save": "commit4"
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT count(*) FROM dolt_diff_table(NULL::t)",
      "expect": {
        "rows": [
          [
            "4"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c1, (from_row).pk, (from_row).c1, diff_type FROM dolt_diff_table(NULL::t) WHERE to_commit = $1",
      "expect": {
        "rows": [
          [
            "7",
            "8",
            null,
            null,
            "added"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "ref": "commit4"
        }
      ]
    }
  ]
}
