{
  "version": 1,
  "id": "dolt-commit-diff-column-drop",
  "description": "Reviewed Dolt port: schema modification: column drop",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "CommitDiffSystemTableScriptTests: schema modification: column drop"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "commit0",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "commit0"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "create table t (pk int primary key, c1 int, c2 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (1, 2, 3), (4, 5, 6)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t",
        "-a"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "alter table t drop column c1",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping column c",
        "-a"
      ],
      "save": "commit2"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c2, (from_row).pk, (from_row).c2 FROM dolt_diff($1, $2, NULL::t) ORDER BY (to_row).pk",
      "params": [
        {
          "ref": "commit0"
        },
        {
          "ref": "commit1"
        }
      ],
      "expect": {
        "rows": [
          [
            "1",
            "3",
            null,
            null
          ],
          [
            "4",
            "6",
            null,
            null
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c2, (from_row).pk, (from_row).c2 FROM dolt_diff($1, $2, NULL::t) ORDER BY (to_row).pk",
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ],
      "expect": {
        "rows": [],
        "order": "ordered"
      }
    }
  ]
}
