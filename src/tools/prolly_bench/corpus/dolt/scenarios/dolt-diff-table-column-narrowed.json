{
  "version": 1,
  "id": "dolt-diff-table-column-narrowed",
  "description": "Reviewed Dolt port: columns modified to narrower types",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "DiffSystemTableScriptTests: columns modified to narrower types"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-domain",
      "session": "a",
      "op": "exec",
      "sql": "CREATE DOMAIN tinyint AS smallint CHECK (VALUE BETWEEN -128 AND 127)",
      "expect": {
        "tag": "CREATE DOMAIN"
      }
    },
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 varchar(20), col2 int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "new table t"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, '123456789012345', 420)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting data"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE t SET col1 = '1234567890', col2 = 13",
      "expect": {
        "tag": "UPDATE 1"
      }
    },
    {
      "id": "setup-5",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 TYPE varchar(10)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col2 TYPE tinyint",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "narrowing types"
      ],
      "save": "commit3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).col1, (to_row).col2, to_commit IS NOT NULL, (from_row).pk, (from_row).col1, (from_row).col2, from_commit IS NOT NULL, diff_type FROM dolt_diff_table(NULL::t) ORDER BY diff_type ASC",
      "expect": {
        "rows": [
          [
            "1",
            null,
            null,
            "t",
            null,
            null,
            null,
            "t",
            "added"
          ],
          [
            "1",
            "1234567890",
            "13",
            "t",
            "1",
            null,
            null,
            "t",
            "modified"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
