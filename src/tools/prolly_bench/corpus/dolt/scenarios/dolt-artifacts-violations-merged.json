      }
    },
    {
      "id": "assert-13",
      "session": "a",
      "op": "exec",
      "sql": "UPDATE child SET fk = 4",
      "expect": {
        "tag": "UPDATE 2"
      }
    },
    {
      "id": "assert-14",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT length((dolt_commit('-afm', 'update children to new value'))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-15-reset",
      "session": "a",
      "op": "exec",
      "sql": "RESET session_replication_role",
      "expect": {
