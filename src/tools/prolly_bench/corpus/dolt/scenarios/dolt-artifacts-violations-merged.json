      }
    },
    {
      "id": "assert-11",
      "session": "a",
      "op": "commit",
      "args": [
        "commit active merge",
        "-af"
      ],
      "save": "active"
    },
    {
      "id": "assert-12",
      "session": "a",
      "op": "exec",
      "sql": "SET session_replication_role = replica",
