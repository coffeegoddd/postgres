    {
      "id": "h-main",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "main"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "SELECT dolt_merge('right')",
