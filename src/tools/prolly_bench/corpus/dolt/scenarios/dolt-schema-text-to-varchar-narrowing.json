    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_schema_merge.go",
    "case": "SchemaChangeTestsTypeChanges: TEXT to VARCHAR narrowing"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "variants": [
    {
      "name": "forward",
      "vars": {
        "right_side": "right",
        "left_side": "main"
      }
    },
    {
      "name": "flipped",
      "vars": {
        "right_side": "main",
        "left_side": "right"
      }
    }
  ],
  "steps": [
    {
      "id": "anc-0",
      "session": "a",
      "op": "exec",
      "sql": "BEGIN",
      "expect": {
        "tag": "BEGIN"
      }
    },
    {
      "id": "anc-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE t (pk int PRIMARY KEY, col1 text)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "anc-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (1, '123')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "anc-3",
      "session": "a",
      "op": "exec",
      "sql": "CREATE INDEX idx1 ON t (col1)",
      "expect": {
        "tag": "CREATE INDEX"
      }
    },
    {
      "id": "h-ancestor",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "ancestor commit"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-branch",
      "session": "a",
      "op": "query",
      "sql": "SELECT dolt_branch('right')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      },
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-right-side",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "var": "right_side"
        }
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE t ALTER COLUMN col1 TYPE varchar(9)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "right-1",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (2, '12345')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-right-commit",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
        "order": "bag"
      },
      "params": [
        "right commit"
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "h-left-side",
      "session": "a",
      "op": "query",
      "sql": "SELECT (dolt_checkout($1))[1]",
      "expect": {
        "rows": [
          [
            "0"
          ]
        ],
        "order": "bag"
      },
      "params": [
        {
          "var": "left_side"
        }
      ],
      "requires": [
        "vc.core"
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO t VALUES (3, '321')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "h-left-commit",
      "session": "a",
      "op": "query",
      "sql": "SELECT length((dolt_commit('-Am', $1))[1]) = 40",
      "expect": {
        "rows": [
          [
            "t"
          ]
        ],
