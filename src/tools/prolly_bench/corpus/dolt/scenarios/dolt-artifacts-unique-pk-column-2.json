{
  "version": 1,
  "id": "dolt-artifacts-unique-pk-column-2",
  "description": "Reviewed Dolt port: unique key violation should be thrown even if a PK column is used in the unique index 2",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeArtifactsScripts: unique key violation should be thrown even if a PK column is used in the unique index 2"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge",
    "vc.conflicts",
    "vc.violations"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE wxyz (w int, x int, y int, z int, PRIMARY KEY (x, w))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "unique",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE wxyz ADD UNIQUE (z, x)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "base",
      "session": "a",
      "op": "commit",
      "args": [
        "init"
      ],
      "save": "base"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "right"
      ]
    },
    {
      "id": "checkout-right",
      "session": "a",
      "op": "checkout",
      "args": [
        "right"
      ]
    },
    {
      "id": "right-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO wxyz VALUES (1, 2, 3, 4)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "right-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "right"
      ],
      "save": "rightc"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "left-0",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO wxyz VALUES (5, 2, 6, 4)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "left-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "left"
      ],
      "save": "leftc"
    },
    {
      "id": "force",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.conflicts"
      ],
      "sql": "SET dolt.allow_commit_conflicts = on",
      "expect": {
        "tag": "SET"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.merge"
      ],
      "sql": "SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('right') m",
      "expect": {
        "rows": [
          [
            "",
            "0",
            "1",
            "conflicts found"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.violations"
      ],
      "sql": "SELECT violating_row->>'w', violating_row->>'x', violating_row->>'y', violating_row->>'z' FROM dolt_constraint_violations('wxyz')",
      "expect": {
        "rows": [
          [
            "1",
            "2",
            "3",
            "4"
          ],
          [
            "5",
            "2",
            "6",
            "4"
          ]
        ],
        "order": "bag"
      }
    }
  ]
}
