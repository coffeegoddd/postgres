{
  "version": 1,
  "id": "dolt-stash-empty",
  "description": "Reviewed Dolt port: DOLT_STASH() subcommands error on empty space.",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_stash.go",
    "case": "DoltStashTests: DOLT_STASH() subcommands error on empty space."
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.stash"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "init",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "init"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (i int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('pop', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3-table",
      "session": "a",
      "op": "query",
      "sql": "SELECT tablename::text FROM pg_tables WHERE schemaname = 'public' ORDER BY 1",
      "expect": {
        "rows": [
          [
            "test"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-4",
      "session": "a",
      "op": "exec",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('drop', 'myStash')",
      "expect": {
        "sqlstate": "55000"
      }
    },
    {
      "id": "assert-5",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('clear', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
