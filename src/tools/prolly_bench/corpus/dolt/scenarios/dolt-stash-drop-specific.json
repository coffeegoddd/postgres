{
  "version": 1,
  "id": "dolt-stash-drop-specific",
  "description": "Reviewed Dolt port: Can drop specific stash",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_stash.go",
    "case": "DoltStashTests: Can drop specific stash"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.stash"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "setup-0",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test(pk BIGINT PRIMARY KEY, v varchar(10))",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "created",
      "session": "a",
      "op": "commit",
      "args": [
        "Created table",
        "-A"
      ],
      "save": "created"
    },
    {
      "id": "setup-2",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (1, 'a')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "setup-4",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (2, 'b')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "added2",
      "session": "a",
      "op": "commit",
      "args": [
        "Added 2 b",
        "-a"
      ],
      "save": "added2"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (3, 'c')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "setup-7",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "setup-8",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (4, 'd')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "added4",
      "session": "a",
      "op": "commit",
      "args": [
        "Added 4 d",
        "-a"
      ],
      "save": "added4"
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (5, 'c')",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT * FROM dolt_stashes",
      "expect": {
        "rows": [
          [
            "myStash",
            "stash@{0}",
            "main",
            {
              "ref": "added2"
            },
            "Added 2 b"
          ],
          [
            "myStash",
            "stash@{1}",
            "main",
            {
              "ref": "created"
            },
            "Created table"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('push', 'myStash')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT dolt_stash('drop', 'myStash', 'stash@{1}')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.stash"
      ],
      "sql": "SELECT * FROM dolt_stashes",
      "expect": {
        "rows": [
          [
            "myStash",
            "stash@{0}",
            "main",
            {
              "ref": "added4"
            },
            "Added 4 d"
          ],
          [
            "myStash",
            "stash@{1}",
            "main",
            {
              "ref": "created"
            },
            "Created table"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
