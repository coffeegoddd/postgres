{
  "version": 1,
  "id": "dolt-merge-deleted-modified-check",
  "description": "Reviewed Dolt port: resolving a deleted and modified row handles constraint checks",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_merge.go",
    "case": "MergeScripts: resolving a deleted and modified row handles constraint checks"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.merge"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "create",
      "session": "a",
      "op": "exec",
      "sql": "CREATE TABLE test (a int PRIMARY KEY, b int, c int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "check",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE test ADD CHECK (b < 4)",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "seed",
      "session": "a",
      "op": "exec",
      "sql": "INSERT INTO test VALUES (1, 2, 3)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "add1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('test')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "create-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "create test table"
      ],
      "save": "created"
    },
    {
      "id": "branch",
      "session": "a",
      "op": "branch",
      "args": [
        "other"
      ]
    },
    {
      "id": "checkout-other",
      "session": "a",
      "op": "checkout",
      "args": [
        "other"
      ]
    },
    {
      "id": "drop-column",
      "session": "a",
      "op": "exec",
      "sql": "ALTER TABLE test DROP COLUMN c",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "add2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('test')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "other-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "drop column"
      ],
      "save": "other"
    },
    {
      "id": "checkout-main",
      "session": "a",
      "op": "checkout",
      "args": [
        "main"
      ]
    },
    {
      "id": "delete",
      "session": "a",
      "op": "exec",
      "sql": "DELETE FROM test",
      "expect": {
        "tag": "DELETE 1"
      }
    },
    {
      "id": "add3",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.core"
      ],
      "sql": "SELECT dolt_add('test')",
      "expect": {
        "rows": [
          [
            "{0}"
          ]
        ],
        "order": "bag"
      }
    },
    {
      "id": "main-commit",
      "session": "a",
      "op": "commit",
      "args": [
        "remove row"
      ],
      "save": "removed"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "merge",
      "args": [
        "other"
      ],
      "save": "merged"
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "sql": "SELECT * FROM test",
      "expect": {
        "rows": [],
        "order": "bag"
      }
    }
  ]
}
