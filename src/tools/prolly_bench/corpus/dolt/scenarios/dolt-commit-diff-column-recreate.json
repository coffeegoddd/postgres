{
  "version": 1,
  "id": "dolt-commit-diff-column-recreate",
  "description": "Reviewed Dolt port: schema modification: column drop, recreate with same type",
  "source": {
    "repository": "https://github.com/dolthub/dolt",
    "revision": "51cc4458b740ac132cb2302fe5394a2abbfba39d",
    "path": "go/libraries/doltcore/sqle/enginetest/dolt_queries_diff.go",
    "case": "CommitDiffSystemTableScriptTests: schema modification: column drop, recreate with same type"
  },
  "requires": [
    "sql",
    "vc.core",
    "vc.diff"
  ],
  "sessions": [
    "a"
  ],
  "steps": [
    {
      "id": "commit0",
      "session": "a",
      "op": "commit",
      "args": [
        "Initialize data repository",
        "--allow-empty"
      ],
      "save": "commit0"
    },
    {
      "id": "setup-1",
      "session": "a",
      "op": "exec",
      "sql": "create table t (pk int primary key, c int)",
      "expect": {
        "tag": "CREATE TABLE"
      }
    },
    {
      "id": "setup-3",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (1, 2), (3, 4)",
      "expect": {
        "tag": "INSERT 0 2"
      }
    },
    {
      "id": "commit1",
      "session": "a",
      "op": "commit",
      "args": [
        "creating table t",
        "-a"
      ],
      "save": "commit1"
    },
    {
      "id": "setup-6",
      "session": "a",
      "op": "exec",
      "sql": "alter table t drop column c",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "commit2",
      "session": "a",
      "op": "commit",
      "args": [
        "dropping column c",
        "-a"
      ],
      "save": "commit2"
    },
    {
      "id": "setup-9",
      "session": "a",
      "op": "exec",
      "sql": "alter table t add column c int",
      "expect": {
        "tag": "ALTER TABLE"
      }
    },
    {
      "id": "setup-10",
      "session": "a",
      "op": "exec",
      "sql": "insert into t values (100, 101)",
      "expect": {
        "tag": "INSERT 0 1"
      }
    },
    {
      "id": "commit3",
      "session": "a",
      "op": "commit",
      "args": [
        "inserting into t",
        "-a"
      ],
      "save": "commit3"
    },
    {
      "id": "assert-0",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff($1, $2, NULL::t) ORDER BY (to_row).pk",
      "params": [
        {
          "ref": "commit0"
        },
        {
          "ref": "commit1"
        }
      ],
      "expect": {
        "rows": [
          [
            "1",
            "2",
            null,
            null,
            "added"
          ],
          [
            "3",
            "4",
            null,
            null,
            "added"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-1",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (from_row).pk, (from_row).c, diff_type FROM dolt_diff($1, $2, NULL::t) ORDER BY (to_row).pk",
      "params": [
        {
          "ref": "commit1"
        },
        {
          "ref": "commit2"
        }
      ],
      "expect": {
        "rows": [
          [
            "1",
            "1",
            "2",
            "modified"
          ],
          [
            "3",
            "3",
            "4",
            "modified"
          ]
        ],
        "order": "ordered"
      }
    },
    {
      "id": "assert-2",
      "session": "a",
      "op": "query",
      "requires": [
        "vc.diff"
      ],
      "sql": "SELECT (to_row).pk, (to_row).c, (from_row).pk, (from_row).c, diff_type FROM dolt_diff($1, $2, NULL::t) ORDER BY (to_row).pk",
      "params": [
        {
          "ref": "commit2"
        },
        {
          "ref": "commit3"
        }
      ],
      "expect": {
        "rows": [
          [
            "100",
            "101",
            null,
            null,
            "added"
          ]
        ],
        "order": "ordered"
      }
    }
  ]
}
