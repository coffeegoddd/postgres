{
  "version": 1,
  "id": "vc-probe",
  "description": "Native canary for the version-control capabilities beyond vc.core: a merge base, a merge, a diff, a cherry-pick, a revert, a conflict, a constraint violation, the reflog, a garbage collection, a remote and a stash, each checked by its effect",
  "requires": ["sql", "vc.core", "vc.merge", "vc.conflicts", "vc.violations", "vc.cherrypick", "vc.revert", "vc.diff", "vc.mergebase", "vc.gc", "vc.reflog", "vc.remotes", "vc.stash"],
  "sessions": ["a", "b"],
  "steps": [
    {"id":"create","session":"a","op":"exec","sql":"CREATE TABLE probe_t (id int PRIMARY KEY, v text)","expect":{"tag":"CREATE TABLE"}},
    {"id":"parent","session":"a","op":"exec","sql":"CREATE TABLE probe_parent (id int PRIMARY KEY)","expect":{"tag":"CREATE TABLE"}},
    {"id":"child","session":"a","op":"exec","sql":"CREATE TABLE probe_child (id int PRIMARY KEY, pid int REFERENCES probe_parent)","expect":{"tag":"CREATE TABLE"}},
    {"id":"seed","session":"a","op":"exec","sql":"INSERT INTO probe_t VALUES (1, 'base')","expect":{"tag":"INSERT 0 1"}},
    {"id":"seed-parent","session":"a","op":"exec","sql":"INSERT INTO probe_parent VALUES (1)","expect":{"tag":"INSERT 0 1"}},
    {"id":"base","session":"a","op":"commit","args":["base"],"save":"base"},
    {"id":"branch","session":"a","op":"branch","args":["probe_side"]},
    {"id":"side","session":"b","op":"checkout","args":["probe_side"]},
    {"id":"side-edit","session":"b","op":"exec","sql":"INSERT INTO probe_t VALUES (2, 'side')","expect":{"tag":"INSERT 0 1"}},
    {"id":"side-commit","session":"b","op":"commit","args":["side"],"save":"sidec"},
    {"id":"main-edit","session":"a","op":"exec","sql":"INSERT INTO probe_t VALUES (3, 'main')","expect":{"tag":"INSERT 0 1"}},
    {"id":"main-commit","session":"a","op":"commit","args":["main"],"save":"mainc"},
    {"id":"merge-base","session":"a","op":"query","requires":["vc.mergebase"],"sql":"SELECT dolt_merge_base($1, $2) = $3","params":[{"ref":"mainc"},{"ref":"sidec"},{"ref":"base"}],"expect":{"rows":[["t"]],"order":"ordered"}},
    {"id":"merge","session":"a","op":"merge","args":["probe_side"],"save":"merged"},
    {"id":"merged","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, array_agg(id ORDER BY id) FROM probe_t","params":[{"ref":"merged"}],"expect":{"rows":[["t","{1,2,3}"]],"order":"ordered"}},
    {"id":"diff","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT diff_type, (to_row).id FROM dolt_diff($1, $2, NULL::probe_t)","params":[{"ref":"mainc"},{"ref":"merged"}],"expect":{"rows":[["added","2"]],"order":"ordered"}},
    {"id":"diff-summary","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT to_table_name, diff_type, data_change, schema_change FROM dolt_diff_summary($1, $2, 'probe_t')","params":[{"ref":"mainc"},{"ref":"merged"}],"expect":{"rows":[["public.probe_t","modified","t","f"]],"order":"ordered"}},
    {"id":"schema-diff","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT count(*) FROM dolt_schema_diff($1, $2)","params":[{"ref":"base"},{"ref":"merged"}],"expect":{"rows":[["0"]],"order":"ordered"}},
    {"id":"diff-stat","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT rows_added, rows_modified FROM dolt_diff_stat($1, $2, 'probe_t')","params":[{"ref":"mainc"},{"ref":"merged"}],"expect":{"rows":[["1","0"]],"order":"ordered"}},
    {"id":"history","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT (row).v FROM dolt_history_table(NULL::probe_t) WHERE commit_hash = $1","params":[{"ref":"base"}],"expect":{"rows":[["base"]],"order":"ordered"}},
    {"id":"at","session":"a","op":"query","requires":["vc.diff"],"sql":"SELECT count(*) FROM dolt_at($1, NULL::probe_t)","params":[{"ref":"sidec"}],"expect":{"rows":[["2"]],"order":"ordered"}},
    {"id":"pick-edit","session":"b","op":"exec","sql":"INSERT INTO probe_t VALUES (4, 'picked')","expect":{"tag":"INSERT 0 1"}},
    {"id":"pick-commit","session":"b","op":"commit","args":["to pick"],"save":"topick"},
    {"id":"pick","session":"a","op":"cherrypick","args":[{"ref":"topick"}],"save":"picked"},
    {"id":"picked","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, (SELECT v FROM probe_t WHERE id = 4)","params":[{"ref":"picked"}],"expect":{"rows":[["t","picked"]],"order":"ordered"}},
    {"id":"revert","session":"a","op":"revert","args":[{"ref":"picked"}],"save":"reverted"},
    {"id":"reverted","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, (SELECT count(*) FROM probe_t WHERE id = 4)","params":[{"ref":"reverted"}],"expect":{"rows":[["t","0"]],"order":"ordered"}},
    {"id":"conflict-main","session":"a","op":"exec","sql":"UPDATE probe_t SET v = 'main' WHERE id = 1","expect":{"tag":"UPDATE 1"}},
    {"id":"conflict-main-commit","session":"a","op":"commit","args":["main conflict"],"save":"mainx"},
    {"id":"conflict-side","session":"b","op":"exec","sql":"UPDATE probe_t SET v = 'side' WHERE id = 1","expect":{"tag":"UPDATE 1"}},
    {"id":"conflict-side-commit","session":"b","op":"commit","args":["side conflict"],"save":"sidex"},
    {"id":"conflict-begin","session":"a","op":"exec","sql":"BEGIN","expect":{"tag":"BEGIN"}},
    {"id":"conflict-merge","session":"a","op":"query","requires":["vc.merge"],"sql":"SELECT (dolt_merge('probe_side'))[3]","expect":{"rows":[["1"]],"order":"ordered"}},
    {"id":"conflicts","session":"a","op":"query","requires":["vc.conflicts"],"sql":"SELECT (our_row).v, (their_row).v FROM dolt_conflicts(NULL::probe_t)","expect":{"rows":[["main","side"]],"order":"ordered"}},
    {"id":"conflict-rollback","session":"a","op":"exec","sql":"ROLLBACK","expect":{"tag":"ROLLBACK"}},
    {"id":"violation-branch","session":"a","op":"branch","args":["probe_child"]},
    {"id":"violation-side","session":"b","op":"checkout","args":["probe_child"]},
    {"id":"violation-child","session":"b","op":"exec","sql":"INSERT INTO probe_child VALUES (1, 1)","expect":{"tag":"INSERT 0 1"}},
    {"id":"violation-child-commit","session":"b","op":"commit","args":["child"],"save":"childc"},
    {"id":"violation-delete","session":"a","op":"exec","sql":"DELETE FROM probe_parent","expect":{"tag":"DELETE 1"}},
    {"id":"violation-delete-commit","session":"a","op":"commit","args":["no parent"],"save":"noparent"},
    {"id":"violation-begin","session":"a","op":"exec","sql":"BEGIN","expect":{"tag":"BEGIN"}},
    {"id":"violation-merge","session":"a","op":"query","requires":["vc.merge"],"sql":"SELECT (dolt_merge('probe_child'))[3]","expect":{"rows":[["1"]],"order":"ordered"}},
    {"id":"violations","session":"a","op":"query","requires":["vc.violations"],"sql":"SELECT violation_type, violating_row->>'id' FROM dolt_constraint_violations('probe_child')","expect":{"rows":[["foreign key","1"]],"order":"ordered"}},
    {"id":"violation-rollback","session":"a","op":"exec","sql":"ROLLBACK","expect":{"tag":"ROLLBACK"}},
    {"id":"reflog","session":"a","op":"query","requires":["vc.reflog"],"sql":"SELECT commit_hash = $1 FROM dolt_reflog('main') LIMIT 1","params":[{"ref":"noparent"}],"expect":{"rows":[["t"]],"order":"ordered"}},
    {"id":"gc","session":"a","op":"query","requires":["vc.gc"],"sql":"SELECT dolt_gc()","expect":{"rows":[["{0}"]],"order":"ordered"}},
    {"id":"after-gc","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('main') = $1","params":[{"ref":"noparent"}],"expect":{"rows":[["t"]],"order":"ordered"}},
    {"id":"remote-add","session":"a","op":"query","requires":["vc.remotes"],"sql":"SELECT dolt_remote('add', 'probe_origin', 'file:///nonexistent/vc-probe')","expect":{"rows":[["{0}"]],"order":"ordered"}},
    {"id":"remotes","session":"a","op":"query","requires":["vc.remotes"],"sql":"SELECT name, url FROM dolt_remotes","expect":{"rows":[["probe_origin","file:///nonexistent/vc-probe"]],"order":"ordered"}},
    {"id":"remote-remove","session":"a","op":"query","requires":["vc.remotes"],"sql":"SELECT dolt_remote('remove', 'probe_origin')","expect":{"rows":[["{0}"]],"order":"ordered"}},
    {"id":"stash-write","session":"a","op":"exec","sql":"INSERT INTO probe_t VALUES (99, 'stashed')","expect":{"tag":"INSERT 0 1"}},
    {"id":"stash-push","session":"a","op":"query","requires":["vc.stash"],"sql":"SELECT dolt_stash('push', 'probe')","expect":{"rows":[["{0}"]],"order":"ordered"}},
    {"id":"stashed","session":"a","op":"query","requires":["vc.stash"],"sql":"SELECT (SELECT count(*) FROM probe_t WHERE id = 99), (SELECT count(*) FROM dolt_stashes WHERE name = 'probe')","expect":{"rows":[["0","1"]],"order":"ordered"}},
    {"id":"stash-pop","session":"a","op":"query","requires":["vc.stash"],"sql":"SELECT dolt_stash('pop', 'probe')","expect":{"rows":[["{0}"]],"order":"ordered"}},
    {"id":"popped","session":"a","op":"query","requires":["vc.stash"],"sql":"SELECT (SELECT v FROM probe_t WHERE id = 99), (SELECT count(*) FROM dolt_stashes)","expect":{"rows":[["stashed","0"]],"order":"ordered"}}
  ]
}
