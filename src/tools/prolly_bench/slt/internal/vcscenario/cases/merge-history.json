{
  "version": 1,
  "id": "merge-history",
  "description": "Native scenario for the merge, cherry-pick and revert operations: captured commits, conflicts and aborts",
  "requires": ["sql", "vc.core", "vc.merge", "vc.conflicts", "vc.cherrypick", "vc.revert"],
  "sessions": ["a", "b"],
  "steps": [
    {"id":"create","session":"a","op":"exec","sql":"CREATE TABLE merge_target (id int PRIMARY KEY, v text)","expect":{"tag":"CREATE TABLE"}},
    {"id":"seed","session":"a","op":"exec","sql":"INSERT INTO merge_target VALUES (1, 'base'), (2, 'base')","expect":{"tag":"INSERT 0 2"}},
    {"id":"base","session":"a","op":"commit","args":["base"],"save":"base"},
    {"id":"branch","session":"a","op":"branch","args":["feature"]},
    {"id":"checkout","session":"b","op":"checkout","args":["feature"]},
    {"id":"feature-edit","session":"b","op":"exec","sql":"INSERT INTO merge_target VALUES (3, 'feature')","expect":{"tag":"INSERT 0 1"}},
    {"id":"feature","session":"b","op":"commit","args":["feature"],"save":"feature"},
    {"id":"ff","session":"a","op":"merge","args":["feature"],"save":"ff"},
    {"id":"ff-head","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT $1 = $2::text, dolt_hashof('HEAD') = $1","params":[{"ref":"ff"},{"ref":"feature"}],"expect":{"rows":[["t","t"]],"order":"ordered"}},
    {"id":"feature-edit2","session":"b","op":"exec","sql":"UPDATE merge_target SET v = 'feature' WHERE id = 2","expect":{"tag":"UPDATE 1"}},
    {"id":"feature2","session":"b","op":"commit","args":["feature 2"],"save":"feature2"},
    {"id":"main-edit","session":"a","op":"exec","sql":"INSERT INTO merge_target VALUES (4, 'main')","expect":{"tag":"INSERT 0 1"}},
    {"id":"main","session":"a","op":"commit","args":["main"],"save":"main"},
    {"id":"no-ff","session":"a","op":"merge","args":["feature","--no-ff","-m","merge feature"],"save":"merged"},
    {"id":"parents","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, dolt_hashof('HEAD^1') = $2, dolt_hashof('HEAD^2') = $3","params":[{"ref":"merged"},{"ref":"main"},{"ref":"feature2"}],"expect":{"rows":[["t","t","t"]],"order":"ordered"}},
    {"id":"merged-rows","session":"a","op":"query","sql":"SELECT id, v FROM merge_target ORDER BY id","expect":{"rows":[["1","base"],["2","feature"],["3","feature"],["4","main"]],"order":"ordered"}},
    {"id":"revert","session":"a","op":"revert","args":[{"ref":"main"}],"save":"reverted"},
    {"id":"reverted-rows","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, dolt_hashof('HEAD^') = $2, array_agg(id ORDER BY id) FROM merge_target","params":[{"ref":"reverted"},{"ref":"merged"}],"expect":{"rows":[["t","t","{1,2,3}"]],"order":"ordered"}},
    {"id":"feature-edit3","session":"b","op":"exec","sql":"INSERT INTO merge_target VALUES (5, 'picked')","expect":{"tag":"INSERT 0 1"}},
    {"id":"feature3","session":"b","op":"commit","args":["feature 3"],"save":"feature3"},
    {"id":"pick","session":"a","op":"cherrypick","args":[{"ref":"feature3"}],"save":"picked"},
    {"id":"picked","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, dolt_hashof('HEAD^') = $2, (SELECT v FROM merge_target WHERE id = 5)","params":[{"ref":"picked"},{"ref":"reverted"}],"expect":{"rows":[["t","t","picked"]],"order":"ordered"}},
    {"id":"main-conflict","session":"a","op":"exec","sql":"UPDATE merge_target SET v = 'main' WHERE id = 1","expect":{"tag":"UPDATE 1"}},
    {"id":"main2","session":"a","op":"commit","args":["main 2"],"save":"main2"},
    {"id":"feature-conflict","session":"b","op":"exec","sql":"UPDATE merge_target SET v = 'feature' WHERE id = 1","expect":{"tag":"UPDATE 1"}},
    {"id":"feature4","session":"b","op":"commit","args":["feature 4"],"save":"feature4"},
    {"id":"conflicted","session":"a","op":"merge","args":["feature"],"expect":{"sqlstate":"40001","transaction":"I"}},
    {"id":"begin","session":"a","op":"exec","sql":"BEGIN","expect":{"tag":"BEGIN","transaction":"T"}},
    {"id":"merge-in-block","session":"a","op":"query","requires":["vc.merge"],"sql":"SELECT m[1], m[2], m[3], m[4] FROM dolt_merge('feature') m","expect":{"rows":[["","0","1","conflicts found"]],"order":"ordered"}},
    {"id":"conflicts","session":"a","op":"query","requires":["vc.conflicts"],"sql":"SELECT (base_row).v, (our_row).v, (their_row).v FROM dolt_conflicts(NULL::merge_target)","expect":{"rows":[["base","main","feature"]],"order":"ordered"}},
    {"id":"abort","session":"a","op":"query","requires":["vc.merge"],"sql":"SELECT (dolt_merge('--abort'))[4]","expect":{"rows":[["merge aborted"]],"order":"ordered"}},
    {"id":"commit","session":"a","op":"exec","sql":"COMMIT","expect":{"tag":"COMMIT","transaction":"I"}},
    {"id":"aborted","session":"a","op":"query","requires":["vc.core"],"sql":"SELECT dolt_hashof('HEAD') = $1, (SELECT v FROM merge_target WHERE id = 1)","params":[{"ref":"main2"}],"expect":{"rows":[["t","main"]],"order":"ordered"}},
    {"id":"no-abort","session":"a","op":"merge","args":["--abort"],"expect":{"sqlstate":"55000"}}
  ]
}
