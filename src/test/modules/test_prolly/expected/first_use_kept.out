         name          | some 
-----------------------+------
 apply_rows            | f
 bmap_map_pages_copied | t
 first_use_tables_kept | t
(3 rows)

SELECT rows_digest() = :'at_load' AS at_head, NOT EXISTS (SELECT FROM dolt_status) AS clean,
	to_regclass('fk.n') IS NULL AS no_new_table;
 at_head | clean | no_new_table 
---------+-------+--------------
 t       | t     | t
