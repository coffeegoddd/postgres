(1 row)

-- the branch keeps its own pages as of its head: a reset there gives
-- them back
SELECT dolt_checkout('b1');
         dolt_checkout         
-------------------------------
 {0,"Switched to branch 'b1'"}
(1 row)

UPDATE fk.t SET v = 5 WHERE id <= 10;
SELECT pg_stat_force_next_flush();
