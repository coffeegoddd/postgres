-----------------
 Heap Fetches: 0
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

\c :home
DROP DATABASE first_use_kept;
