--
-- Prolly storage: registered implementations, conformance suites, and
-- canonical values.
--
CREATE EXTENSION test_prolly;
\set VERBOSITY terse
-- Every implementation of every interface.
SELECT interface, name, impl_id, format_version
FROM prolly_implementations();
   interface   |     name     | impl_id | format_version 
---------------+--------------+---------+----------------
 chunker       | bytes        |       2 |              1
 chunker       | stub         |       0 |              0
 content_hash  | sha256       |       1 |              1
 content_hash  | stub         |       0 |              0
 content_hash  | test_fnv     |    9001 |              0
 content_hash  | test_broken  |    9002 |              0
 key_encoder   | ordered      |       1 |              1
 key_encoder   | stub         |       0 |              0
 value_encoder | canonical    |       2 |              1
 value_encoder | stub         |       0 |              0
 reclamation   | stub         |       0 |              0
 refs          | copies       |       2 |              1
 refs          | stub         |       0 |              0
 transfer      | chunks       |       1 |              1
 transfer      | stub         |       0 |              0
 diff_merge    | folded       |       3 |              1
 diff_merge    | stub         |       0 |              0
 tree          | cow          |       1 |              1
 tree          | stub         |       0 |              0
 table_keying  | pk_or_prefix |       2 |              1
 table_keying  | stub         |       0 |              0
 canonicalizer | folded       |       2 |              3
 canonicalizer | stub         |       0 |              0
 chunk_store   | journal      |       1 |              1
 chunk_format  | basic        |       1 |              1
 row_applier   | replication  |       1 |              1
 row_applier   | stub         |       0 |              0
 table_file    | basic        |       1 |              1
 table_file    | stub         |       0 |              0
 change_finder | pages        |       1 |              4
 change_finder | stub         |       0 |              0
 remote        | file         |       1 |              1
(32 rows)

