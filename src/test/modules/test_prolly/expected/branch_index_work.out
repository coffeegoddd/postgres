(1 row)

ROLLBACK;
SELECT (SELECT count(*) FROM (SELECT * FROM all_before EXCEPT SELECT * FROM pg_temp.ix()) a) +
	(SELECT count(*) FROM (SELECT * FROM pg_temp.ix() EXCEPT SELECT * FROM all_before) b)
	AS changed_by_rollback;
