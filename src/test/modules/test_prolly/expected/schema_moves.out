(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT dolt_branch('-D', 'feature', 'at_feature');
 dolt_branch 
-------------
 {0}
(1 row)

DROP SCHEMA app CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to table app.t
drop cascades to table app.p
