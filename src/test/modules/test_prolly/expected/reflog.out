-- A branch deleted is still in the reflog.
SELECT dolt_checkout('main') IS NOT NULL AS checked_out;
 checked_out 
-------------
 t
(1 row)

SELECT dolt_branch('-D', 'branch1') IS NOT NULL AS deleted;
 deleted 
---------
 t
(1 row)

SELECT * FROM pg_temp.reflog('branch1');
        ref         | commit_message  
--------------------+-----------------
 refs/heads/branch1 | inserting row 3
 refs/heads/branch1 | inserting row 2
 refs/heads/branch1 | inserting row 1
(3 rows)

-- A head moved back is a change too.
SELECT dolt_reset('--hard', 'HEAD~1') IS NOT NULL AS reset;
 reset 
-------
 t
(1 row)

SELECT * FROM pg_temp.reflog('main');
       ref       |  commit_message   
-----------------+-------------------
 refs/heads/main | creating table t1
 refs/heads/main | inserting row 1
 refs/heads/main | creating table t1
(3 rows)

-- The refs one move changed, by their full names: remote-tracking
-- branches of remotes one of whose names begins the other's too.
\getenv abs_builddir PG_ABS_BUILDDIR
SELECT 'file://' || :'abs_builddir' || '/tmp_check/reflog_remotes/' ||
	txid_current() AS run \gset
SELECT dolt_remote('add', 'o', :'run' || '/o') IS NOT NULL AS added;
 added 
-------
 t
(1 row)

SELECT dolt_remote('add', 'o-a', :'run' || '/o-a') IS NOT NULL AS added;
 added 
-------
 t
(1 row)

BEGIN;
SELECT dolt_push('o', 'main') IS NOT NULL AS pushed;
 pushed 
--------
 t
(1 row)

SELECT dolt_push('o-a', 'main') IS NOT NULL AS pushed;
 pushed 
--------
 t
(1 row)

COMMIT;
SELECT ref FROM dolt_reflog('--all') WHERE ref LIKE 'refs/remotes/%';
          ref          
-----------------------
 refs/remotes/o/main
 refs/remotes/o-a/main
(2 rows)

-- A garbage collection forgets the moves before it.
SELECT dolt_gc() IS NOT NULL AS collected;
 collected 
-----------
 t
(1 row)

\c reflog_db
SELECT count(*) FROM dolt_reflog();
 count 
-------
     0
(1 row)

SELECT dolt_checkout('-b', 'after_gc') IS NOT NULL AS checked_out;
 checked_out 
-------------
 t
(1 row)

INSERT INTO rl.t1 VALUES (4);
SELECT length(dolt_commit('-Am', 'after the collection')::text) > 0 AS committed;
 committed 
-----------
 t
(1 row)

SELECT ref, commit_message FROM dolt_reflog();
          ref          |    commit_message    
-----------------------+----------------------
 refs/heads/after_gc   | after the collection
 refs/remotes/o/main   | creating table t1
 refs/remotes/o-a/main | creating table t1
 refs/heads/main       | creating table t1
 refs/heads/after_gc   | creating table t1
(5 rows)

\c postgres
DROP DATABASE reflog_db;
