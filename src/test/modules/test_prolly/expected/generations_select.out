-- Archived, retired as chosen, then repaired: the history reads again,
-- and the generations check out, through a retire after.
\getenv abs_builddir PG_ABS_BUILDDIR
\set dir :abs_builddir '/tmp_check/generations_select'
SELECT 'file://' || :'dir' || '/' || txid_current() AS url \gset
CREATE DATABASE generations_select_repair;
\c generations_select_repair
CREATE EXTENSION test_prolly;
CREATE SCHEMA gr VERSIONED;
CREATE TABLE gr.t (id int PRIMARY KEY, v text);
CREATE FUNCTION gr_commit(msg text, ago int) RETURNS boolean LANGUAGE sql AS $$
	SELECT length(dolt_commit('-Am', msg, '--date',
		(date_trunc('day', now()) - make_interval(days => ago) +
		 interval '1 hour')::text)::text) > 0
$$;
INSERT INTO gr.t SELECT g, 'v' || g FROM generate_series(1, 2000) g;
SELECT gr_commit('r1', 10) AS committed;
