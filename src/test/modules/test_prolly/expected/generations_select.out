-- Choosing what to retire by the store's estimates of its files' garbage:
-- a sever counts what it leaves garbage against the files holding it, a
-- retire what it leaves unnamed in older generations, and the oldest
-- generation thought at least half garbage is chosen, with those after it
-- as much, within a budget.  A base load's file is read again only once
-- updates have made it half garbage; until then the retires chosen leave
-- it as it is.  A retire frees a severed commit's tree, whatever newer
-- file names it from the commit, and keeps the commit; and a repair after
-- a retire reattaches the history, its generations checking out.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS test_prolly;
RESET client_min_messages;
\set VERBOSITY terse
CREATE DATABASE generations_select_db;
\c generations_select_db
CREATE EXTENSION test_prolly;
CREATE SCHEMA gs VERSIONED;
CREATE TABLE gs.t (id int PRIMARY KEY, v text);
CREATE FUNCTION gs_commit(msg text, day int) RETURNS boolean LANGUAGE sql AS $$
	SELECT length(dolt_commit('-Am', msg, '--date',
		(timestamptz '2020-01-01 00:00+00' + make_interval(days => day))::text)::text) > 0
$$;
CREATE FUNCTION gs_day(day int) RETURNS timestamptz LANGUAGE sql AS $$
	SELECT timestamptz '2020-01-01 00:00+00' + make_interval(days => day)
$$;
INSERT INTO gs.t SELECT g, repeat('v', 40) || g FROM generate_series(1, 4000) g;
SELECT gs_commit('base', 0) AS committed;
 committed 
-----------
 t
(1 row)

SELECT kept >= 0 AS collected FROM test_chunk_gc(false);
 collected 
-----------
 t
(1 row)

SELECT test_chunk_generation() AS base \gset
SELECT garbage AS base_garbage FROM test_chunk_generations() WHERE epoch_lo = :base;
 base_garbage 
--------------
            0
(1 row)

-- Each cycle updates a tenth of the rows, a range of them, commits,
-- collects, severs what came before (the base load first), and retires
-- what is chosen.  The base load's file is chosen only once its estimate
-- reaches half its chunks.
CREATE TABLE gs_cycles (cycle int, base_due boolean, chose_base boolean,
	base_file_same boolean, chose_any boolean);
CREATE TABLE gs_base AS
	SELECT name, epoch_lo FROM test_chunk_generations() WHERE epoch_lo = :base;
CREATE FUNCTION gs_note(i int) RETURNS void LANGUAGE sql AS $$
	INSERT INTO gs_cycles
	SELECT i, coalesce((SELECT garbage * 2 >= chunks FROM test_chunk_generations()
						WHERE epoch_lo = b.epoch_lo), false),
		   coalesce(c.lo <= b.epoch_lo AND c.hi >= b.epoch_lo, false),
		   EXISTS (SELECT FROM test_chunk_generations() g WHERE g.name = b.name),
		   c.lo IS NOT NULL
	FROM test_chunk_retire_choose() c, gs_base b
$$;
SELECT format($$UPDATE gs.t SET v = 'c%s_' || id WHERE id > %s AND id <= %s$$,
			  i, (i - 1) * 400, i * 400),
	   format('SELECT gs_commit(%L, %s)', 'c' || i, i),
	   'SELECT test_chunk_gc(false)',
	   format('SELECT dolt_history_drop(gs_day(%s))', i),
	   format('SELECT gs_note(%s)', i),
	   'SELECT test_chunk_retire(lo, hi) FROM test_chunk_retire_choose() WHERE lo IS NOT NULL'
FROM generate_series(1, 6) i \o /dev/null \gexec
UPDATE gs.t SET v = 'c1_' || id WHERE id > 0 AND id <= 400
SELECT gs_commit('c1', 1)
SELECT test_chunk_gc(false)
SELECT dolt_history_drop(gs_day(1))
SELECT gs_note(1)
SELECT test_chunk_retire(lo, hi) FROM test_chunk_retire_choose() WHERE lo IS NOT NULL
