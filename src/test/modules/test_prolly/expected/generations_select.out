RESET prolly.gc_rewrite_below;
-- A severed commit's tree, named from a newer file (an empty commit's,
-- whose root is its parent's): the retire of the tree's generation frees
-- it, the horizon cutting what the commit names, and keeps both commits.
CREATE SCHEMA gc VERSIONED;
CREATE TABLE gc.t (id int PRIMARY KEY, v text);
INSERT INTO gc.t SELECT g, 'v' || g FROM generate_series(1, 300) g;
SELECT gs_commit('e1', 10) AS committed;
