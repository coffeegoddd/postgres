SELECT gs_commit('c5', 5)
SELECT test_chunk_gc(false)
SELECT dolt_history_drop(gs_day(5))
SELECT gs_note(5)
SELECT test_chunk_retire(lo, hi) FROM test_chunk_retire_choose() WHERE lo IS NOT NULL
UPDATE gs.t SET v = 'c6_' || id WHERE id > 2000 AND id <= 2400
SELECT gs_commit('c6', 6)
SELECT test_chunk_gc(false)
SELECT dolt_history_drop(gs_day(6))
SELECT gs_note(6)
SELECT test_chunk_retire(lo, hi) FROM test_chunk_retire_choose() WHERE lo IS NOT NULL
