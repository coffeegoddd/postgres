-- A file thought half garbage that isn't (rows updated and then put back,
-- so the sever counts what the boundary has again): the retire chosen for
-- it keeps it whole, and its estimate is what the retire found, so it
-- isn't chosen again until more is noted.
SET prolly.gc_rewrite_below = 0;
CREATE SCHEMA gb VERSIONED;
CREATE TABLE gb.t (id int PRIMARY KEY, v text);
INSERT INTO gb.t SELECT g, repeat('w', 40) || g FROM generate_series(1, 4000) g;
