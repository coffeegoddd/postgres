-- a commit rolled back to a savepoint keeps nothing (its snapshots let go
-- of); the pages are still kept as of the head
UPDATE kp.t SET v = 10 WHERE id <= 10;
BEGIN;
SAVEPOINT s;
SELECT dolt_commit('-am', 'undone') IS NOT NULL AS committed;
 committed 
-----------
 t
(1 row)

ROLLBACK TO s;
COMMIT;
SELECT dolt_reset('--hard');
 dolt_reset 
------------
 {0}
(1 row)

SELECT kept('kp.t') <= 3 AS few_kept;
 few_kept 
----------
 t
(1 row)

SELECT rows_digest() = :'at_load' AS as_loaded, clean();
 as_loaded | clean 
-----------+-------
 t         | t
(1 row)

-- however many commits, each relation keeps no more snapshots than kept
-- commits (and one a reset's new storage took)
DO $$
BEGIN
	FOR i IN 1..6 LOOP
		UPDATE kp.t SET v = i WHERE id = 2;
		PERFORM dolt_commit('-am', 'step ' || i);
	END LOOP;
END $$;
SELECT kept('kp.t') AS t, kept('kp.t_v') AS t_v;
 t | t_v 
---+-----
 2 |   2
(1 row)

