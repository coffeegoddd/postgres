 harness | u64_keys_sort_as_bytes       | ok
(5 rows)

-- running them again gives the same results: no test depends on running
-- once per session
SELECT count(*) AS failures FROM test_prolly_unit_tests() WHERE result <> 'ok';
 failures 
----------
        0
(1 row)

SELECT * FROM test_prolly_unit_tests('no_such_suite');
ERROR:  unit test suite "no_such_suite" does not exist
-- the engine's long operations check for interrupts: a build of many rows,
-- cancelled as it begins, cut short (not run to its end)
SELECT test_engine_build(1000, false), test_engine_build_finished();
 test_engine_build | test_engine_build_finished 
-------------------+----------------------------
              1000 | t
(1 row)

SELECT test_engine_build(100000, true);
ERROR:  canceling statement due to user request
SELECT test_engine_build_finished();
 test_engine_build_finished 
----------------------------
 f
(1 row)

-- (the engine suites' archives on the history store, its tier, rolled back
-- with each test, leave the tier's entries dead: vacuumed here, so that
-- autovacuum does not take them up in a later test that counts on what it
-- has not vacuumed yet)
VACUUM pg_history.tier_index;
VACUUM pg_history.tier_chunks;
