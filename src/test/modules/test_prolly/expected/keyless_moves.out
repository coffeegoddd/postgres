-- Moving a table without a primary key (a reset, a branch made from one
-- with changes) finds the rows it removes or changes by their values: the
-- table is scanned for them all at once, not once for each.  Rows alike
-- (duplicates) are told apart, and a row the index misses is still found.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS test_prolly;
RESET client_min_messages;
CREATE SCHEMA km VERSIONED;
CREATE TABLE km.t (a int, b text, c numeric);
INSERT INTO km.t SELECT g % 50, 'row ' || (g % 50), g % 7 FROM generate_series(1, 500) g;
SELECT length(dolt_commit('-Am', 'base')::text) AS committed;
 committed 
-----------
        42
(1 row)

-- 300 rows added, 200 removed (duplicates among them), 100 changed
INSERT INTO km.t SELECT g, 'new ' || g, 1.5 FROM generate_series(1, 300) g;
DELETE FROM km.t WHERE ctid IN (SELECT ctid FROM km.t WHERE a < 20 LIMIT 200);
UPDATE km.t SET b = b || '!' WHERE a BETWEEN 30 AND 39;
-- (a few scans, the first lookups' and the index's; not one a row, 600)
BEGIN;
SELECT dolt_reset('--hard');
 dolt_reset 
------------
 {0}
(1 row)

SELECT seq_scan < 40 AS scanned_once FROM pg_stat_xact_user_tables
  WHERE relid = 'km.t'::regclass;
 scanned_once 
--------------
 t
(1 row)

COMMIT;
SELECT test_fold_root() = prolly_root_hash('HEAD') AS at_head;
 at_head 
---------
 t
(1 row)

SELECT count(*), count(DISTINCT (a, b, c)) FROM km.t;
 count | count 
-------+-------
   500 |   350
(1 row)

-- A branch made while main has such changes starts at the head too.
INSERT INTO km.t SELECT g, 'more', 2 FROM generate_series(1, 400) g;
SELECT dolt_branch('kb');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_checkout('kb') IS NOT NULL AS on_kb;
 on_kb 
-------
 t
(1 row)

SELECT test_fold_root() = prolly_root_hash('HEAD') AS at_head;
 at_head 
---------
 t
(1 row)

SELECT count(*) FROM km.t;
 count 
-------
   500
(1 row)

SELECT dolt_checkout('main') IS NOT NULL AS on_main;
 on_main 
---------
 t
(1 row)

SELECT count(*) FROM km.t;
 count 
-------
   900
(1 row)

-- A branch made while a keyed table has changes is folded from its head:
-- its folds read no page the move to the head wrote.
CREATE TABLE km.k (id int PRIMARY KEY, v text);
INSERT INTO km.k SELECT g, 'v' || g FROM generate_series(1, 2000) g;
SELECT length(dolt_commit('-Am', 'keyed')::text) AS committed;
 committed 
-----------
        42
(1 row)

UPDATE km.k SET v = 'changed' WHERE id % 100 = 0;
SELECT dolt_branch('kk');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_checkout('kk') IS NOT NULL AS on_kk;
 on_kk 
-------
 t
(1 row)

SELECT count(*) AS reset FROM test_fold_counters(true);
 reset 
-------
     1
(1 row)

SELECT test_fold_root() = prolly_root_hash('HEAD') AS at_head;
 at_head 
---------
 t
(1 row)

SELECT pages AS pages_read, candidates, full_tables FROM test_fold_counters(true);
 pages_read | candidates | full_tables 
------------+------------+-------------
          0 |          0 |           0
(1 row)

SELECT dolt_checkout('main') IS NOT NULL AS on_main;
 on_main 
---------
 t
(1 row)

SELECT dolt_branch('-D', 'kk');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_reset('--hard');
 dolt_reset 
------------
 {0}
(1 row)

-- a primary key given a keyless table, reset away: the key goes before
-- the NOT NULL it holds its column to
CREATE TABLE km.given (id int, v text);
INSERT INTO km.given VALUES (1, 'a'), (2, 'b');
SELECT length(dolt_commit('-Am', 'given')::text) AS committed;
 committed 
-----------
        42
(1 row)

ALTER TABLE km.given ADD PRIMARY KEY (id);
SELECT dolt_reset('--hard') IS NOT NULL AS reset;
 reset 
-------
 t
(1 row)

SELECT conname, contype FROM pg_constraint
WHERE conrelid = 'km.given'::regclass ORDER BY 1;
 conname | contype 
---------+---------
(0 rows)

SELECT attnotnull FROM pg_attribute
WHERE attrelid = 'km.given'::regclass AND attname = 'id';
 attnotnull 
------------
 f
(1 row)

SELECT * FROM km.given ORDER BY id;
 id | v 
----+---
  1 | a
  2 | b
(2 rows)

-- and taken from a keyed one, reset back
ALTER TABLE km.k DROP CONSTRAINT k_pkey;
ALTER TABLE km.k ALTER COLUMN id DROP NOT NULL;
SELECT dolt_reset('--hard') IS NOT NULL AS reset;
 reset 
-------
 t
(1 row)

SELECT conname, contype FROM pg_constraint
WHERE conrelid = 'km.k'::regclass ORDER BY 1;
    conname    | contype 
---------------+---------
 k_id_not_null | n
 k_pkey        | p
(2 rows)

SELECT count(*) FROM km.k;
 count 
-------
  2000
(1 row)

SELECT dolt_branch('-D', 'kb');
 dolt_branch 
-------------
 {0}
(1 row)

DROP SCHEMA km CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to table km.t
drop cascades to table km.k
drop cascades to table km.given
