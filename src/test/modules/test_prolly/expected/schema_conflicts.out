SELECT table_name, our_schema, description FROM dolt_schema_conflicts
WHERE table_name LIKE '%other';
 table_name | our_schema |                      description                       
------------+------------+--------------------------------------------------------
 sc.other   | <deleted>  | cannot merge a table deletion with schema modification
