SELECT dolt_checkout('drop_left') IS NOT NULL AS on_left;
 on_left 
---------
 t
(1 row)

SELECT dolt_cherry_pick('drop_right');
ERROR:  schema conflict: sc.other was changed differently on both sides
DETAIL:  Both branches made, dropped or redefined it since their common ancestor.
SELECT dolt_checkout('main') IS NOT NULL AS on_main;
 on_main 
