	SELECT count(*) AS entries,
		count(*) FILTER (WHERE substr(sha256(test_cs_get('tier', t.hash)), 1, 20) = t.hash
			AND length(test_cs_get('tier', t.hash)) = t.len) AS each_one_chunk,
