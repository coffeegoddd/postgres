(1 row)

SELECT count(*) AS joined FROM dolt_log l JOIN dolt_log m
	ON l IS NOT NULL AND l.commit_hash = m.commit_hash;
 joined 
--------
    200
(1 row)

-- the scan is dolt_log's: one who can't execute it can't read it
CREATE ROLE regress_log_stream_nobody;
REVOKE EXECUTE ON FUNCTION dolt_log(text) FROM PUBLIC;
SET ROLE regress_log_stream_nobody;
SELECT message FROM dolt_log LIMIT 1;
ERROR:  permission denied for function dolt_log
SELECT count(l) FROM dolt_log l;
ERROR:  permission denied for function dolt_log
RESET ROLE;
GRANT EXECUTE ON FUNCTION dolt_log(text) TO PUBLIC;
DROP ROLE regress_log_stream_nobody;
-- a limited log reads about as many commits as it gives
:flush
SELECT commits_read() AS before \gset
SELECT count(*) AS given FROM (SELECT * FROM dolt_log LIMIT 10) l;
 given 
-------
    10
(1 row)

:flush
SELECT commits_read() - :before <= 12 AS read_about_ten;
 read_about_ten 
----------------
 t
(1 row)

SELECT commits_read() AS before \gset
SELECT count(*) AS given FROM dolt_log;
 given 
-------
   200
(1 row)

:flush
SELECT commits_read() - :before >= 200 AS whole_reads_all;
 whole_reads_all 
-----------------
 t
(1 row)

-- Branches merged, their commits made at one moment (the same date: the
-- order goes to the hash), and the log's order through them.
SELECT dolt_branch('a');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_branch('b');
 dolt_branch 
-------------
