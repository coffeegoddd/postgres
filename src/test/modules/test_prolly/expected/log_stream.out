    0
(1 row)

\c :home
DROP DATABASE regress_log_stream;
-- The history horizon: the log stops there, in order still.
CREATE DATABASE regress_log_stream_horizon;
\c regress_log_stream_horizon
CREATE FUNCTION log_in_order(ref text) RETURNS bool LANGUAGE sql AS $$
	SELECT (SELECT array_agg(commit_hash) FROM dolt_log(ref)) =
		(SELECT array_agg(commit_hash ORDER BY commit_order DESC, date DESC, commit_hash COLLATE "C")
		 FROM dolt_log(ref))
$$;
CREATE SCHEMA hz VERSIONED;
CREATE TABLE hz.t (id int PRIMARY KEY, v text);
CREATE FUNCTION hz_commits(n int) RETURNS int LANGUAGE plpgsql AS $$
BEGIN
	FOR d IN 1..n LOOP
		INSERT INTO hz.t VALUES (d, 'c' || d);
		PERFORM dolt_commit('-Am', 'c' || d, '--date',
			(timestamptz '2020-01-01 00:00+00' + make_interval(days => d))::text);
	END LOOP;
	RETURN n;
END $$;
SELECT hz_commits(6) AS commits;
 commits 
---------
       6
(1 row)

SELECT count(*) > 0 AS severed FROM dolt_history_drop('2020-01-04 00:00+00');
