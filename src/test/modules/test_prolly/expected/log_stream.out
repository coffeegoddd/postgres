SELECT log_in_order('HEAD') AS in_order, log_in_order('b') AS b_in_order,
	log_in_order('HEAD~2') AS ancestor_in_order;
 in_order | b_in_order | ancestor_in_order 
----------+------------+-------------------
 t        | t          | t
