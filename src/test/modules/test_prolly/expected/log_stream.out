-- dolt_log gives each commit as it is found: a heap of the commits found,
-- the greatest given next (highest height, then newest, then by hash),
-- each read with its parents as it is given.  So dolt_log ... LIMIT n
-- reads about n commits, not the whole history, and the order is the
-- log's: by height, then date, then hash, through merges and commits made
-- at the same moment.  A listing stops at the history horizon.
SELECT current_database() AS home \gset
\set VERBOSITY terse
CREATE DATABASE regress_log_stream;
\c regress_log_stream
-- (the commits a statement reads, its counts flushed)
CREATE FUNCTION commits_read() RETURNS bigint LANGUAGE sql AS $$
	SELECT coalesce((SELECT value FROM pg_stat_prolly WHERE name = 'commits_read'), 0)
$$;
\set flush 'SELECT pg_stat_force_next_flush() IS NULL AS flushed \\gset'
-- (the log in the order it gives, and in the order it must give)
CREATE FUNCTION log_in_order(ref text) RETURNS bool LANGUAGE sql AS $$
	SELECT (SELECT array_agg(commit_hash) FROM dolt_log(ref)) =
		(SELECT array_agg(commit_hash ORDER BY commit_order DESC, date DESC, commit_hash COLLATE "C")
		 FROM dolt_log(ref))
$$;
CREATE SCHEMA ls VERSIONED;
CREATE TABLE ls.t (id int PRIMARY KEY, v int);
INSERT INTO ls.t VALUES (1, 0);
CREATE FUNCTION mk(n int, at text, k int DEFAULT 1) RETURNS int LANGUAGE plpgsql AS $$
BEGIN
	FOR i IN 1..n LOOP
		UPDATE ls.t SET v = v + 1 WHERE id = k;
		IF at IS NULL THEN
			PERFORM dolt_commit('-Am', 'c' || i);
		ELSE
			PERFORM dolt_commit('-Am', 'c' || i, '--date', at);
		END IF;
	END LOOP;
	RETURN n;
END $$;
SELECT mk(200, NULL) AS commits;
 commits 
---------
     200
(1 row)

-- the plan: a scan of its own, which a LIMIT stops
EXPLAIN (COSTS OFF) SELECT * FROM dolt_log LIMIT 10;
         QUERY PLAN          
-----------------------------
 Limit
   ->  Custom Scan (LogScan)
(2 rows)

-- (in the log's order: ORDER BY commit_order DESC, date DESC sorts nothing)
EXPLAIN (COSTS OFF) SELECT * FROM dolt_log ORDER BY commit_order DESC LIMIT 1;
         QUERY PLAN          
-----------------------------
 Limit
   ->  Custom Scan (LogScan)
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM dolt_log ORDER BY commit_order DESC, date DESC LIMIT 1;
         QUERY PLAN          
-----------------------------
 Limit
   ->  Custom Scan (LogScan)
(2 rows)

-- the entry's row whole, made of the scan's columns
EXPLAIN (COSTS OFF) SELECT count(l) FROM dolt_log l;
         QUERY PLAN          
-----------------------------
 Aggregate
   ->  Custom Scan (LogScan)
(2 rows)

SELECT count(l) AS whole_rows FROM dolt_log l;
