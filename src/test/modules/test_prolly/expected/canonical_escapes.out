 bl_pkey" ON esc."t                                              +
 bl" USING btree (id)
 index CREATE UNIQUE INDEX base_pkey ON esc.base USING btree (id)
 row (1,"a       label","line one                                +
 line two\\","(2,""z     z"")")
 rule CREATE RULE "r     ule" AS                                 +
     ON INSERT TO esc.base                                       +
    WHERE (new.id < 0) DO INSTEAD NOTHING;
