-- The conformance suites, run against every registered implementation of
-- each interface.  The example interface test_checksum has one correct
-- implementation, which passes, and one that ignores its input's last
-- byte, which the suite must catch.
CREATE EXTENSION IF NOT EXISTS test_prolly;
NOTICE:  extension "test_prolly" already exists, skipping
-- (the checksums themselves, which a failure shows, depend on the
-- platform's byte order, so they are left out)
SELECT iface, implementation, test, result,
       regexp_replace(detail, ' \([0-9]+ vs [0-9]+\)$', '') AS detail
FROM test_prolly_conformance();
     iface     | implementation  |            test            | result |                                          detail                                          
---------------+-----------------+----------------------------+--------+------------------------------------------------------------------------------------------
 test_checksum | hash_bytes      | registered                 | ok     | 
 test_checksum | hash_bytes      | deterministic              | ok     | 
 test_checksum | hash_bytes      | detects_changed_byte       | ok     | 
 test_checksum | hash_bytes      | detects_changed_length     | ok     | 
 test_checksum | drops_last_byte | registered                 | ok     | 
 test_checksum | drops_last_byte | deterministic              | ok     | 
 test_checksum | drops_last_byte | detects_changed_byte       | failed | CHECK failed: routine(impl)->checksum(buf, sizeof(buf)) != before
 test_checksum | drops_last_byte | detects_changed_length     | failed | CHECK failed: routine(impl)->checksum(buf, len) != routine(impl)->checksum(buf, len - 1)
 branch_ids    | sequence        | registered                 | ok     | 
 branch_ids    | sequence        | allocates_increasing       | ok     | 
 branch_ids    | sequence        | knows_what_it_allocated    | ok     | 
 branch_ids    | sequence        | rollback_keeps_identifiers | ok     | 
 branch_map    | cached          | registered                 | ok     | 
 branch_map    | cached          | shared_and_missing_objects | ok     | 
 branch_map    | cached          | versioned_objects          | ok     | 
 branch_map    | cached          | reset_forgets              | ok     | 
 branch_map    | cached          | forgets_dropped_objects    | ok     | 
(17 rows)

-- a failure says where its check is
SELECT location ~ '^test_checksum\.c:[0-9]+$' AS has_location
FROM test_prolly_conformance('test_checksum')
WHERE result = 'failed';
 has_location 
--------------
 t
 t
(2 rows)

SELECT * FROM test_prolly_conformance('no_such_interface');
ERROR:  no conformance suite for interface "no_such_interface"
