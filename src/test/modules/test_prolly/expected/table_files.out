(1 row)

-- Not in a read-only transaction.
BEGIN READ ONLY;
SELECT test_chunk_table_file(ARRAY['tf four'::bytea]);
ERROR:  cannot execute writing a chunk store's table files in a read-only transaction
ROLLBACK;
