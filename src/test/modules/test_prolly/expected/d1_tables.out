--
-- Tables stored by engine D1: rows are tree items, written privately by
-- each transaction and published at commit.
--
\set VERBOSITY terse
SET default_table_access_method = prolly_d1;
-- Fetching rows by TID (index scans) comes later.
SET enable_indexscan = off;
SET enable_bitmapscan = off;
SET enable_indexonlyscan = off;
-- A table without a primary key is keyed by content: identical rows are
-- one item with a count, but each row has its own TID.
CREATE TABLE d1_keyless (a int, b text);
INSERT INTO d1_keyless VALUES (1, 'x'), (2, 'y'), (1, 'x'), (NULL, NULL);
SELECT a, b, count(*), count(DISTINCT ctid) AS tids
FROM d1_keyless GROUP BY a, b ORDER BY a NULLS LAST;
 a | b | count | tids 
---+---+-------+------
 1 | x |     2 |    2
 2 | y |     1 |    1
   |   |     1 |    1
(3 rows)

-- Rows inserted in one command don't see each other, and the statement
-- doesn't see its own rows (Halloween protection).
INSERT INTO d1_keyless SELECT * FROM d1_keyless;
SELECT count(*), count(DISTINCT ctid) FROM d1_keyless;
 count | count 
-------+-------
     8 |     8
(1 row)

-- A table with a primary key, filled in bulk and in one transaction.
CREATE TABLE d1_pk (id int PRIMARY KEY, v text);
INSERT INTO d1_pk SELECT g, 'v' || g FROM generate_series(1, 5000) g;
SELECT count(*), sum(id), min(v), max(v) FROM d1_pk;
 count |   sum    | min | max  
-------+----------+-----+------
  5000 | 12502500 | v1  | v999
(1 row)

-- Savepoints: a rolled-back subtransaction's rows disappear, and earlier
-- ones stay.
BEGIN;
INSERT INTO d1_pk VALUES (10001, 'kept');
SAVEPOINT s1;
INSERT INTO d1_pk SELECT g, 'gone' FROM generate_series(20001, 21000) g;
SAVEPOINT s2;
INSERT INTO d1_pk VALUES (30001, 'gone too');
ROLLBACK TO s1;
INSERT INTO d1_pk VALUES (10002, 'kept too');
SELECT id, v FROM d1_pk WHERE id > 5000 ORDER BY id;
  id   |    v     
-------+----------
 10001 | kept
 10002 | kept too
(2 rows)

COMMIT;
SELECT id, v FROM d1_pk WHERE id > 5000 ORDER BY id;
  id   |    v     
-------+----------
 10001 | kept
 10002 | kept too
(2 rows)

-- A rolled-back transaction leaves nothing behind.
BEGIN;
INSERT INTO d1_pk VALUES (40001, 'never');
ROLLBACK;
SELECT count(*) FROM d1_pk WHERE id = 40001;
 count 
-------
     0
(1 row)

-- New storage is a new tree: TRUNCATE rolls back, and a rewrite keeps
-- the rows.
BEGIN;
TRUNCATE d1_keyless;
SELECT count(*) FROM d1_keyless;
 count 
-------
     0
(1 row)

ROLLBACK;
SELECT count(*) FROM d1_keyless;
 count 
-------
     8
(1 row)

BEGIN;
TRUNCATE d1_keyless;
INSERT INTO d1_keyless VALUES (7, 'after truncate');
COMMIT;
SELECT * FROM d1_keyless;
 a |       b        
---+----------------
 7 | after truncate
(1 row)

-- A rewrite goes through a table without a key, so the tree comes back
-- keyed by content and is rebuilt, keyed by the primary key again, at the
-- next write.  (Reading it as primary-keyed once failed with "invalid
-- canonical prolly value".)
ALTER TABLE d1_pk ALTER COLUMN v TYPE varchar(20);
SELECT count(*), sum(id), max(v) FROM d1_pk;
 count |   sum    | max  
-------+----------+------
  5002 | 12522503 | v999
(1 row)

INSERT INTO d1_pk VALUES (6000, 'after rewrite');
SELECT count(*), sum(id) FROM d1_pk;
 count |   sum    
-------+----------
  5003 | 12528503
(1 row)

-- Adding and dropping a primary key re-keys the tree.
CREATE TABLE d1_rekey (id int, v text);
INSERT INTO d1_rekey SELECT g % 100, 'r' || g FROM generate_series(1, 300) g;
INSERT INTO d1_rekey VALUES (1, 'twin'), (1, 'twin');
ALTER TABLE d1_rekey ADD PRIMARY KEY (id, v);
ERROR:  could not create unique index "d1_rekey_pkey"
DROP TABLE d1_rekey;
CREATE TABLE d1_rekey (id int, v text);
INSERT INTO d1_rekey SELECT g, 'r' || g FROM generate_series(1, 300) g;
ALTER TABLE d1_rekey ADD PRIMARY KEY (id);
INSERT INTO d1_rekey VALUES (301, 'r301');
SELECT count(*), count(DISTINCT ctid), sum(id) FROM d1_rekey;
 count | count |  sum  
-------+-------+-------
   301 |   301 | 45451
(1 row)

ALTER TABLE d1_rekey DROP CONSTRAINT d1_rekey_pkey;
INSERT INTO d1_rekey VALUES (5, 'r5'), (5, 'r5');
SELECT count(*), count(DISTINCT ctid) FROM d1_rekey WHERE id = 5;
 count | count 
-------+-------
     3 |     3
(1 row)

SELECT count(*), sum(id) FROM d1_rekey;
 count |  sum  
-------+-------
   303 | 45461
(1 row)

-- A rebuild inside a rolled-back savepoint leaves the transaction's
-- earlier writes alone.
CREATE TABLE d1_sp (id int, v text);
INSERT INTO d1_sp SELECT g, 's' || g FROM generate_series(1, 100) g;
BEGIN;
INSERT INTO d1_sp VALUES (1000, 'before');
ALTER TABLE d1_sp ADD PRIMARY KEY (id);
SAVEPOINT s;
INSERT INTO d1_sp VALUES (1001, 'in savepoint');
ROLLBACK TO s;
SELECT count(*), sum(id) FROM d1_sp;
 count | sum  
-------+------
   101 | 6050
(1 row)

INSERT INTO d1_sp VALUES (1002, 'after');
COMMIT;
SELECT count(*), sum(id) FROM d1_sp;
 count | sum  
-------+------
   102 | 7052
(1 row)

INSERT INTO d1_sp VALUES (1003, 'next');
SELECT count(*), sum(id) FROM d1_sp;
 count | sum  
-------+------
   103 | 8055
(1 row)

-- Columns dropped without a rewrite: rows written before still read (once
-- failed with "invalid canonical prolly value"), the next write rebuilds
-- the tree without the dropped values, and rows keep their TIDs.  Columns
-- added later read as their default.
CREATE TABLE d1_cols (id int, gone text, c int);
INSERT INTO d1_cols SELECT g, 'gone' || g, g % 3 FROM generate_series(1, 6) g;
CREATE TEMP TABLE d1_tids USING heap AS SELECT id, ctid AS tid FROM d1_cols;
ALTER TABLE d1_cols DROP COLUMN gone;
SELECT * FROM d1_cols ORDER BY id;
 id | c 
----+---
  1 | 1
  2 | 2
  3 | 0
  4 | 1
  5 | 2
  6 | 0
(6 rows)

ALTER TABLE d1_cols ADD COLUMN d int DEFAULT 5;
SELECT * FROM d1_cols ORDER BY id;
 id | c | d 
----+---+---
  1 | 1 | 5
  2 | 2 | 5
  3 | 0 | 5
  4 | 1 | 5
  5 | 2 | 5
  6 | 0 | 5
(6 rows)

INSERT INTO d1_cols VALUES (7, 1, 7);
SELECT * FROM d1_cols ORDER BY id;
 id | c | d 
----+---+---
  1 | 1 | 5
  2 | 2 | 5
  3 | 0 | 5
  4 | 1 | 5
  5 | 2 | 5
  6 | 0 | 5
  7 | 1 | 7
(7 rows)

SELECT count(*) AS same_tid FROM d1_cols c JOIN d1_tids t ON t.id = c.id
WHERE c.ctid = t.tid;
 same_tid 
----------
        6
(1 row)

-- Dropping the column that told rows apart makes them identical.
CREATE TABLE d1_twins (id int, tag text);
INSERT INTO d1_twins VALUES (1, 'a'), (1, 'b'), (2, 'c');
CREATE TEMP TABLE d1_twin_tids USING heap AS SELECT ctid AS tid FROM d1_twins;
ALTER TABLE d1_twins DROP COLUMN tag;
INSERT INTO d1_twins VALUES (3);
SELECT id, count(*), count(DISTINCT ctid) FROM d1_twins GROUP BY id ORDER BY id;
 id | count | count 
----+-------+-------
  1 |     2 |     2
  2 |     1 |     1
  3 |     1 |     1
(3 rows)

SELECT count(*) AS same_tid FROM d1_twins WHERE ctid IN (SELECT tid FROM d1_twin_tids);
 same_tid 
----------
        3
(1 row)

DROP TABLE d1_cols, d1_twins;
-- Dropping the primary key's column: the old rows were keyed by a column
-- the relation no longer describes, and are still read and rebuilt.
CREATE TABLE d1_dropkey (id int PRIMARY KEY, v text);
INSERT INTO d1_dropkey VALUES (1, 'kept'), (2, 'also kept');
ALTER TABLE d1_dropkey DROP COLUMN id CASCADE;
SELECT * FROM d1_dropkey ORDER BY v;
     v     
-----------
 also kept
 kept
(2 rows)

INSERT INTO d1_dropkey VALUES ('next');
SELECT * FROM d1_dropkey ORDER BY v;
     v     
-----------
 also kept
 kept
 next
(3 rows)

-- Even when the key's type is gone too.
CREATE TYPE d1_mood AS ENUM ('sad', 'happy');
CREATE TABLE d1_dropkeytype (m d1_mood PRIMARY KEY, v text);
INSERT INTO d1_dropkeytype VALUES ('sad', 'one'), ('happy', 'two');
DROP TYPE d1_mood CASCADE;
NOTICE:  drop cascades to column m of table d1_dropkeytype
SELECT * FROM d1_dropkeytype ORDER BY v;
  v  
-----
 one
 two
(2 rows)

INSERT INTO d1_dropkeytype VALUES ('three');
SELECT * FROM d1_dropkeytype ORDER BY v;
   v   
-------
 one
 three
 two
(3 rows)

DROP TABLE d1_dropkey, d1_dropkeytype;
-- The key's type dropped while the transaction has rows of its own in
-- the table: reads merge them with the committed rows, writes rebuild,
-- and a commit with nothing written since stores them.
CREATE TYPE d1_mood2 AS ENUM ('sad', 'happy', 'meh');
CREATE TABLE d1_droptype_active (m d1_mood2 PRIMARY KEY, v text);
INSERT INTO d1_droptype_active VALUES ('sad', 'old'), ('meh', 'older');
BEGIN;
INSERT INTO d1_droptype_active VALUES ('happy', 'new');
DROP TYPE d1_mood2 CASCADE;
NOTICE:  drop cascades to column m of table d1_droptype_active
SAVEPOINT after_drop;
SELECT * FROM d1_droptype_active ORDER BY v;
   v   
-------
 new
 old
 older
(3 rows)

ROLLBACK TO after_drop;
INSERT INTO d1_droptype_active VALUES ('third');
SELECT * FROM d1_droptype_active ORDER BY v;
   v   
-------
 new
 old
 older
 third
(4 rows)

ROLLBACK;
SELECT * FROM d1_droptype_active ORDER BY v;
  m  |   v   
-----+-------
 sad | old
 meh | older
(2 rows)

CREATE TYPE d1_mood3 AS ENUM ('sad', 'happy', 'meh');
CREATE TABLE d1_droptype_commit (m d1_mood3 PRIMARY KEY, v text);
INSERT INTO d1_droptype_commit VALUES ('sad', 'old'), ('meh', 'older');
BEGIN;
INSERT INTO d1_droptype_commit VALUES ('happy', 'new');
DROP TYPE d1_mood3 CASCADE;
NOTICE:  drop cascades to column m of table d1_droptype_commit
COMMIT;
SELECT * FROM d1_droptype_commit ORDER BY v;
   v   
-------
 new
 old
 older
(3 rows)

INSERT INTO d1_droptype_commit VALUES ('fourth');
SELECT * FROM d1_droptype_commit ORDER BY v;
   v    
--------
 fourth
 new
 old
 older
(4 rows)

DROP TABLE d1_droptype_active, d1_droptype_commit;
-- A row inserted again after its insert rolled back: indexes hold one
-- entry for it, and a retried batch isn't refused as a duplicate.
CREATE TABLE d1_retry (id int PRIMARY KEY, a int, t text);
CREATE INDEX d1_retry_a ON d1_retry (a);
BEGIN;
INSERT INTO d1_retry VALUES (1, 10, 'x');
ROLLBACK;
INSERT INTO d1_retry VALUES (1, 10, 'x');
INSERT INTO d1_retry VALUES (2, 20, 'y'), (2, 20, 'dup');
ERROR:  duplicate key value violates unique constraint "d1_retry_pkey"
INSERT INTO d1_retry VALUES (2, 20, 'y'), (3, 30, 'z');
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT id, a, t FROM d1_retry WHERE a = 10;
 id | a  | t 
----+----+---
  1 | 10 | x
(1 row)

SELECT id, a, t FROM d1_retry WHERE id = 2;
 id | a  | t 
----+----+---
  2 | 20 | y
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) FROM d1_retry;
 count 
-------
     3
(1 row)

DROP TABLE d1_retry;
-- A rewrite goes through a table without a primary key; the statement
-- whose first write rebuilds the tree under the key is still scanning the
-- old one, and finds every row's TID.
CREATE TABLE d1_retype (id int PRIMARY KEY, b int, c int DEFAULT 7);
INSERT INTO d1_retype VALUES (1, 1, NULL), (2, 2, 3), (3, 3, NULL);
ALTER TABLE d1_retype ALTER COLUMN b TYPE bigint;
UPDATE d1_retype SET c = 0 WHERE c IS NULL;
SELECT id, b, c FROM d1_retype ORDER BY id;
 id | b | c 
----+---+---
  1 | 1 | 0
  2 | 2 | 3
  3 | 3 | 0
(3 rows)

DROP TABLE d1_retype;
-- Rows by TID: updates, deletes, index scans, ctid, xmin.
CREATE TABLE d1_rows (id int PRIMARY KEY, v text);
CREATE INDEX d1_rows_v ON d1_rows (v);
INSERT INTO d1_rows SELECT g, 'v' || g FROM generate_series(1, 20) g;
UPDATE d1_rows SET v = v || '!' WHERE id <= 5;
DELETE FROM d1_rows WHERE id > 15;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT id, v FROM d1_rows WHERE id = 3;
 id |  v  
----+-----
  3 | v3!
(1 row)

SELECT id, v FROM d1_rows WHERE v = 'v3!';
 id |  v  
----+-----
  3 | v3!
(1 row)

SELECT count(*) FROM d1_rows WHERE v = 'v3';
 count 
-------
     0
(1 row)

SELECT count(*) FROM d1_rows WHERE id > 15;
 count 
-------
     0
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT ctid AS t7 FROM d1_rows WHERE id = 7 \gset
SELECT xmin AS x7 FROM d1_rows WHERE id = 7 \gset
SELECT xmin AS x8 FROM d1_rows WHERE id = 8 \gset
UPDATE d1_rows SET v = 'seven' WHERE id = 7;
SELECT count(*) AS old_tid_finds FROM d1_rows WHERE ctid = :'t7';
 old_tid_finds 
---------------
             0
(1 row)

SELECT (SELECT xmin::text FROM d1_rows WHERE id = 7) <> :'x7' AS changed_row_new_xmin,
	   (SELECT xmin::text FROM d1_rows WHERE id = 8) = :'x8' AS other_row_same_xmin;
 changed_row_new_xmin | other_row_same_xmin 
----------------------+---------------------
 t                    | t
(1 row)

SELECT currtid2('d1_rows', :'t7') = (SELECT ctid FROM d1_rows WHERE id = 7)
	AS follows_update;
 follows_update 
----------------
 t
(1 row)

-- Identical rows: deleting one by ctid leaves the others' ctids alone.
CREATE TABLE d1_same (a int);
INSERT INTO d1_same VALUES (1), (1), (1);
CREATE TEMP TABLE d1_same_tids USING heap AS SELECT ctid AS tid FROM d1_same;
DELETE FROM d1_same WHERE ctid = (SELECT min(tid) FROM d1_same_tids);
SELECT count(*) AS kept FROM d1_same
	WHERE ctid IN (SELECT tid FROM d1_same_tids WHERE tid > (SELECT min(tid) FROM d1_same_tids));
 kept 
------
    2
(1 row)

SELECT count(*) FROM d1_same;
 count 
-------
     2
(1 row)

-- Foreign keys cascade, and check whether a row is the transaction's own.
CREATE TABLE d1_parent (id int PRIMARY KEY);
CREATE TABLE d1_child (id int PRIMARY KEY,
	parent_id int REFERENCES d1_parent ON UPDATE CASCADE ON DELETE CASCADE);
INSERT INTO d1_parent VALUES (1), (2);
INSERT INTO d1_child VALUES (10, 1), (20, 2);
UPDATE d1_parent SET id = 100 WHERE id = 1;
DELETE FROM d1_parent WHERE id = 2;
SELECT * FROM d1_child ORDER BY id;
 id | parent_id 
----+-----------
 10 |       100
(1 row)

INSERT INTO d1_child VALUES (30, 99);
ERROR:  insert or update on table "d1_child" violates foreign key constraint "d1_child_parent_id_fkey"
-- ON CONFLICT, and a deferrable primary key holding duplicates until commit.
INSERT INTO d1_rows VALUES (1, 'upsert') ON CONFLICT (id) DO UPDATE SET v = excluded.v;
INSERT INTO d1_rows VALUES (1, 'nothing') ON CONFLICT (id) DO NOTHING;
SELECT v FROM d1_rows WHERE id = 1;
   v    
--------
 upsert
(1 row)

CREATE TABLE d1_deferred (id int PRIMARY KEY DEFERRABLE INITIALLY DEFERRED, v text);
BEGIN;
INSERT INTO d1_deferred VALUES (1, 'a'), (1, 'b');
DELETE FROM d1_deferred WHERE v = 'a';
COMMIT;
SELECT * FROM d1_deferred;
 id | v 
----+---
  1 | b
(1 row)

-- Indexes built concurrently.
CREATE INDEX CONCURRENTLY d1_rows_conc ON d1_rows (v, id);
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT id FROM d1_rows WHERE v = 'seven';
 id 
----
  7
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
DROP TABLE d1_rows, d1_same, d1_child, d1_parent, d1_deferred;
-- A duplicate a unique index (not the primary key) finds: the index checks
-- the row it finds with a dirty snapshot, and must be told nobody is
-- inserting it.
CREATE TABLE d1_uq (id int PRIMARY KEY, b int UNIQUE);
INSERT INTO d1_uq VALUES (1, 1);
INSERT INTO d1_uq VALUES (2, 1);
ERROR:  duplicate key value violates unique constraint "d1_uq_b_key"
DO $$
BEGIN
	INSERT INTO d1_uq VALUES (3, 1);
EXCEPTION WHEN unique_violation THEN
	RAISE NOTICE 'caught duplicate';
END $$;
NOTICE:  caught duplicate
SELECT * FROM d1_uq;
 id | b 
----+---
  1 | 1
(1 row)

-- Updates that leave an index's key alone fill its pages with entries for
-- one key, which btree tries to delete bottom-up.
CREATE INDEX d1_uq_id_b ON d1_uq (id, b);
DO $$
BEGIN
	FOR i IN 1..500 LOOP
		UPDATE d1_uq SET b = b + 0 * i, id = id WHERE id = 1;
		UPDATE d1_uq SET b = -b WHERE id = 1;
	END LOOP;
END $$;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT * FROM d1_uq WHERE id = 1;
 id | b 
----+---
  1 | 1
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
DROP TABLE d1_uq;
-- A deferred foreign key on a row the transaction inserted and then
-- updated without changing the key: the update's check runs because the
-- row is the transaction's own.
CREATE TABLE d1_dparent (id int PRIMARY KEY);
CREATE TABLE d1_dchild (id int PRIMARY KEY, x int,
	parent_id int REFERENCES d1_dparent DEFERRABLE INITIALLY DEFERRED);
BEGIN;
INSERT INTO d1_dchild VALUES (1, 0, 99);
UPDATE d1_dchild SET x = 1 WHERE id = 1;
COMMIT;
ERROR:  insert or update on table "d1_dchild" violates foreign key constraint "d1_dchild_parent_id_fkey"
SELECT count(*) FROM d1_dchild;
 count 
-------
     0
(1 row)

DROP TABLE d1_dchild, d1_dparent;
-- A row affected twice by one command, where the first change leaves it
-- as it was, and a row inserted by the command and hit again: both are
-- refused, as on heap.
CREATE TABLE d1_twice (id int PRIMARY KEY, v int);
INSERT INTO d1_twice VALUES (1, 10);
INSERT INTO d1_twice VALUES (1, 10), (1, 20)
	ON CONFLICT (id) DO UPDATE SET v = excluded.v RETURNING *;
ERROR:  ON CONFLICT DO UPDATE command cannot affect row a second time
INSERT INTO d1_twice VALUES (2, 10), (2, 20)
	ON CONFLICT (id) DO UPDATE SET v = excluded.v RETURNING *;
ERROR:  ON CONFLICT DO UPDATE command cannot affect row a second time
MERGE INTO d1_twice t USING (VALUES (1, 10), (1, 20)) s(id, v) ON t.id = s.id
	WHEN MATCHED THEN UPDATE SET v = s.v;
ERROR:  MERGE command cannot affect row a second time
SELECT * FROM d1_twice ORDER BY id;
 id | v  
----+----
  1 | 10
(1 row)

UPDATE d1_twice SET v = v;
SELECT * FROM d1_twice ORDER BY id;
 id | v  
----+----
  1 | 10
(1 row)

DROP TABLE d1_twice;
-- A table created and filled in one transaction.
BEGIN;
CREATE TABLE d1_new (n int);
INSERT INTO d1_new SELECT generate_series(1, 10);
SELECT sum(n) FROM d1_new;
 sum 
-----
  55
(1 row)

COMMIT;
SELECT sum(n) FROM d1_new;
 sum 
-----
  55
(1 row)

-- Indexes are built from a scan of the table.
CREATE INDEX d1_pk_v ON d1_pk (v);
SELECT reltuples >= 0 AS has_stats FROM pg_class WHERE relname = 'd1_pk_v';
 has_stats 
-----------
 t
(1 row)

-- Scans stay in the leader, even when parallel query is forced: workers
-- can't see the leader's private writes.
BEGIN;
INSERT INTO d1_new VALUES (100);
SET LOCAL debug_parallel_query = on;
SET LOCAL parallel_setup_cost = 0;
SET LOCAL parallel_tuple_cost = 0;
SET LOCAL min_parallel_table_scan_size = 0;
EXPLAIN (COSTS OFF) SELECT sum(n) FROM d1_new;
        QUERY PLAN        
--------------------------
 Aggregate
   ->  Seq Scan on d1_new
(2 rows)

SELECT sum(n) FROM d1_new;
 sum 
-----
 155
(1 row)

COMMIT;
-- Committed rows are seen by a new session.
\c
SELECT count(*) FROM d1_pk;
 count 
-------
  5003
(1 row)

SELECT sum(n) FROM d1_new;
 sum 
-----
 155
(1 row)

-- A key or index column updated to an equal value written differently
-- (numeric scale) takes the new bytes in the trees: they equal the trees
-- of a table written with them directly, and index-only scans return them.
CREATE OPERATOR CLASS d1_numeric_ops DEFAULT FOR TYPE numeric USING prolly AS
	OPERATOR 1 <, OPERATOR 2 <=, OPERATOR 3 =, OPERATOR 4 >=, OPERATOR 5 >,
	FUNCTION 1 numeric_cmp(numeric, numeric);
CREATE TABLE d1_respelled (k numeric PRIMARY KEY, n numeric) USING prolly_d1;
CREATE INDEX d1_respelled_n ON d1_respelled USING prolly (n);
INSERT INTO d1_respelled VALUES (1.0, 2.0), (3, 4);
UPDATE d1_respelled SET k = 1.00 WHERE k = 1;
UPDATE d1_respelled SET n = 2.000 WHERE k = 1;
CREATE TABLE d1_spelled (k numeric PRIMARY KEY, n numeric) USING prolly_d1;
CREATE INDEX d1_spelled_n ON d1_spelled USING prolly (n);
INSERT INTO d1_spelled VALUES (1.00, 2.000), (3, 4);
SELECT prolly_tree_digest('d1_respelled') = prolly_tree_digest('d1_spelled') AS same_table,
	   prolly_tree_digest('d1_respelled_n') = prolly_tree_digest('d1_spelled_n') AS same_index;
 same_table | same_index 
------------+------------
 t          | t
(1 row)

-- (This file turns index scans off at its start; they are on here.)
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_indexscan = on;
SET enable_indexonlyscan = on;
EXPLAIN (COSTS OFF) SELECT n FROM d1_respelled WHERE n = 2;
                      QUERY PLAN                      
------------------------------------------------------
 Index Only Scan using d1_respelled_n on d1_respelled
   Index Cond: (n = '2'::numeric)
(2 rows)

SELECT n::text FROM d1_respelled WHERE n = 2;
   n   
-------
 2.000
(1 row)

-- Within a transaction, and back to a savepoint.
BEGIN;
UPDATE d1_respelled SET n = 2.0 WHERE k = 1;
SAVEPOINT s;
UPDATE d1_respelled SET n = 2.00 WHERE k = 1;
ROLLBACK TO s;
SELECT n::text FROM d1_respelled WHERE n = 2;
  n  
-----
 2.0
(1 row)

COMMIT;
RESET enable_seqscan;
RESET enable_bitmapscan;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
UPDATE d1_spelled SET n = 2.0 WHERE k = 1;
SELECT prolly_tree_digest('d1_respelled_n') = prolly_tree_digest('d1_spelled_n') AS same_index;
 same_index 
------------
 t
(1 row)

DROP TABLE d1_keyless, d1_pk, d1_new, d1_rekey, d1_sp, d1_respelled, d1_spelled;
DROP OPERATOR CLASS d1_numeric_ops USING prolly;
