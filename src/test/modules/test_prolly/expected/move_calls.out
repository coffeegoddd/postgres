-- alice's SECURITY DEFINER routine in the superuser's table's check runs
-- as alice, restricted: it can't make a temporary table, which the
-- session would then find first, as the mover
CREATE FUNCTION mc_pub.who_def(v int) RETURNS bool LANGUAGE plpgsql SECURITY DEFINER
SET search_path = mc_pub AS $$
BEGIN
	BEGIN
		CREATE TEMP TABLE mc_def_tmp (x int);
		DROP TABLE mc_def_tmp;
		INSERT INTO log VALUES (current_user, 'definer: not restricted');
	EXCEPTION WHEN insufficient_privilege THEN
		INSERT INTO log VALUES (current_user, 'definer: restricted');
	END;
	RETURN true;
END $$;
ALTER FUNCTION mc_pub.who_def(int) OWNER TO regress_mc_alice;
