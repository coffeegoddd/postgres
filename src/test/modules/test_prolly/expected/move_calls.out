-- (a fresh session, its first plans those the warm-up makes)
-- (the warm-up's own call logs false, as the superuser)
\c regress_move_calls
TRUNCATE mc_pub.log;
SELECT mc_pub.su_simple(0) AS warmed;
 warmed 
--------
