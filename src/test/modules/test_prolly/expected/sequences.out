-- A branch's sequences are its data: commits record their values, moves
-- set them, and a merge gives each the larger of the two.
CREATE SCHEMA app VERSIONED;
CREATE SEQUENCE app.s;
CREATE SEQUENCE app.untouched START 50;
CREATE TABLE app.t (id int PRIMARY KEY DEFAULT nextval('app.s'), v text);
INSERT INTO app.t (v) VALUES ('a'), ('b');
SELECT (dolt_commit('-Am', 'base'))[1] AS base \gset
SELECT nextval('app.s');
 nextval 
---------
       3
(1 row)

SELECT length(dolt_commit('-Am', 'a value taken')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_reset('--hard', :'base');
 dolt_reset 
------------
 {0}
(1 row)

SELECT nextval('app.s');		-- as the base left it
 nextval 
---------
       3
(1 row)

SELECT dolt_reset('--hard', :'base');
 dolt_reset 
------------
 {0}
(1 row)

-- Merges: the larger value of each sequence the other side changed.
SELECT dolt_branch('feature');
 dolt_branch 
-------------
 {0}
(1 row)

INSERT INTO app.t (v) SELECT 'main' FROM generate_series(1, 3);
SELECT length(dolt_commit('-Am', 'main takes 3')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('feature');
           dolt_checkout            
------------------------------------
 {0,"Switched to branch 'feature'"}
(1 row)

SELECT setval('app.s', 40);
 setval 
--------
     40
(1 row)

INSERT INTO app.t (v) VALUES ('feature');
SELECT length(dolt_commit('-Am', 'feature goes to 41')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT (dolt_merge('feature'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT last_value, is_called FROM app.s;
 last_value | is_called 
------------+-----------
         41 | t
(1 row)

SELECT last_value, is_called FROM app.untouched;
 last_value | is_called 
------------+-----------
         50 | f
(1 row)

INSERT INTO app.t (v) VALUES ('after');
SELECT id FROM app.t WHERE v = 'after';
 id 
----
 42
(1 row)

-- and keeps ours when it's larger, or theirs didn't change it
SELECT dolt_checkout('feature');
           dolt_checkout            
------------------------------------
 {0,"Switched to branch 'feature'"}
(1 row)

SELECT nextval('app.untouched');
 nextval 
---------
      50
(1 row)

SELECT length(dolt_commit('-Am', 'feature takes untouched')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT setval('app.s', 1000);
 setval 
--------
   1000
(1 row)

SELECT length(dolt_commit('-Am', 'main jumps')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT (dolt_merge('feature'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT last_value, is_called FROM app.s;
 last_value | is_called 
------------+-----------
       1000 | t
(1 row)

SELECT last_value, is_called FROM app.untouched;
 last_value | is_called 
------------+-----------
         50 | t
(1 row)

-- A sequence's value alone is a change to commit.
SELECT nextval('app.untouched');
 nextval 
---------
      51
(1 row)

SELECT length(dolt_commit('-Am', 'just a value')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_commit('-Am', 'nothing');
ERROR:  nothing to commit
HINT:  Pass --allow-empty to commit anyway.
-- A move's sequence values roll back with its rows.
SELECT (dolt_commit('-Am', 'before the rollback', '--allow-empty'))[1] AS here \gset
SELECT last_value FROM app.s;
 last_value 
------------
       1000
(1 row)

BEGIN;
SELECT dolt_reset('--hard', :'base');
 dolt_reset 
------------
 {0}
(1 row)

SELECT last_value FROM app.s;
 last_value 
------------
          2
(1 row)

ROLLBACK;
SELECT last_value FROM app.s;
 last_value 
------------
       1000
(1 row)

INSERT INTO app.t (v) VALUES ('no clash');
-- Merges compare the value each would give next: one set back and not yet
-- called (next 2000) is ahead of theirs called at 1500 (next 1501).
SELECT dolt_branch('-D', 'feature');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT length(dolt_commit('-Am', 'clash checked')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_branch('feature');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_checkout('feature');
           dolt_checkout            
------------------------------------
 {0,"Switched to branch 'feature'"}
(1 row)

SELECT setval('app.s', 1500);
 setval 
--------
   1500
(1 row)

SELECT length(dolt_commit('-Am', 'feature at 1500')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT setval('app.s', 2000, false);
 setval 
--------
   2000
(1 row)

SELECT length(dolt_commit('-Am', 'main next 2000')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT (dolt_merge('feature'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT last_value, is_called FROM app.s;
 last_value | is_called 
------------+-----------
       2000 | f
(1 row)

-- and a descending sequence's lower value is the further one.
CREATE SEQUENCE app.down INCREMENT -1 START -1 MINVALUE -1000 MAXVALUE -1;
SELECT length(dolt_commit('-Am', 'down')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_branch('-D', 'feature');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_branch('feature');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_checkout('feature');
           dolt_checkout            
------------------------------------
 {0,"Switched to branch 'feature'"}
(1 row)

SELECT setval('app.down', -3);
 setval 
--------
     -3
(1 row)

SELECT length(dolt_commit('-Am', 'feature at -3')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT setval('app.down', -10);
 setval 
--------
    -10
(1 row)

SELECT length(dolt_commit('-Am', 'main at -10')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT (dolt_merge('feature'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT last_value, is_called FROM app.down;
 last_value | is_called 
------------+-----------
        -10 | t
(1 row)

-- An uncommitted value stops a merge, as uncommitted rows do.
SELECT dolt_checkout('feature');
           dolt_checkout            
------------------------------------
 {0,"Switched to branch 'feature'"}
(1 row)

SELECT setval('app.s', 5000);
 setval 
--------
   5000
(1 row)

SELECT length(dolt_commit('-Am', 'feature at 5000')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT nextval('app.s') > 0 AS taken;
 taken 
-------
 t
(1 row)

SELECT dolt_merge('feature');
ERROR:  local changes would be stomped by merge
DETAIL:  Sequence "app.s" has uncommitted changes, and the merge changes it too.
HINT:  Commit the changes, or reset the branch, first.
SELECT dolt_reset('--hard');
 dolt_reset 
------------
 {0}
(1 row)

-- Folding and moving need no privilege on the sequences beyond the
-- branch's: a role that may only use one sees status and resets.
CREATE ROLE seq_user IN ROLE pg_prolly_write;
GRANT USAGE ON SCHEMA app TO seq_user;
GRANT ALL ON app.t TO seq_user;
GRANT USAGE ON SEQUENCE app.s TO seq_user;
SELECT dolt_hashof('HEAD') AS granted \gset
SET ROLE seq_user;
INSERT INTO app.t (v) VALUES ('by seq_user');
SELECT * FROM dolt_status();
 table_name | staged |  status  
------------+--------+----------
 app.s      | t      | modified
 app.t      | t      | modified
(2 rows)

SELECT dolt_reset('--hard', :'granted');
 dolt_reset 
------------
 {0}
(1 row)

SELECT count(*) FROM app.t WHERE v = 'by seq_user';
 count 
-------
     0
(1 row)

RESET ROLE;
REVOKE ALL ON app.t FROM seq_user;
REVOKE ALL ON SEQUENCE app.s FROM seq_user;
REVOKE ALL ON SCHEMA app FROM seq_user;
DROP ROLE seq_user;
SELECT dolt_branch('-D', 'feature');
 dolt_branch 
-------------
 {0}
(1 row)

DROP SCHEMA app CASCADE;
NOTICE:  drop cascades to 4 other objects
DETAIL:  drop cascades to sequence app.s
drop cascades to sequence app.untouched
drop cascades to table app.t
drop cascades to sequence app.down
