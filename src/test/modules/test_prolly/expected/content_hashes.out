-- SHA-256 is still there, and agrees with Postgres's.
SELECT test_content_hash('abc', 'sha256') = encode(sha256('abc'), 'hex') AS sha256_agrees;
 sha256_agrees 
---------------
 t
(1 row)

-- The hash chunks are named by.
SELECT length(test_content_hash('')) / 2 AS digest_bytes;
