CREATE FUNCTION vector_input(n int) RETURNS bytea LANGUAGE sql AS $$
	SELECT coalesce(decode(string_agg(lpad(to_hex(i % 251), 2, '0'), '' ORDER BY i),
						   'hex'), '')
	FROM generate_series(0, n - 1) i
$$;
SELECT len, digest, test_content_hash(vector_input(len), 'blake3') AS got
FROM blake3_vectors
WHERE test_content_hash(vector_input(len), 'blake3') IS DISTINCT FROM digest;
 len | digest | got 
-----+--------+-----
(0 rows)

SELECT len, piece
FROM blake3_vectors, (VALUES (1), (7), (63), (1000), (4097)) p(piece)
WHERE test_content_hash(vector_input(len), 'blake3', piece) IS DISTINCT FROM digest;
 len | piece 
