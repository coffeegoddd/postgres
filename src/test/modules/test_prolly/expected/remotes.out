SELECT name, url = :'url_a' AS url_is_a FROM dolt_remotes;
  name  | url_is_a 
--------+----------
 origin | t
(1 row)

SELECT dolt_remote('add', 'origin', :'url_a');
ERROR:  remote "origin" already exists
SELECT dolt_remote('add', 'a/b', :'url_a');
ERROR:  invalid remote name "a/b"
DETAIL:  A remote's name is not empty and has no "/".
SELECT dolt_remote('add', 'other', 'ftp://example.com/x');
ERROR:  remotes of scheme "ftp" aren't supported
SELECT dolt_remote('add', 'other', 'file://relative/path');
ERROR:  a file remote's path must be absolute: "file://relative/path"
SELECT dolt_remote('add', 'other', 'nothing');
ERROR:  "nothing" isn't a remote's URL
HINT:  A remote's URL begins with its scheme, as file:///path does.
SELECT dolt_fetch('nowhere');
ERROR:  remote "nowhere" not found
