 base_row |   our_row    |    their_row    
----------+--------------+-----------------
 (5,v5)   | (5,"main 5") | (5,"feature 5")
(1 row)

SELECT v FROM app.t WHERE id IN (5, 6) ORDER BY id;	-- ours kept; theirs merged
     v     
-----------
 main 5
 feature 6
(2 rows)

SAVEPOINT s;
SELECT dolt_commit('-Am', 'too soon');
ERROR:  cannot commit with unresolved merge conflicts
DETAIL:  Table "t" has conflicts.
HINT:  Resolve them with dolt_conflicts_resolve(), or abort the merge.
ROLLBACK TO s;
COMMIT;
ERROR:  cannot commit a transaction with unresolved merge conflicts
DETAIL:  Table "t" has conflicts on branch "main".
HINT:  Resolve them with dolt_conflicts_resolve() first, or set dolt.allow_commit_conflicts to keep them.
-- (the transaction's commit was refused, so nothing of it stayed)
SELECT v FROM app.t WHERE id IN (5, 6) ORDER BY id;
   v    
--------
 main 5
 v6
(2 rows)

