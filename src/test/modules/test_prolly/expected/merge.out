 on_main 
---------
 t
(1 row)

UPDATE mgc.t SET v = 3 WHERE k = 'b';
SELECT length(dolt_commit('-am', 'b is 3')::text) AS committed;
 committed 
-----------
        42
(1 row)

UPDATE pg_collation SET collicurules = '&a<b' WHERE collname = 'mgc_c_utf8';
SELECT (dolt_merge('mgc_side'))[2:4];
ERROR:  the rows of table mgc.t in this version can't be read here
DETAIL:  The collation "public.mgc_c_utf8" ordered its keys as provider b, locale 'C.UTF-8', deterministic, version '1'; the database has provider b, locale 'C.UTF-8', rules '&a<b', deterministic, version '1'.
HINT:  A version's rows can only be read where the collations ordering their keys are as it recorded.
UPDATE pg_collation SET collicurules = NULL WHERE collname = 'mgc_c_utf8';
SELECT (dolt_merge('mgc_side'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

