SELECT free('\x7a') AS freed_pinned;
 freed_pinned 
--------------
            0
(1 row)

COMMIT;
SELECT free('\x7a') AS freed;
 freed 
-------
     1
(1 row)

-- freed and put again, it starts afresh: none of its old changes count
SELECT put('\x78') AS x;
 x 
