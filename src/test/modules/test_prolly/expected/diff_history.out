SELECT (row).pk, (row).a, (row).c, c.message
FROM dolt_history_table(NULL::dh.nt) h JOIN dolt_log c ON c.commit_hash = h.commit_hash
ORDER BY c.commit_order DESC, (row).pk;
WARNING:  1 value of column "a" of table "nt" doesn't convert from character varying(20) to character varying(10): shown as null
WARNING:  1 value of column "b" of table "nt" doesn't convert from integer to smallint: shown as null
WARNING:  1 value of column "c" of table "nt" doesn't convert from integer to dh.tinyint: shown as null
WARNING:  1 value of column "d" of table "nt" doesn't convert from numeric(6,2) to numeric(4,1): shown as null
 pk |     a      | c  |   message   
----+------------+----+-------------
