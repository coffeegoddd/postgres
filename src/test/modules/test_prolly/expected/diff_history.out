UPDATE dh.nfk SET v = 'zyxwvutsrqponml';
SELECT length(dolt_commit('-am', 'nf changed')::text) AS committed;
 committed 
-----------
        42
(1 row)

UPDATE dh.nf SET v = 'x', p = 1, d = 1;
UPDATE dh.nfk SET v = 'x';
