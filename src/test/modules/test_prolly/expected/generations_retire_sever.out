(1 row)

SELECT kept >= 0 AS collected FROM test_chunk_gc(false);
 collected 
-----------
 t
(1 row)

SELECT name AS since FROM test_chunk_generations() WHERE epoch_lo > :g4 \gset
SELECT freed > 0 AS freed FROM test_chunk_retire(:g1, :g2);
 freed 
-------
 t
(1 row)

SELECT test_chunk_has(:'d1_root') AS d1_root_kept,
	   test_chunk_has(:'d2_root') AS d2_root_kept;
 d1_root_kept | d2_root_kept 
--------------+--------------
 f            | f
(1 row)

SELECT coalesce(sum(chunks), 0) AS chunks_left_in_retired
	FROM test_chunk_generations() WHERE epoch_hi <= :g2 AND epoch_lo > 0;
 chunks_left_in_retired 
------------------------
                      4
(1 row)

SELECT count(*) AS since_untouched FROM test_chunk_generations()
	WHERE name = :'since';
 since_untouched 
-----------------
               1
(1 row)

SELECT gs_err($$SELECT count(*) FROM dolt_diff('main~4', 'main~3', NULL::gs.t)$$) AS d1_d2;
                   d1_d2                   
-------------------------------------------
 commit <hash> is past the history horizon
(1 row)

