-- As in Dolt: "HEAD" in any case is the head, not a branch; a name may
-- begin with "-", given after "--"; and one differing from a branch's
-- only by case names that branch, made, copied or renamed to.
SELECT dolt_branch('head');
ERROR:  invalid branch name "head"
DETAIL:  A branch's name follows git's rules for one, in ASCII: no spaces, control characters or any of ~ ^ : ? * [ \; no "..", "@{" or "//"; not "HEAD" (in any case), "@" or a commit id; not "-" alone or beginning with "/", nor ending with "/" or "."; and no "/"-separated part beginning with "." or ending with ".lock".
SELECT dolt_hashof('head') = dolt_hashof('HEAD') AS head_any_case,
	dolt_hashof('Head~0') = dolt_hashof('HEAD') AS with_steps;
 head_any_case | with_steps 
---------------+------------
 t             | t
(1 row)

