-- (outside a block a conflict rolls the whole rebase back, as Dolt aborts it)
SELECT dolt_rebase('main');
ERROR:  rebase conflict detected, transaction rolled back
DETAIL:  1 row was changed differently on both sides.
HINT:  Rebase in a transaction block to resolve the conflicts with dolt_conflicts_resolve() before committing, or set dolt.allow_commit_conflicts to keep them.
SELECT active_branch();
 active_branch 
---------------
 b5
(1 row)

BEGIN;
SELECT r[1], r[2] LIKE 'data conflict detected while rebasing commit %' AS conflict
	FROM dolt_rebase('main') r;
 r | conflict 
---+----------
 1 | t
(1 row)

SELECT active_branch();
 active_branch  
----------------
 dolt_rebase_b5
(1 row)

SELECT dolt_rebase('--continue');
ERROR:  conflicts detected in tables rb.t; resolve conflicts before continuing the rebase
ROLLBACK;
-- (stopped: another rebase, or a merge, refused; abort goes back)
BEGIN;
SELECT (dolt_rebase('main'))[1] AS stopped;
 stopped 
---------
 1
(1 row)

SELECT dolt_rebase('main');
ERROR:  unable to start rebase while another rebase is in progress – abort the current rebase before proceeding
ROLLBACK;
BEGIN;
SELECT (dolt_rebase('main'))[1] AS stopped;
 stopped 
---------
 1
(1 row)

SELECT dolt_rebase('--abort');
           dolt_rebase            
----------------------------------
 {0,"Interactive rebase aborted"}
(1 row)

SELECT active_branch(), (SELECT count(*) FROM dolt_branches WHERE name = 'dolt_rebase_b5') AS left;
 active_branch | left 
---------------+------
 b5            |    0
(1 row)

COMMIT;
BEGIN;
SELECT (dolt_rebase('main'))[1] AS stopped;
 stopped 
---------
 1
(1 row)

SELECT dolt_conflicts_resolve('--theirs', 'rb.t');
 dolt_conflicts_resolve 
------------------------
 {0}
(1 row)

SELECT dolt_rebase('--continue');
                     dolt_rebase                      
------------------------------------------------------
 {0,"Successfully rebased and updated refs/heads/b5"}
(1 row)

COMMIT;
SELECT active_branch();
 active_branch 
---------------
 b5
