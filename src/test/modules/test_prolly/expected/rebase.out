SELECT dolt_commit('-am', 'feature row 2') IS NOT NULL AS committed;
 committed 
-----------
 t
(1 row)

SELECT dolt_hashof('HEAD') AS before \gset
SELECT dolt_rebase('main');
                        dolt_rebase                        
-----------------------------------------------------------
