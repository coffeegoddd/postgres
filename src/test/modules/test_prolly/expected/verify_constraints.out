(1 row)

SELECT dolt_verify_constraints('vr.lc', 'vr.lk', 'vr.nk');
 dolt_verify_constraints 
-------------------------
 {1}
(1 row)

SELECT * FROM dolt_constraint_violations() ORDER BY table_name;
 table_name | num_violations 
------------+----------------
 vr.fk      |              2
 vr.lc      |              1
 vr.lk      |              1
 vr.nk      |              1
(4 rows)

