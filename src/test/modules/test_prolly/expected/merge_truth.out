(1 row)

SELECT pg_temp.empty_commit('c2') AS c2 \gset
SELECT test_commit_of(prolly_root_hash('HEAD'), 'd1') AS d1 \gset
SELECT test_commit_chain(:'d1', 1) AS d2 \gset
SELECT dolt_branch('mb_d', :'d2');
 dolt_branch 
