------+-------
 blue |     3
 ok   |     1
(2 rows)

SELECT test_fold_root() AS merged \gset
SELECT * FROM dolt_status;
 table_name | staged | status 
------------+--------+--------
(0 rows)

ROLLBACK;
SELECT dolt_checkout('old_writer');
             dolt_checkout             
---------------------------------------
 {0,"Switched to branch 'old_writer'"}
(1 row)

BEGIN;
SELECT (dolt_merge('main', '-m', 'merged enum reverse'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT test_fold_root() = :'merged' AS same_merge;
 same_merge 
------------
 t
(1 row)

SELECT * FROM eh.t ORDER BY id;
 id |  m   |      a       |    p     |  d   
----+------+--------------+----------+------
  1 | blue | {blue,ok}    | (blue,1) | blue
  2 | ok   | {ok}         | (ok,2)   | ok
  3 | blue | {blue,happy} | (blue,3) | blue
(3 rows)

ROLLBACK;
SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
