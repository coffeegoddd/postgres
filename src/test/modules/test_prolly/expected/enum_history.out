SELECT (dolt_merge('old_writer', '-m', 'merged enum'))[2:4];
        dolt_merge        
--------------------------
 {0,0,"merge successful"}
(1 row)

SELECT * FROM eh.t ORDER BY id;
 id |  m   |      a       |    p     |  d   
----+------+--------------+----------+------
