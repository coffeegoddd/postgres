          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'side'"}
(1 row)

SELECT v.test_prolly_readded() AS on_side;
 on_side 
---------
       3
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

-- a user's ADD of the branch's own function is refused, as before
CREATE FUNCTION v.mine() RETURNS int LANGUAGE sql RETURN 1;
ALTER EXTENSION test_prolly_ext_readd ADD FUNCTION v.mine();
ERROR:  cannot add function mine() to an extension: it is in versioned schema "v"
DETAIL:  An extension's objects are shared by every branch; a versioned schema's other objects are each branch's.
DROP FUNCTION v.mine();
\c contrib_regression
DROP DATABASE regress_versioned_extensions2;
