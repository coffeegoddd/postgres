INSERT INTO dv.pk VALUES (2, 2);
INSERT INTO dv.ex VALUES (2, '[6,8)');
INSERT INTO dv.wo VALUES ('[1,2)', '[6,9)');
SELECT length(dolt_commit('-am', 'ours')::text) AS committed;
