SELECT split_part(t, '.', 2) AS t, violation_type, violating_row::text
FROM unnest(ARRAY['uv.u', 'uv.w', 'uv.r', 'uv.s', 'uv.a', 'uv.b', 'uv.c',
				  'uv.p', 'uv.x']) t,
	LATERAL dolt_constraint_violations(t)
ORDER BY 1, 3;
 t | violation_type |        violating_row         
---+----------------+------------------------------
 a | unique index   | {"b": 99, "c": 200, "pk": 2}
 b | unique index   | {"b": 20, "c": 999, "pk": 2}
 c | unique index   | {"b": 99, "c": 200, "pk": 2}
 p | unique index   | {"b": 4, "c": 2, "pk": 1}
 p | unique index   | {"b": 4, "c": 2, "pk": 2}
 r | unique index   | {"b": 999, "c": 0, "pk": 1}
 s | unique index   | {"b": 999, "c": 0, "pk": 1}
 u | unique index   | {"x": 1, "pk": 2}
 w | unique index   | {"x": 2, "pk": 1}
 w | unique index   | {"x": 5, "pk": 2}
 x | unique index   | {"b": 0, "c": 1, "pk": 3}
 x | unique index   | {"b": 3, "c": 0, "pk": 2}
 x | unique index   | {"b": 3, "c": 2, "pk": 4}
 x | unique index   | {"b": 4, "c": 3, "pk": 1}
(14 rows)

