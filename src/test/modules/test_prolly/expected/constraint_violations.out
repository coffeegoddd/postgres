INSERT INTO dv.now VALUES (3, 5);
INSERT INTO dv.pk VALUES (2, 3);
INSERT INTO dv.ex VALUES (3, '[5,7)');
INSERT INTO dv.wo VALUES ('[1,2)', '[5,8)'), ('[2,3)', '[5,8)');
SELECT length(dolt_commit('-am', 'theirs')::text) AS committed;
 committed 
