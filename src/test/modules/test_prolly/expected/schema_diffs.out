 from_table_name | to_table_name  | diff_type | data_change | schema_change 
-----------------+----------------+-----------+-------------+---------------
 app.f()         | app.f()        | modified  | f           | t
                 | app.fresh      | added     | t           | t
                 | app.g(integer) | added     | f           | t
 app.gone        |                | dropped   | t           | t
 app.keep        | app.keep       | modified  | f           | t
 app.mood        | app.mood       | modified  | f           | t
 app.old_name    | app.new_name   | renamed   | f           | f
 app.seq         | app.seq        | modified  | t           | f
 app.t           | app.t          | modified  | t           | f
 app.vw          | app.vw         | modified  | f           | t
(10 rows)

SELECT from_table_name, to_table_name, diff_type FROM dolt_diff_summary('HEAD', 'HEAD~1');
 from_table_name | to_table_name | diff_type 
-----------------+---------------+-----------
 app.f()         | app.f()       | modified
 app.fresh       |               | dropped
 app.g(integer)  |               | dropped
                 | app.gone      | added
 app.keep        | app.keep      | modified
 app.mood        | app.mood      | modified
 app.new_name    | app.old_name  | renamed
 app.seq         | app.seq       | modified
 app.t           | app.t         | modified
 app.vw          | app.vw        | modified
(10 rows)

-- one object, by its name qualified or on the search path, either version's
SELECT * FROM dolt_diff_summary('HEAD~1', 'HEAD', 'app.t');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.t           | app.t         | modified  | t           | f
(1 row)

SET search_path = app, public;
SELECT * FROM dolt_diff_summary('HEAD~1', 'HEAD', 'f()');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.f()         | app.f()       | modified  | f           | t
(1 row)

