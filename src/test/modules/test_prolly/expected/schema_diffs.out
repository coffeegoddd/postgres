 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.gone        |               | dropped   | t           | t
(1 row)

SELECT * FROM dolt_diff_summary('HEAD~1', 'HEAD', 'old_name');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.old_name    | app.new_name  | renamed   | f           | f
(1 row)

SELECT * FROM dolt_diff_summary('HEAD~1', 'HEAD', 'nothing_by_this_name');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
(0 rows)

RESET search_path;
-- a rename that changed the rows too is a drop and an add
ALTER TABLE app.new_name RENAME TO newer_name;
UPDATE app.newer_name SET v = 'changed';
CREATE TABLE app.twin_a (id int PRIMARY KEY);
CREATE TABLE app.twin_b (id int PRIMARY KEY);
CREATE TABLE app.same_a (v int);
CREATE TABLE app.same_b (v int);
SELECT length(dolt_commit('-Am', 'twins')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT * FROM dolt_diff_summary('HEAD~1', 'HEAD');
 from_table_name | to_table_name  | diff_type | data_change | schema_change 
-----------------+----------------+-----------+-------------+---------------
 app.new_name    |                | dropped   | t           | t
                 | app.newer_name | added     | t           | t
                 | app.same_a     | added     | t           | t
                 | app.same_b     | added     | t           | t
                 | app.twin_a     | added     | t           | t
                 | app.twin_b     | added     | t           | t
(6 rows)

-- two renamed at once, told apart by what else names them (their keys'
-- indexes keep their names); two of one content renamed can't be told
-- apart, so they stay dropped and added
ALTER TABLE app.twin_a RENAME TO twin_c;
ALTER TABLE app.twin_b RENAME TO twin_d;
ALTER TABLE app.same_a RENAME TO same_c;
ALTER TABLE app.same_b RENAME TO same_d;
SELECT * FROM dolt_diff_summary('HEAD', 'WORKING');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.same_a      |               | dropped   | t           | t
 app.same_b      |               | dropped   | t           | t
                 | app.same_c    | added     | t           | t
                 | app.same_d    | added     | t           | t
 app.twin_a      | app.twin_c    | renamed   | f           | f
 app.twin_b      | app.twin_d    | renamed   | f           | f
(6 rows)

-- a view renamed is one too
ALTER VIEW app.vw RENAME TO vw2;
SELECT * FROM dolt_diff_summary('HEAD', 'WORKING', 'app.vw2');
 from_table_name | to_table_name | diff_type | data_change | schema_change 
-----------------+---------------+-----------+-------------+---------------
 app.vw          | app.vw2       | renamed   | f           | f
(1 row)

-- what a commit can't hold, in the working set: not covered, flags unknown
CREATE FOREIGN DATA WRAPPER sdiff_fdw;
CREATE SERVER sdiff_srv FOREIGN DATA WRAPPER sdiff_fdw;
CREATE FOREIGN TABLE app.ft (id int) SERVER sdiff_srv;
SELECT * FROM dolt_diff_summary('HEAD', 'WORKING') WHERE diff_type = 'not covered';
 from_table_name | to_table_name |  diff_type  | data_change | schema_change 
-----------------+---------------+-------------+-------------+---------------
 app.ft          | app.ft        | not covered |             | 
(1 row)

DROP FOREIGN TABLE app.ft;
-- refs that aren't
SELECT * FROM dolt_diff_summary('HEAD', 'no_such_ref');
ERROR:  prolly ref "no_such_ref" does not exist
SELECT * FROM dolt_diff_summary(NULL, 'HEAD');
ERROR:  dolt_diff_summary needs two refs
-- dolt_schema_diff: each object whose statements differ, each side's
-- rendered from that version's description, never the catalogs.
CREATE TABLE app.orders (id int PRIMARY KEY, qty int NOT NULL DEFAULT 1,
	note text COLLATE "C", CONSTRAINT qty_positive CHECK (qty > 0));
CREATE INDEX orders_qty ON app.orders (qty);
CREATE TABLE app.lines (id int PRIMARY KEY, order_id int REFERENCES app.orders);
ALTER TABLE app.orders ENABLE ROW LEVEL SECURITY;
CREATE POLICY own_orders ON app.orders USING (qty < 100);
SELECT length(dolt_commit('-Am', 'orders')::text) AS committed;
 committed 
-----------
        42
(1 row)

SELECT * FROM dolt_schema_diff('HEAD~1', 'HEAD');
 from_table_name | to_table_name |                         from_create_statement                         |                                            to_create_statement                                             
-----------------+---------------+-----------------------------------------------------------------------+------------------------------------------------------------------------------------------------------------
                 | app.lines     |                                                                       | CREATE TABLE app.lines (id integer, order_id integer);                                                    +
                 |               |                                                                       | ALTER TABLE app.lines ADD CONSTRAINT lines_id_not_null NOT NULL id;                                       +
                 |               |                                                                       | ALTER TABLE app.lines ADD CONSTRAINT lines_pkey PRIMARY KEY (id);                                         +
                 |               |                                                                       | ALTER TABLE app.lines ADD CONSTRAINT lines_order_id_fkey FOREIGN KEY (order_id) REFERENCES app.orders(id);
                 | app.orders    |                                                                       | CREATE TABLE app.orders (id integer, qty integer DEFAULT 1, note pg_catalog.text COLLATE "C");            +
                 |               |                                                                       | ALTER TABLE app.orders ADD CONSTRAINT orders_id_not_null NOT NULL id;                                     +
                 |               |                                                                       | ALTER TABLE app.orders ADD CONSTRAINT orders_qty_not_null NOT NULL qty;                                   +
                 |               |                                                                       | ALTER TABLE app.orders ADD CONSTRAINT orders_pkey PRIMARY KEY (id);                                       +
                 |               |                                                                       | ALTER TABLE app.orders ADD CONSTRAINT qty_positive CHECK ((qty > 0));                                     +
                 |               |                                                                       | CREATE INDEX orders_qty ON app.orders USING btree (qty);                                                  +
                 |               |                                                                       | ALTER TABLE app.orders ENABLE ROW LEVEL SECURITY;                                                         +
                 |               |                                                                       | CREATE POLICY own_orders ON app.orders AS PERMISSIVE FOR ALL TO PUBLIC USING ((qty < 100));
 app.same_a      |               | CREATE TABLE app.same_a (v integer);                                  | 
 app.same_b      |               | CREATE TABLE app.same_b (v integer);                                  | 
                 | app.same_c    |                                                                       | CREATE TABLE app.same_c (v integer);
                 | app.same_d    |                                                                       | CREATE TABLE app.same_d (v integer);
 app.twin_a      | app.twin_c    | CREATE TABLE app.twin_a (id integer);                                +| CREATE TABLE app.twin_c (id integer);                                                                     +
                 |               | ALTER TABLE app.twin_a ADD CONSTRAINT twin_a_id_not_null NOT NULL id;+| ALTER TABLE app.twin_c ADD CONSTRAINT twin_a_id_not_null NOT NULL id;                                     +
                 |               | ALTER TABLE app.twin_a ADD CONSTRAINT twin_a_pkey PRIMARY KEY (id);   | ALTER TABLE app.twin_c ADD CONSTRAINT twin_a_pkey PRIMARY KEY (id);
 app.twin_b      | app.twin_d    | CREATE TABLE app.twin_b (id integer);                                +| CREATE TABLE app.twin_d (id integer);                                                                     +
                 |               | ALTER TABLE app.twin_b ADD CONSTRAINT twin_b_id_not_null NOT NULL id;+| ALTER TABLE app.twin_d ADD CONSTRAINT twin_b_id_not_null NOT NULL id;                                     +
                 |               | ALTER TABLE app.twin_b ADD CONSTRAINT twin_b_pkey PRIMARY KEY (id);   | ALTER TABLE app.twin_d ADD CONSTRAINT twin_b_pkey PRIMARY KEY (id);
 app.vw          | app.vw2       | CREATE VIEW app.vw AS  SELECT id,                                    +| CREATE VIEW app.vw2 AS  SELECT id,                                                                        +
                 |               |     v                                                                +|     v                                                                                                     +
                 |               |    FROM app.t;                                                        |    FROM app.t;
(9 rows)

-- changed, renamed, dropped; a change of rows alone gives none
ALTER TABLE app.orders ADD COLUMN placed date;
DROP INDEX app.orders_qty;
INSERT INTO app.orders VALUES (1, 2, 'x', NULL);
ALTER TABLE app.lines RENAME TO order_lines;
CREATE OR REPLACE FUNCTION app.f() RETURNS int LANGUAGE sql AS 'SELECT 3';
DROP TYPE app.mood;
UPDATE app.t SET v = 'only rows' WHERE id = 2;
SELECT * FROM dolt_schema_diff('HEAD', 'WORKING');
 from_table_name |  to_table_name  |                                           from_create_statement                                            |                                                  to_create_statement                                                   
-----------------+-----------------+------------------------------------------------------------------------------------------------------------+------------------------------------------------------------------------------------------------------------------------
 app.f()         | app.f()         | CREATE OR REPLACE FUNCTION app.f()                                                                        +| CREATE OR REPLACE FUNCTION app.f()                                                                                    +
                 |                 |  RETURNS integer                                                                                          +|  RETURNS integer                                                                                                      +
                 |                 |  LANGUAGE sql                                                                                             +|  LANGUAGE sql                                                                                                         +
                 |                 | AS $function$SELECT 2$function$;                                                                           | AS $function$SELECT 3$function$;
 app.lines       | app.order_lines | CREATE TABLE app.lines (id integer, order_id integer);                                                    +| CREATE TABLE app.order_lines (id integer, order_id integer);                                                          +
                 |                 | ALTER TABLE app.lines ADD CONSTRAINT lines_id_not_null NOT NULL id;                                       +| ALTER TABLE app.order_lines ADD CONSTRAINT lines_id_not_null NOT NULL id;                                             +
                 |                 | ALTER TABLE app.lines ADD CONSTRAINT lines_pkey PRIMARY KEY (id);                                         +| ALTER TABLE app.order_lines ADD CONSTRAINT lines_pkey PRIMARY KEY (id);                                               +
                 |                 | ALTER TABLE app.lines ADD CONSTRAINT lines_order_id_fkey FOREIGN KEY (order_id) REFERENCES app.orders(id); | ALTER TABLE app.order_lines ADD CONSTRAINT lines_order_id_fkey FOREIGN KEY (order_id) REFERENCES app.orders(id);
 app.mood        |                 | CREATE TYPE app.mood AS ENUM ('sad', 'ok', 'happy');                                                       | 
 app.orders      | app.orders      | CREATE TABLE app.orders (id integer, qty integer DEFAULT 1, note pg_catalog.text COLLATE "C");            +| CREATE TABLE app.orders (id integer, qty integer DEFAULT 1, note pg_catalog.text COLLATE "C", placed pg_catalog.date);+
                 |                 | ALTER TABLE app.orders ADD CONSTRAINT orders_id_not_null NOT NULL id;                                     +| ALTER TABLE app.orders ADD CONSTRAINT orders_id_not_null NOT NULL id;                                                 +
                 |                 | ALTER TABLE app.orders ADD CONSTRAINT orders_qty_not_null NOT NULL qty;                                   +| ALTER TABLE app.orders ADD CONSTRAINT orders_qty_not_null NOT NULL qty;                                               +
                 |                 | ALTER TABLE app.orders ADD CONSTRAINT orders_pkey PRIMARY KEY (id);                                       +| ALTER TABLE app.orders ADD CONSTRAINT orders_pkey PRIMARY KEY (id);                                                   +
                 |                 | ALTER TABLE app.orders ADD CONSTRAINT qty_positive CHECK ((qty > 0));                                     +| ALTER TABLE app.orders ADD CONSTRAINT qty_positive CHECK ((qty > 0));                                                 +
                 |                 | CREATE INDEX orders_qty ON app.orders USING btree (qty);                                                  +| ALTER TABLE app.orders ENABLE ROW LEVEL SECURITY;                                                                     +
                 |                 | ALTER TABLE app.orders ENABLE ROW LEVEL SECURITY;                                                         +| CREATE POLICY own_orders ON app.orders AS PERMISSIVE FOR ALL TO PUBLIC USING ((qty < 100));
                 |                 | CREATE POLICY own_orders ON app.orders AS PERMISSIVE FOR ALL TO PUBLIC USING ((qty < 100));                | 
