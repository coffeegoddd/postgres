-- A tree node's level comes from its chunk, which another server may have
-- made: a node of level MAX_LEVELS (32) or more, or a child not one level
-- below its parent, is refused (DATA_CORRUPTED) by every reader, which
-- keeps a frame a level and descends by level.  Nodes made by hand: a leaf
-- of one item, and chains of one-child internal nodes above it.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS test_prolly;
RESET client_min_messages;
CREATE FUNCTION pg_temp.chain(top int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE h text := test_chunk_put_leaf(ARRAY['\x6e'::bytea]);
BEGIN
	FOR lv IN 1..top LOOP
		h := test_chunk_put_node(lv, ARRAY[h]);
	END LOOP;
	RETURN h;
END $$;
-- each reader's count, or its error's code and message
CREATE FUNCTION pg_temp.reads(root text) RETURNS TABLE (how text, result text)
LANGUAGE plpgsql AS $$
DECLARE r text;
BEGIN
	FOREACH how IN ARRAY ARRAY['scan', 'walk', 'diff', 'diff_nodes', 'diff_unordered',
							   'diff_estimate', 'rank', 'apply'] LOOP
		BEGIN
			result := test_tree_read(root, how)::text;
		EXCEPTION WHEN OTHERS THEN
			result := SQLSTATE || ': ' || SQLERRM;
		END;
		RETURN NEXT;
	END LOOP;
END $$;
-- 31 levels above the leaf: a tree as tall as one may be
SELECT * FROM pg_temp.reads(pg_temp.chain(31));
      how       |                     result                     
----------------+------------------------------------------------
 scan           | 1
 walk           | 32
 diff           | 1
 diff_nodes     | 32
 diff_unordered | 1
 diff_estimate  | 1
 rank           | 0
 apply          | XX000: prolly tree is more than 32 levels high
(8 rows)

-- 32: too tall
SELECT * FROM pg_temp.reads(pg_temp.chain(32));
      how       |                              result                               
----------------+-------------------------------------------------------------------
 scan           | XX001: prolly tree node of level 32: a tree has at most 32 levels
 walk           | XX001: prolly tree node of level 32: a tree has at most 32 levels
 diff           | XX001: prolly tree node of level 32: a tree has at most 32 levels
 diff_nodes     | XX001: prolly tree node of level 32: a tree has at most 32 levels
 diff_unordered | XX001: prolly tree node of level 32: a tree has at most 32 levels
 diff_estimate  | XX001: prolly tree node of level 32: a tree has at most 32 levels
 rank           | XX001: prolly tree node of level 32: a tree has at most 32 levels
 apply          | XX001: prolly tree node of level 32: a tree has at most 32 levels
(8 rows)

-- a node of level 2 naming a leaf
SELECT * FROM pg_temp.reads(test_chunk_put_node(2, ARRAY[test_chunk_put_leaf(ARRAY['\x6e'::bytea])]));
      how       |                           result                           
----------------+------------------------------------------------------------
 scan           | XX001: prolly tree node of level 0 below a node of level 2
 walk           | XX001: prolly tree node of level 0 below a node of level 2
 diff           | XX001: prolly tree node of level 0 below a node of level 2
 diff_nodes     | XX001: prolly tree node of level 0 below a node of level 2
 diff_unordered | XX001: prolly tree node of level 0 below a node of level 2
 diff_estimate  | XX001: prolly tree node of level 0 below a node of level 2
 rank           | XX001: prolly tree node of level 0 below a node of level 2
 apply          | XX001: prolly tree node of level 0 below a node of level 2
(8 rows)

-- a node of level 1 naming one of level 1
SELECT * FROM pg_temp.reads(test_chunk_put_node(1, ARRAY[pg_temp.chain(1)]));
      how       |                           result                           
----------------+------------------------------------------------------------
 scan           | XX001: prolly tree node of level 1 below a node of level 1
 walk           | XX001: prolly tree node of level 1 below a node of level 1
 diff           | XX001: prolly tree node of level 1 below a node of level 1
 diff_nodes     | XX001: prolly tree node of level 1 below a node of level 1
 diff_unordered | XX001: prolly tree node of level 1 below a node of level 1
 diff_estimate  | XX001: prolly tree node of level 1 below a node of level 1
 rank           | XX001: prolly tree node of level 1 below a node of level 1
 apply          | XX001: prolly tree node of level 1 below a node of level 1
(8 rows)

-- a root of level 65535 naming a leaf
SELECT * FROM pg_temp.reads(test_chunk_put_node(65535, ARRAY[test_chunk_put_leaf(ARRAY['\x6e'::bytea])]));
      how       |                                result                                
----------------+----------------------------------------------------------------------
 scan           | XX001: prolly tree node of level 65535: a tree has at most 32 levels
