-- A generated column added on one side: the other side's rows get it,
-- computed (stored) or not stored at all (virtual).
CREATE SCHEMA sgc VERSIONED;
CREATE TABLE sgc.t (pk int PRIMARY KEY);
INSERT INTO sgc.t VALUES (1);
