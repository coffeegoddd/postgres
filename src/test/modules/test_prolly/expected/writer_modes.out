 name | owner 
------+-------
 main | 
(1 row)

INSERT INTO wm.t VALUES (31, 'bob');
COMMIT;
SELECT name, dirty, owner FROM dolt_branches() WHERE name = 'main';
 name | dirty | owner 
------+-------+-------
 main | t     | bob
(1 row)

SELECT dolt_reset('--hard');
 dolt_reset 
------------
 {0}
(1 row)

