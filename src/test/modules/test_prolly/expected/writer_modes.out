SELECT nextval('wm.s2');
ERROR:  branch "main" is protected
DETAIL:  A write moves the session to its writer branch only at the start of a statement that writes, and this one doesn't (it is a query, or inside a function or procedure).
HINT:  Write with INSERT, UPDATE, DELETE, MERGE, COPY or DDL first, or check out a branch of your own with dolt_checkout('-b', ...).
-- writer branches' names are the database's; hank's, clean again, went
-- when the session left it
SELECT dolt_branch('writer/hank/other');
ERROR:  branch names beginning "writer/" are reserved
SELECT dolt_branch('-D', 'writer/hank/main');
ERROR:  branch "writer/hank/main" does not exist
SELECT count(*) AS writer_branches FROM dolt_branches() WHERE kind = 'writer';
 writer_branches 
-----------------
               0
(1 row)

-- Renamed, a protected branch stays protected, by its new name; only the
-- database's owner renames it, replaces it or moves it; a writer's branch
-- keeps its name.
SELECT dolt_branch('wm_pr');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_branch('wm_pq');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_branch('--protect', 'wm_pr');
 dolt_branch 
-------------
 {0}
(1 row)

SET ROLE wm_other;
SELECT dolt_branch('-m', 'wm_pr', 'wm_pr2');
ERROR:  branch "wm_pr" is protected
HINT:  Only the database's owner renames or replaces a protected branch.
SELECT dolt_branch('-m', '-f', 'wm_pq', 'wm_pr');
ERROR:  branch "wm_pr" is protected
HINT:  Only the database's owner renames or replaces a protected branch.
SELECT dolt_branch('-f', 'wm_pr', 'wm_pq');
ERROR:  branch "wm_pr" is protected
HINT:  Only the database's owner moves a protected branch.
RESET ROLE;
SELECT dolt_branch('-m', 'wm_pr', 'wm_pr2');
 dolt_branch 
-------------
