-- Another role can't write as a writer that is a role's, nor take a
-- branch over without owning the database or being the role.
SET ROLE wm_carol;
SET dolt.writer = 'carol';
INSERT INTO wm.t VALUES (7, 'carol');
SET ROLE wm_other;
INSERT INTO wm.t VALUES (8, 'carol, spoofed');
ERROR:  writer "carol" of branch "main" is role "wm_carol"'s
SELECT dolt_branch('--take', 'main');
ERROR:  must be the database's owner or role "wm_carol" to take branch "main" over
SET dolt.writer = 'dave';
INSERT INTO wm.t VALUES (8, 'dave');
ERROR:  branch "main" has uncommitted changes by writer "carol"
HINT:  Write on a new branch with dolt_checkout('-b', ...), ask writer "carol" to commit, or take the changes over with dolt_branch('--take', 'main').
RESET ROLE;
-- The database's owner takes it over: carol's changes become dave's.
SET dolt.writer = 'dave';
SELECT dolt_branch('--take', 'main');
