FROM dolt_diff('HEAD~1', 'HEAD', NULL::fc.t);
 diff_type | id |   v   
-----------+----+-------
 modified  | 50 | after
(1 row)

SELECT test_fold_root(true) = prolly_root_hash('main') AS committed_rows;
