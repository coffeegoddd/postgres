 other | f
(2 rows)

SELECT name, dirty FROM dolt_branches ORDER BY name;
 name  | dirty 
-------+-------
 main  | t
 other | f
(2 rows)

:flush
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT pg_temp.since('folds_reused') AS dirty_taken;
 dirty_taken 
-------------
           2
(1 row)

