          dolt_checkout           
----------------------------------
 {0,"Switched to branch 'other'"}
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT name, dirty FROM dolt_branches ORDER BY name;
