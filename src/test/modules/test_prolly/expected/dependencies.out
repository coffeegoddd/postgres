CREATE TYPE dep_util.mood AS ENUM ('ok', 'meh');
CREATE FUNCTION dep_util.U&"tab\0009in"() RETURNS int LANGUAGE sql AS 'SELECT 7';
CREATE FUNCTION dep_util.twice(int) RETURNS int LANGUAGE sql AS 'SELECT $1 * 2';
