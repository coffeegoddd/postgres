NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to type dep_util.mood
drop cascades to function dep_util."tab	in"()
drop cascades to function dep_util.twice(integer)
DROP EXTENSION citext;
DROP EXTENSION hstore;
DROP EXTENSION ltree;
DROP ROLE regress_dep_reader;
