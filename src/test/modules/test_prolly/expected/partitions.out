-- refused: a partition with its columns in another order than its
-- table's, and one whose table is outside versioned schemas (a partition
-- outside of a versioned table is refused where it is made)
CREATE TABLE pt.ord (k text, id int);
ALTER TABLE pt.new ATTACH PARTITION pt.ord FOR VALUES IN ('o');
SELECT dolt_commit('-Am', 'refused');
ERROR:  prolly commits don't cover partitions with their columns in another order than their partitioned table's yet: pt.ord
DETAIL:  A commit's root hash must depend only on what it holds, and the canonical form doesn't describe this object.
DROP TABLE pt.ord;
CREATE TABLE public.pt_out PARTITION OF pt.new FOR VALUES IN ('x');
ERROR:  table pt_out can't depend on table pt.new, which is versioned
DETAIL:  Objects outside a versioned schema are shared by every branch, and can't depend on an object that exists per branch.
CREATE TABLE public.pt_parent (id int, k text) PARTITION BY LIST (k);
CREATE TABLE pt.pin PARTITION OF public.pt_parent FOR VALUES IN ('i');
SELECT dolt_commit('-Am', 'refused');
ERROR:  prolly commits don't cover partitions of tables outside versioned schemas yet: pt.pin
DETAIL:  A commit's root hash must depend only on what it holds, and the canonical form doesn't describe this object.
DROP TABLE public.pt_parent;
