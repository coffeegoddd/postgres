 index p_v on p
 index p_west_hi_pkey on p_west_hi
 index p_west_hi_v_idx on p_west_hi
 index p_west_lo_pkey on p_west_lo
 index p_west_lo_v_idx on p_west_lo
 index p_west_pkey on p_west
 index p_west_v_idx on p_west
