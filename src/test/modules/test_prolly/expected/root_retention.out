-- a commit made on the same parent as another branch's head leaves that
-- head's root: it is in that branch's window
SELECT dolt_hashof('HEAD') AS c13 \gset
SELECT dolt_branch('b13');
 dolt_branch 
-------------
 {0}
(1 row)

SELECT dolt_reset('--hard', 'HEAD~1');
