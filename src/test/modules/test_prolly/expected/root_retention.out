-- roots captured among writers (each transaction a commit) count what
-- their freezing copies, so a cap thins them too
ALTER DATABASE root_retention RESET prolly.history_min_commits;
ALTER DATABASE root_retention SET prolly.history_window = '1000 years';
SELECT held() AS h0 \gset
SET dolt.transaction_commit = on;
SET prolly.root_interval = 0;
UPDATE rr.t SET v = 21 WHERE id % 10 = 1;
UPDATE rr.t SET v = 22 WHERE id % 10 = 2;
UPDATE rr.t SET v = 23 WHERE id % 10 = 3;
RESET prolly.root_interval;
RESET dolt.transaction_commit;
SELECT test_freeze_kept() AS frozen;
 frozen 
--------
      3
(1 row)

SELECT held() > :h0 AS frozen_roots_counted;
 frozen_roots_counted 
----------------------
 t
(1 row)

ALTER DATABASE root_retention SET prolly.history_root_max_size = '1';
SELECT test_retain_roots('main');
 test_retain_roots 
-------------------
 
(1 row)

-- (the head's, c10's, the tag's, and one holding no pages the next doesn't)
SELECT count(*) AS kept_under_cap FROM test_kept_commits('main');
 kept_under_cap 
----------------
              3
(1 row)

ALTER DATABASE root_retention RESET prolly.history_root_max_size;
-- a reset to any commit in the window, however few rows it differs by,
-- gives each table its root and writes no row
CREATE TABLE rr.z (id int PRIMARY KEY, v int NOT NULL);
INSERT INTO rr.z SELECT g, 0 FROM generate_series(1, 1000) g;
SELECT dolt_commit('-Am', 'z0') IS NOT NULL AS committed;
 committed 
-----------
 t
(1 row)

UPDATE rr.z SET v = 1 WHERE id = 1;
SELECT (dolt_commit('-am', 'z1'))[1] AS z1 \gset
UPDATE rr.z SET v = 2 WHERE id = 2;
SELECT (dolt_commit('-am', 'z2'))[1] AS z2 \gset
UPDATE rr.z SET v = 3 WHERE id = 3;
SELECT dolt_commit('-am', 'z3') IS NOT NULL AS committed;
 committed 
