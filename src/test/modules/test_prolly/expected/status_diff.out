        42
(1 row)

SELECT dolt_checkout('main');
          dolt_checkout          
---------------------------------
 {0,"Switched to branch 'main'"}
(1 row)

SELECT diff_type, from_row, to_row FROM dolt_diff('main', 'f', NULL::app.t);
