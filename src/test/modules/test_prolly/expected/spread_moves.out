(1 row)

COMMIT;
:flush
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT counter, grew > 0 AS grew FROM pg_temp.work()
WHERE counter IN ('apply_loads', 'move_tables_written');
       counter       | grew 
---------------------+------
 apply_loads         | t
 move_tables_written | t
(2 rows)

SELECT test_fold_root() = prolly_root_hash('HEAD') AS at_head;
