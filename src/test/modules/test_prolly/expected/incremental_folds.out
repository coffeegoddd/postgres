UPDATE inc.big SET n = -n WHERE id = 15000;
DELETE FROM inc.big WHERE id = 7;
INSERT INTO inc.big VALUES (20001, 'new', 1);
SELECT * FROM pg_temp.fold();
 pages | candidates | full_tables | same_as_full 
-------+------------+-------------+--------------
     6 |        391 |           0 | t
(1 row)

