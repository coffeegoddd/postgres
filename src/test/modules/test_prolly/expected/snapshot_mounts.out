-- Refused: the working set, a versioned target, a mount there already, a
-- table the commit hasn't, a foreign table of the server without a mount.
SELECT * FROM prolly_mount('WORKING', 'ci', 'w');
ERROR:  a snapshot mount reads a commit, not the working set
HINT:  Commit the working set, then mount the commit.
SELECT * FROM prolly_mount(:'c1', 'ci', 'ci');
ERROR:  a snapshot mount can't be in versioned schema "ci"
DETAIL:  A commit would hold its tables' definitions.
SELECT * FROM prolly_mount(:'c1', 'ci', 'old');
ERROR:  schema "old" is a snapshot mount already
HINT:  Refresh it with prolly_refresh_mount(), or unmount it first.
SELECT * FROM prolly_mount('main', 'ci', 'none', ARRAY['missing']);
ERROR:  main has no table "ci.missing"
SELECT count(*) FROM pg_namespace WHERE nspname = 'none';
 count 
-------
     0
(1 row)

SELECT * FROM prolly_mount('nosuchref', 'ci', 'none');
ERROR:  prolly ref "nosuchref" does not exist
CREATE SCHEMA rogue;
CREATE FOREIGN TABLE rogue.t (tenant_id int, id int, email text, payload text)
	SERVER prolly_local OPTIONS (mount 'nosuch', commit :'c1', source 'ci.users');
SELECT * FROM rogue.t;
ERROR:  snapshot mount "rogue" doesn't pin the commit of table "t"
HINT:  Mount the commit with prolly_mount(), or refresh the mount.
CREATE FOREIGN TABLE rogue.u (a int) SERVER prolly_local;
SELECT * FROM rogue.u;
ERROR:  foreign table "u" isn't a snapshot mount's table
HINT:  Make snapshot tables with prolly_mount().
-- a mount's table whose columns were changed: refused, not misread
ALTER FOREIGN TABLE old.bag ADD COLUMN more int;
SELECT * FROM old.bag;
ERROR:  foreign table "bag" no longer has the columns of "ci.bag" as its commit has them
HINT:  Refresh its mount with prolly_refresh_mount().
ALTER FOREIGN TABLE old.bag DROP COLUMN more;
SELECT * FROM old.bag;
ERROR:  foreign table "bag" no longer has the columns of "ci.bag" as its commit has them
HINT:  Refresh its mount with prolly_refresh_mount().
-- an extension's type keying a table: refused at mount
CREATE EXTENSION test_prolly_ordering VERSION '1.0';
CREATE TABLE ci.extkey (k test_ordering PRIMARY KEY);
SELECT length(dolt_commit('-Am', 'extkey')::text) > 0 AS committed;
 committed 
-----------
 t
(1 row)

SELECT * FROM prolly_mount('HEAD', 'ci', 'ext', ARRAY['extkey']);
ERROR:  prolly_mount can't mount "ci.extkey": its primary key is ordered by a type, operator class or collation that isn't built in
DROP TABLE ci.extkey;
SELECT length(dolt_commit('-Am', 'no extkey')::text) > 0 AS committed;
 committed 
-----------
 t
(1 row)

-- Who may read: SELECT on the table of that name here, row security not
-- applying, both at mount and at each scan.
CREATE ROLE regress_mount_reader;
GRANT USAGE ON SCHEMA ci, old TO regress_mount_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA old TO regress_mount_reader;
SET ROLE regress_mount_reader;
SELECT count(*) FROM old.users;
ERROR:  permission denied for table users
SELECT * FROM prolly_mount(:'c1', 'ci', 'mine', ARRAY['bag']);
ERROR:  permission denied for database regress_snapshot_mounts
RESET ROLE;
GRANT SELECT ON ci.users TO regress_mount_reader;
SET ROLE regress_mount_reader;
SELECT count(*) FROM old.users;
 count 
-------
 10000
(1 row)

SELECT prolly_unmount('old');
ERROR:  must be the owner of snapshot mount "old"
RESET ROLE;
ALTER TABLE ci.users ENABLE ROW LEVEL SECURITY;
SET ROLE regress_mount_reader;
SELECT count(*) FROM old.users;
ERROR:  a snapshot mount can't read "users": row security applies to you
DETAIL:  Other commits' rows aren't filtered by its policies.
HINT:  The table's owner, or a role that bypasses row security, can read them.
RESET ROLE;
ALTER TABLE ci.users DISABLE ROW LEVEL SECURITY;
-- the lineage is the head's: moved back to before the table was made,
-- this backend refuses it too
CREATE TABLE ci.later (id int PRIMARY KEY);
INSERT INTO ci.later VALUES (1);
SELECT dolt_hashof('HEAD') AS before_later \gset
SELECT length(dolt_commit('-Am', 'later')::text) > 0 AS committed;
 committed 
-----------
 t
(1 row)

SELECT mount FROM prolly_mount('HEAD', 'ci', 'lat', ARRAY['later']);
 mount 
-------
