-- equality on the leading column and a range after it; the key's order
-- serves ORDER BY, and LIMIT stops the scan
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT * FROM old.users WHERE tenant_id = 4 AND id >= 40 AND id < 50
ORDER BY id LIMIT 5;
                           QUERY PLAN                           
----------------------------------------------------------------
 Limit (actual rows=5.00 loops=1)
   ->  Foreign Scan on users (actual rows=5.00 loops=1)
         Filter: ((id >= 40) AND (id < 50) AND (tenant_id = 4))
         Snapshot Access: primary key, 1 equal, range
         Rows Read: 5
(5 rows)

