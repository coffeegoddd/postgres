-- many, across pages, asked backwards: each as get has it (leaves: 'L'
-- first, no 'R')
SELECT count(*) FILTER (WHERE pg_temp.put('L'::bytea || decode(repeat(md5('cs-many-' || i), 64), 'hex')))
	AS put FROM generate_series(1, 300) i;
