test_prolly_sources = files(
  'applier_checks.c',
  'bmap_checks.c',
  'branch_checks.c',
  'chunkstore_checks.c',
  'catalog_checks.c',
  'foundation_checks.c',
  'keying_checks.c',
  'tree_checks.c',
  'test_prolly.c',
)

if host_system == 'windows'
  test_prolly_sources += rc_lib_gen.process(win32ver_rc, extra_args: [
    '--NAME', 'test_prolly',
    '--FILEDESC', 'test_prolly - conformance suites for prolly interfaces',])
endif

test_prolly = shared_module('test_prolly',
  test_prolly_sources,
  kwargs: pg_test_mod_args,
)
test_install_libs += test_prolly

test_install_data += files(
  'test_prolly_ordering.control',
  'test_prolly_ordering--1.0.sql',
  'test_prolly_ordering--1.0--1.1.sql',
  'test_prolly.control',
  'test_prolly_normalizing.control',
  'test_prolly_normalizing--1.0.sql',
  'test_prolly--1.0.sql',
  'test_prolly_a.control',
  'test_prolly_a--1.0.sql',
  'test_prolly_b.control',
  'test_prolly_b--1.0.sql',
  'test_prolly_b--1.0--1.1.sql',
  'test_prolly_b--1.1.sql',
  'test_prolly_ext_table.control',
  'test_prolly_ext_table--1.0.sql',
  'test_prolly_ext_detach.control',
  'test_prolly_ext_detach--1.0.sql',
  'test_prolly_ext_readd.control',
  'test_prolly_ext_readd--1.0.sql',
)

