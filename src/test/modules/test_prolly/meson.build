test_prolly_sources = files(
  'bmap_checks.c',
  'bmap_primitive_checks.c',
  'branch_conformance.c',
  'chunk_index_checks.c',
  'chunk_log_checks.c',
  'chunk_store_conformance.c',
  'test_checksum.c',
  'test_prolly.c',
  'unit_branch_filter.c',
  'unit_bufmgr.c',
  'unit_harness.c',
  'unit_registry.c',
  'unit_smgr.c',
)

if host_system == 'windows'
  test_prolly_sources += rc_lib_gen.process(win32ver_rc, extra_args: [
    '--NAME', 'test_prolly',
    '--FILEDESC', 'test_prolly - unit tests and interface conformance suites for the version-control engine',])
endif

test_prolly = shared_module('test_prolly',
  test_prolly_sources,
  kwargs: pg_test_mod_args,
)
test_install_libs += test_prolly

test_install_data += files(
  'test_prolly.control',
  'test_prolly--1.0.sql',
)

test_prolly_isolation = [
  'bmap_shared_writers',
  'chunk_index_put_wait',
  'chunk_roots_wait',
  'chunk_free_wait',
  'chunk_pack_put_wait',
  'chunk_vacuum_cancel',
  'chunk_pack_pins',
  'chunk_take_back',
  'chunk_hold',
  'chunk_run_seal',
  'chunk_free_order',
]
# (these need injection points)
if get_option('injection_points')
  test_prolly_isolation += ['chunk_pack_order', 'chunk_pack_error', 'chunk_pack_found']
endif

tests += {
  'name': 'test_prolly',
  'sd': meson.current_source_dir(),
  'bd': meson.current_build_dir(),
  'regress': {
    'regress_args': ['--temp-config', files('chunk_store.conf')],
    'sql': [
      'unit',
      'conformance',
      'bmap_storage',
      'bmap_copy_on_write',
      'bmap_sharing',
      'bmap_tree_share',
      'bmap_captured_roots',
      'vacuum_shared',
      'bmap_primitives',
      'bmap_settle_roots',
      'bmap_diff',
      'bmap_first_write',
      'bmap_block_map_stats',
      'branch_map_cost',
      'chunk_log',
      'chunk_index',
      'chunk_refs',
      'chunk_free',
      'chunk_holds',
      'chunk_reclaim',
      'chunk_abandoned',
      'history_pointers',
      'chunk_store_pages',
      'chunk_store_memory',
      'chunk_pack_reclaim',
    ],
  },
  'isolation': {
    'regress_args': ['--temp-config', files('chunk_store_isolation.conf')],
    'specs': test_prolly_isolation,
  },
  'tap': {
    'tests': [
      't/001_preloaded.pl',
      't/002_bmap_storage.pl',
      't/003_bmap_incremental_backup.pl',
      't/004_bmap_share.pl',
