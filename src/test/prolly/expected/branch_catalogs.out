 pg_constraint                | 2
 pg_attribute                 | 1
 pg_attrdef                   | 1
 pg_index                     | 2
 pg_enum                      | 1
 pg_rewrite                   | 1
 pg_sequence                  | 1
 pg_statistic                 | true
 pg_trigger on a shared table | 2
 pg_depend                    | true
 pg_description               | branch one
 pg_class, TOAST              | 1
(15 rows)

