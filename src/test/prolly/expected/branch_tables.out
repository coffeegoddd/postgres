-- made any way at all: added, retyped, from a query, or on a partitioned table and so its partitions
-- (moving a table into a versioned schema is refused already)
CREATE TABLE t (id int PRIMARY KEY, v text);
ALTER TABLE t ADD COLUMN r regclass;
ERROR:  column "r" of versioned table "app.t" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
ALTER TABLE t ALTER COLUMN v TYPE regrole USING NULL;
ERROR:  column "v" of versioned table "app.t" cannot be of type regrole, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TABLE t2 AS SELECT 'pg_class'::regclass AS r;
ERROR:  column "r" of versioned table "app.t2" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TABLE pub.moved (id int PRIMARY KEY, r regclass);
ALTER TABLE pub.moved SET SCHEMA app;
ERROR:  cannot move objects between a versioned schema and another kind or branch of schema
CREATE TABLE parts (id int PRIMARY KEY, r text) PARTITION BY RANGE (id);
CREATE TABLE parts1 PARTITION OF parts FOR VALUES FROM (0) TO (10);
ALTER TABLE parts ADD COLUMN extra regtype;
ERROR:  column "extra" of versioned table "app.parts" cannot be of type regtype, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
BEGIN;
CREATE TABLE in_a_transaction (r regclass);
SAVEPOINT s;
CREATE TABLE fine (v text);
COMMIT;
ERROR:  column "r" of versioned table "app.in_a_transaction" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
SELECT to_regclass('app.fine') IS NULL AS not_made_either;
