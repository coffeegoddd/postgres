-- made any way at all: added, retyped, from a query, or on a partitioned table and so its partitions
-- (moving a table into a versioned schema is refused already)
CREATE TABLE t (id int PRIMARY KEY, v text);
ALTER TABLE t ADD COLUMN r regclass;
ERROR:  column "r" of versioned table "app.t" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
ALTER TABLE t ALTER COLUMN v TYPE regrole USING NULL;
ERROR:  column "v" of versioned table "app.t" cannot be of type regrole, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TABLE t2 AS SELECT 'pg_class'::regclass AS r;
ERROR:  column "r" of versioned table "app.t2" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TABLE pub.moved (id int PRIMARY KEY, r regclass);
ALTER TABLE pub.moved SET SCHEMA app;
ERROR:  cannot move objects between a versioned schema and another kind or branch of schema
CREATE TABLE parts (id int PRIMARY KEY, r text) PARTITION BY RANGE (id);
CREATE TABLE parts1 PARTITION OF parts FOR VALUES FROM (0) TO (10);
ALTER TABLE parts ADD COLUMN extra regtype;
ERROR:  column "extra" of versioned table "app.parts" cannot be of type regtype, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
BEGIN;
CREATE TABLE in_a_transaction (r regclass);
SAVEPOINT s;
CREATE TABLE fine (v text);
COMMIT;
ERROR:  column "r" of versioned table "app.in_a_transaction" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
SELECT to_regclass('app.fine') IS NULL AS not_made_either;
 not_made_either 
-----------------
 t
(1 row)

-- in a savepoint released, and in one rolled back
BEGIN;
SAVEPOINT s;
CREATE TABLE in_savepoint (r regclass);
RELEASE s;
COMMIT;
ERROR:  column "r" of versioned table "app.in_savepoint" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
BEGIN;
SAVEPOINT s;
CREATE TABLE rolled_back (r regclass);
ROLLBACK TO s;
COMMIT;
-- one made and gone in the transaction is nothing to refuse
BEGIN;
CREATE TABLE gone (r regclass);
DROP TABLE gone;
COMMIT;
-- a type changed under a versioned table's column: a composite, its own or a shared one, through a
-- domain, a shared table's row type, and a view's
CREATE TYPE app.later AS (n int);
CREATE TABLE uses_later (id int PRIMARY KEY, c app.later);
ALTER TYPE app.later ADD ATTRIBUTE r regclass;
ERROR:  column "c" of versioned table "app.uses_later" cannot be of type later, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TYPE pub.shared_later AS (n int);
CREATE TABLE uses_shared (id int PRIMARY KEY, c pub.shared_later[]);
ALTER TYPE pub.shared_later ADD ATTRIBUTE r regclass CASCADE;
ERROR:  column "c" of versioned table "app.uses_shared" cannot be of type shared_later[], which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TYPE pub.under_domain AS (n int);
CREATE DOMAIN pub.over_it AS pub.under_domain;
CREATE TABLE uses_domain (id int PRIMARY KEY, c pub.over_it);
ALTER TYPE pub.under_domain ADD ATTRIBUTE r regrole;
ERROR:  column "c" of versioned table "app.uses_domain" cannot be of type over_it, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE TYPE app.outer_one AS (inner_one pub.under_domain);
CREATE TABLE pub.its_row (n int);
CREATE TABLE uses_row (id int PRIMARY KEY, c pub.its_row);
ALTER TABLE pub.its_row ADD COLUMN r regclass;
ERROR:  column "c" of versioned table "app.uses_row" cannot be of type its_row, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
CREATE VIEW pub.its_view AS SELECT 1 AS n;
CREATE TABLE uses_view (id int PRIMARY KEY, c pub.its_view);
CREATE OR REPLACE VIEW pub.its_view AS SELECT 1 AS n, 'pg_class'::regclass AS r;
ERROR:  column "c" of versioned table "app.uses_view" cannot be of type its_view, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
SELECT string_agg(relname, ',' ORDER BY relname) AS still_fine FROM pg_class
WHERE relnamespace = 'app'::regnamespace AND relname LIKE 'uses_%';
                                                              still_fine                                                              
--------------------------------------------------------------------------------------------------------------------------------------
 uses_domain,uses_domain_pkey,uses_later,uses_later_pkey,uses_row,uses_row_pkey,uses_shared,uses_shared_pkey,uses_view,uses_view_pkey
(1 row)

-- a typed table
CREATE TYPE app.row_type AS (id int, v text);
CREATE TABLE typed OF app.row_type;
ERROR:  versioned table "app.typed" cannot be a typed table
-- on another branch than the session's, too
SELECT pg_branch_id_allocate() AS b2 \gset
SET catalog_branch = :b2;
CREATE SCHEMA app VERSIONED;
SET catalog_branch = :b1;
BEGIN;
SET LOCAL catalog_branch = :b2;
CREATE TABLE app.on_b2 (r regclass);
SET LOCAL catalog_branch = :b1;
COMMIT;
ERROR:  column "r" of versioned table "app.on_b2" cannot be of type regclass, which names an object
DETAIL:  A rename changes such a value with no change of the row, and names differ between branches.
-- what is fine: a shared schema's, other columns, and what's only like these
CREATE TABLE pub.anything (id int PRIMARY KEY, r regclass, a aclitem[]);
CREATE TABLE ok (id int PRIMARY KEY, o oid, n name, t text, j jsonb);
SELECT count(*) AS tables FROM pg_class WHERE relnamespace = 'app'::regnamespace AND relkind IN ('r', 'p');
 tables 
--------
      9
(1 row)

DROP TABLE pub.anything;
DROP SCHEMA pub CASCADE;
NOTICE:  drop cascades to 11 other objects
DETAIL:  drop cascades to table moved
drop cascades to type shared_later
drop cascades to column c of table uses_shared
drop cascades to type under_domain
drop cascades to column inner_one of composite type outer_one
drop cascades to type over_it
drop cascades to column c of table uses_domain
drop cascades to table its_row
drop cascades to column c of table uses_row
drop cascades to view its_view
drop cascades to column c of table uses_view
DROP SCHEMA app CASCADE;
NOTICE:  drop cascades to 16 other objects
DETAIL:  drop cascades to type names_a_class
drop cascades to type holds_a_role
drop cascades to type holds_holder
drop cascades to type many_names
drop cascades to type class_range
drop cascades to table t
drop cascades to table parts
drop cascades to type later
drop cascades to table uses_later
drop cascades to table uses_shared
drop cascades to table uses_domain
drop cascades to type outer_one
drop cascades to table uses_row
drop cascades to table uses_view
drop cascades to type row_type
drop cascades to table ok
SET catalog_branch = :b2;
DROP SCHEMA app CASCADE;
