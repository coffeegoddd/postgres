--
-- Version control: diff reports each changed row once, by kind, and a
-- merge without conflicts combines both branches' changes.
--
\set ECHO none
branch|t
checkout feature|t
commit feature|t
diff base..feature|added,modified,removed
diff feature..base|added,modified,removed
diff base..base|0
checkout main|t
commit main|t
merge|{0,0,"merge successful"}
merge commit|t
merged rows|1:ONE,2:two,4:four,5:FIVE
diff main..feature|modified,removed
