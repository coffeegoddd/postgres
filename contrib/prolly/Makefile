# contrib/prolly/Makefile
#
# The fork's extensions, each in a subdirectory of this one and listed in
# SUBDIRS here and in meson.build.  Keeping them under one directory means
# adding an extension touches only the fork's own files, never the
# upstream contrib/Makefile.

subdir = contrib/prolly
top_builddir = ../..
include $(top_builddir)/src/Makefile.global

SUBDIRS =

$(recurse)
