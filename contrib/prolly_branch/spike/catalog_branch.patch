+
+/*
+ * Other branches' objects: the namespaces of other branches, and every
+ * relation, type, function and constraint in them, by object id (one
+ * counter assigns them all).  Their catalog rows, and the rows of other
+ * catalogs that describe them, are hidden from this session's queries.
+ * Built when a scan of such a catalog begins (never mid-scan, while a
+ * buffer is locked), and built again after any of them changes or the
+ * session changes branch.
+ */
+static Oid *hidden_nsp = NULL;
+static int	nhidden = 0;
+static bool hidden_stale = true;
+static bool hidden_building = false;
+static bool hidden_callback = false;
+
+static void
+hidden_invalidate(Datum arg, SysCacheIdentifier cacheid, uint32 hashvalue)
+{
+	hidden_stale = true;
+}
+
+static int
+oid_cmp_hidden(const void *a, const void *b)
+{
+	Oid			x = *(const Oid *) a,
+				y = *(const Oid *) b;
+
+	return (x > y) - (x < y);
+}
+
+/* Whether relid is a catalog whose rows can belong to a branch. */
+bool
+catalog_branch_filters(Oid relid)
+{
+	switch (relid)
+	{
+		case NamespaceRelationId:
+		case RelationRelationId:
+		case TypeRelationId:
+		case ProcedureRelationId:
+		case ConstraintRelationId:
+		case OperatorRelationId:
+		case OperatorClassRelationId:
+		case OperatorFamilyRelationId:
+		case CollationRelationId:
+		case ConversionRelationId:
+		case StatisticExtRelationId:
+		case TSConfigRelationId:
+		case TSDictionaryRelationId:
+		case TSParserRelationId:
+		case TSTemplateRelationId:
+		case ExtensionRelationId:
+		case AttributeRelationId:
+		case IndexRelationId:
+		case AttrDefaultRelationId:
+		case TriggerRelationId:
+		case RewriteRelationId:
+		case PolicyRelationId:
+		case InheritsRelationId:
+		case SequenceRelationId:
+		case StatisticRelationId:
+		case PartitionedRelationId:
+		case EnumRelationId:
+		case RangeRelationId:
+		case AggregateRelationId:
+		case DependRelationId:
+		case DescriptionRelationId:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static Oid *hidden_set;
+static int	hidden_n,
+			hidden_cap;
+
+static void
+hidden_add(Oid oid)
+{
+	if (hidden_n == hidden_cap)
+	{
+		hidden_cap = hidden_cap ? hidden_cap * 2 : 64;
+		hidden_set = hidden_set ? repalloc(hidden_set, hidden_cap * sizeof(Oid))
+			: MemoryContextAlloc(TopMemoryContext, hidden_cap * sizeof(Oid));
+	}
+	hidden_set[hidden_n++] = oid;
+}
+
+static bool
+hidden_has(const Oid *set, int n, Oid oid)
+{
+	return n > 0 && bsearch(&oid, set, n, sizeof(Oid), oid_cmp_hidden) != NULL;
+}
+
+/* Adds every row of catalog relid whose namespace (column nspatt) is hidden. */
+static void
+hidden_members(Oid relid, AttrNumber oidatt, AttrNumber nspatt, const Oid *nsps, int nnsp)
+{
+	Relation	rel = table_open(relid, AccessShareLock);
+	SysScanDesc scan = systable_beginscan(rel, InvalidOid, false, NULL, 0, NULL);
+	HeapTuple	tup;
+	bool		isnull;
+
+	while (HeapTupleIsValid(tup = systable_getnext(scan)))
+	{
+		Oid			nsp = DatumGetObjectId(heap_getattr(tup, nspatt, RelationGetDescr(rel), &isnull));
+
+		if (!isnull && hidden_has(nsps, nnsp, nsp))
+			hidden_add(DatumGetObjectId(heap_getattr(tup, oidatt, RelationGetDescr(rel), &isnull)));
+	}
+	systable_endscan(scan);
+	table_close(rel, AccessShareLock);
+}
+
+/* Before a scan of rel begins: the hidden namespaces, up to date. */
+void
+catalog_branch_prepare(Relation rel)
+{
+	Relation	nsp;
+	SysScanDesc scan;
+	HeapTuple	tup;
+	int			cap = 16,
+				n = 0;
+	Oid		   *set;
+
+	if (!catalog_branch_filter || !hidden_stale || hidden_building ||
+		!IsNormalProcessingMode() || !catalog_branch_filters(RelationGetRelid(rel)) ||
+		!IsTransactionState())
+		return;
+	if (!hidden_callback)
+	{
+		CacheRegisterSyscacheCallback(NAMESPACEOID, hidden_invalidate, (Datum) 0);
+		CacheRegisterSyscacheCallback(RELOID, hidden_invalidate, (Datum) 0);
+		CacheRegisterSyscacheCallback(TYPEOID, hidden_invalidate, (Datum) 0);
+		CacheRegisterSyscacheCallback(PROCOID, hidden_invalidate, (Datum) 0);
+		CacheRegisterSyscacheCallback(CONSTROID, hidden_invalidate, (Datum) 0);
+		hidden_callback = true;
+	}
+	set = MemoryContextAlloc(TopMemoryContext, cap * sizeof(Oid));
+	hidden_building = true;
+	PG_TRY();
+	{
+		nsp = table_open(NamespaceRelationId, AccessShareLock);
+		scan = systable_beginscan(nsp, InvalidOid, false, NULL, 0, NULL);
+		while (HeapTupleIsValid(tup = systable_getnext(scan)))
+		{
+			Form_pg_namespace f = (Form_pg_namespace) GETSTRUCT(tup);
+
+			if (f->nspbranch == 0 || f->nspbranch == catalog_branch)
+				continue;
+			if (n == cap)
+			{
+				cap *= 2;
+				set = repalloc(set, cap * sizeof(Oid));
+			}
+			set[n++] = f->oid;
+		}
+		systable_endscan(scan);
+		table_close(nsp, AccessShareLock);
+		qsort(set, n, sizeof(Oid), oid_cmp_hidden);
+		hidden_n = 0;
+		for (int i = 0; i < n; i++)
+			hidden_add(set[i]);
+		if (n > 0)
+		{
+			hidden_members(RelationRelationId, Anum_pg_class_oid, Anum_pg_class_relnamespace, set, n);
+			hidden_members(TypeRelationId, Anum_pg_type_oid, Anum_pg_type_typnamespace, set, n);
+			hidden_members(ProcedureRelationId, Anum_pg_proc_oid, Anum_pg_proc_pronamespace, set, n);
+			hidden_members(ConstraintRelationId, Anum_pg_constraint_oid, Anum_pg_constraint_connamespace, set, n);
+			hidden_members(ExtensionRelationId, Anum_pg_extension_oid, Anum_pg_extension_extnamespace, set, n);
+		}
+		if (hidden_n > 0)
+			qsort(hidden_set, hidden_n, sizeof(Oid), oid_cmp_hidden);
+	}
+	PG_FINALLY();
+	{
+		hidden_building = false;
+	}
+	PG_END_TRY();
+	qsort(set, n, sizeof(Oid), oid_cmp_hidden);
+	if (hidden_nsp)
+		pfree(hidden_nsp);
+	hidden_nsp = set;
+	nhidden = n;
+	hidden_stale = false;
+}
+
+/* The branch a namespace belongs to (0: shared), by object id. */
+int32
+namespace_branch(Oid nspid)
+{
+	HeapTuple	tup = SearchSysCache1(NAMESPACEOID, ObjectIdGetDatum(nspid));
+	int32		branch = 0;
+
+	if (HeapTupleIsValid(tup))
+	{
+		branch = ((Form_pg_namespace) GETSTRUCT(tup))->nspbranch;
+		ReleaseSysCache(tup);
+	}
+	return branch;
+}
+
+/*
+ * Whether rel is in another branch's namespace: logical decoding on a
+ * branch (catalog_branch set) carries the shared schemas' changes and that
+ * branch's, not the other branches'.  On no branch it carries them all.
+ */
+bool
+catalog_branch_skips(Relation rel)
+{
+	HeapTuple	tup;
+	int32		branch;
+
+	if (catalog_branch == 0)
+		return false;
+	tup = SearchSysCache1(NAMESPACEOID, ObjectIdGetDatum(rel->rd_rel->relnamespace));
+	if (!HeapTupleIsValid(tup))
+		return false;
+	branch = ((Form_pg_namespace) GETSTRUCT(tup))->nspbranch;
+	ReleaseSysCache(tup);
+	return branch != 0 && branch != catalog_branch;
+}
+
+/* Whether a catalog row is another branch's, hidden from this query. */
+bool
+catalog_branch_hides(HeapTuple htup, Snapshot snapshot)
+{
+	Oid			nspid;
+
+	if (!catalog_branch_filter || snapshot->for_catalog ||
+		snapshot->snapshot_type != SNAPSHOT_MVCC || !IsNormalProcessingMode())
+		return false;
+	switch (htup->t_tableOid)
+	{
+		case NamespaceRelationId:
+			{
+				int32		branch = ((Form_pg_namespace) GETSTRUCT(htup))->nspbranch;
+
+				return branch != 0 && branch != catalog_branch;
+			}
+		case RelationRelationId:
+			nspid = ((Form_pg_class) GETSTRUCT(htup))->relnamespace;
+			break;
+		case TypeRelationId:
+			nspid = ((Form_pg_type) GETSTRUCT(htup))->typnamespace;
+			break;
+		case ProcedureRelationId:
+			nspid = ((Form_pg_proc) GETSTRUCT(htup))->pronamespace;
+			break;
+		case ConstraintRelationId:
+			nspid = ((Form_pg_constraint) GETSTRUCT(htup))->connamespace;
+			break;
+		case OperatorRelationId:
+			nspid = ((Form_pg_operator) GETSTRUCT(htup))->oprnamespace;
+			break;
+		case OperatorClassRelationId:
+			nspid = ((Form_pg_opclass) GETSTRUCT(htup))->opcnamespace;
+			break;
+		case OperatorFamilyRelationId:
+			nspid = ((Form_pg_opfamily) GETSTRUCT(htup))->opfnamespace;
+			break;
+		case CollationRelationId:
+			nspid = ((Form_pg_collation) GETSTRUCT(htup))->collnamespace;
+			break;
+		case ConversionRelationId:
+			nspid = ((Form_pg_conversion) GETSTRUCT(htup))->connamespace;
+			break;
+		case StatisticExtRelationId:
+			nspid = ((Form_pg_statistic_ext) GETSTRUCT(htup))->stxnamespace;
+			break;
+		case TSConfigRelationId:
+			nspid = ((Form_pg_ts_config) GETSTRUCT(htup))->cfgnamespace;
+			break;
+		case TSDictionaryRelationId:
+			nspid = ((Form_pg_ts_dict) GETSTRUCT(htup))->dictnamespace;
+			break;
+		case TSParserRelationId:
+			nspid = ((Form_pg_ts_parser) GETSTRUCT(htup))->prsnamespace;
+			break;
+		case TSTemplateRelationId:
+			nspid = ((Form_pg_ts_template) GETSTRUCT(htup))->tmplnamespace;
+			break;
+		case ExtensionRelationId:
+			nspid = ((Form_pg_extension) GETSTRUCT(htup))->extnamespace;
+			break;
+		default:
+			{
+				/* a row describing an object: hidden with the object */
+				Oid			obj,
+							obj2 = InvalidOid;
+
+				switch (htup->t_tableOid)
+				{
+					case AttributeRelationId:
+						obj = ((Form_pg_attribute) GETSTRUCT(htup))->attrelid;
+						break;
+					case IndexRelationId:
+						obj = ((Form_pg_index) GETSTRUCT(htup))->indexrelid;
+						break;
+					case AttrDefaultRelationId:
+						obj = ((Form_pg_attrdef) GETSTRUCT(htup))->adrelid;
+						break;
+					case TriggerRelationId:
+						obj = ((Form_pg_trigger) GETSTRUCT(htup))->tgrelid;
+						break;
+					case RewriteRelationId:
+						obj = ((Form_pg_rewrite) GETSTRUCT(htup))->ev_class;
+						break;
+					case PolicyRelationId:
+						obj = ((Form_pg_policy) GETSTRUCT(htup))->polrelid;
+						break;
+					case InheritsRelationId:
+						obj = ((Form_pg_inherits) GETSTRUCT(htup))->inhrelid;
+						break;
+					case SequenceRelationId:
+						obj = ((Form_pg_sequence) GETSTRUCT(htup))->seqrelid;
+						break;
+					case StatisticRelationId:
+						obj = ((Form_pg_statistic) GETSTRUCT(htup))->starelid;
+						break;
+					case PartitionedRelationId:
+						obj = ((Form_pg_partitioned_table) GETSTRUCT(htup))->partrelid;
+						break;
+					case EnumRelationId:
+						obj = ((Form_pg_enum) GETSTRUCT(htup))->enumtypid;
+						break;
+					case RangeRelationId:
+						obj = ((Form_pg_range) GETSTRUCT(htup))->rngtypid;
+						break;
+					case AggregateRelationId:
+						obj = ((Form_pg_aggregate) GETSTRUCT(htup))->aggfnoid;
+						break;
+					case DependRelationId:
+						obj = ((Form_pg_depend) GETSTRUCT(htup))->objid;
+						obj2 = ((Form_pg_depend) GETSTRUCT(htup))->refobjid;
+						break;
+					case DescriptionRelationId:
+						obj = ((Form_pg_description) GETSTRUCT(htup))->objoid;
+						break;
+					default:
+						return false;
+				}
+				return hidden_has(hidden_set, hidden_n, obj) ||
+					(OidIsValid(obj2) && hidden_has(hidden_set, hidden_n, obj2));
+			}
+	}
+	return hidden_has(hidden_set, hidden_n, nspid);
+}
