  * If missing_ok is false, throw an error if namespace name not found.  If
  * true, just return InvalidOid.
  */
+int			catalog_branch = 0;
+bool		catalog_branch_filter = true;
+
+/* The namespace named nspname for this session: its branch's, else shared. */
+HeapTuple
+SearchNamespaceByName(const char *nspname)
+{
+	HeapTuple	tup;
+
+	if (catalog_branch != 0)
+	{
+		tup = SearchSysCache2(NAMESPACENAME, CStringGetDatum(nspname),
+							  Int32GetDatum(catalog_branch));
+		if (HeapTupleIsValid(tup))
+			return tup;
+	}
+	return SearchSysCache2(NAMESPACENAME, CStringGetDatum(nspname), Int32GetDatum(0));
+}
+
+/* Whether a tuple is another branch's row, hidden from this session's scans. */
+bool
+catalog_branch_hides(HeapTuple htup)
+{
+	int32		branch;
+
+	if (htup->t_tableOid != NamespaceRelationId || !catalog_branch_filter)
+		return false;
+	branch = ((Form_pg_namespace) GETSTRUCT(htup))->nspbranch;
+	return branch != 0 && branch != catalog_branch;
+}
