+
+		oid = InvalidOid;
+		if (HeapTupleIsValid(tup))
+		{
+			oid = ((Form_pg_namespace) GETSTRUCT(tup))->oid;
+			ReleaseSysCache(tup);
+		}
+	}
 	if (!OidIsValid(oid) && !missing_ok)
 		ereport(ERROR,
 				(errcode(ERRCODE_UNDEFINED_SCHEMA),
@@ -4789,6 +4829,38 @@ check_search_path(char **newval, void **extra, GucSource source)
 }
 
 /* assign_hook: do extra actions as needed */
+/*
+ * A session that changes branch sees other catalog rows: every cached
+ * catalog entry, and the search path's namespaces, are looked up again.
+ */
+static void
+catalog_branch_changed(void)
+{
+	baseSearchPathValid = false;
+	if (criticalRelcachesBuilt && IsTransactionState())
+		InvalidateSystemCaches();
+}
+
+void
+assign_catalog_branch(int newval, void *extra)
+{
+	if (newval != catalog_branch)
+	{
+		catalog_branch = newval;
+		catalog_branch_changed();
+	}
+}
+
+void
+assign_catalog_branch_filter(bool newval, void *extra)
+{
+	if (newval != catalog_branch_filter)
+	{
+		catalog_branch_filter = newval;
+		catalog_branch_changed();
+	}
+}
